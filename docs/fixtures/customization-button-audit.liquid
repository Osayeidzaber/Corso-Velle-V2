{% comment %}Temporary native rendering fixture; remove after acceptance checks.{% endcomment %}
<div class="full-width section-spacing color-scheme-1" style="padding-inline:var(--nk-gutter)">
  <h1>Button presentation acceptance</h1>
  {% assign sizes = 'compact,regular,large' | split: ',' %}
  {% assign corners_list = 'inherit,square,soft,pill' | split: ',' %}
  {% assign schemes = 'scheme-1,scheme-2' | split: ',' %}
  {% for scheme in schemes %}
    {% for size in sizes %}
      {% for corners in corners_list %}
        <div class="button-audit-case color-{{ scheme }}" data-size="{{ size }}" data-corners="{{ corners }}" style="{% render 'button-tokens', size: size, corners: corners, fallback_radius: 0 %};padding:16px;display:flex;gap:12px;flex-wrap:wrap">
          <button class="button" type="button">{{ size }} {{ corners }}</button>
          <button class="button button--secondary" type="button">Outline</button>
          <button class="button" type="button" disabled>Unavailable</button>
          <button class="button" type="button" aria-busy="true">Adding</button>
        </div>
      {% endfor %}
    {% endfor %}
  {% endfor %}
  {% assign modes = 'expressive,subtle,none' | split: ',' %}
  {% for mode in modes %}
    <div class="button-audit-motion hero color-scheme-1" data-button-motion="{{ mode }}" style="min-height:0;display:flex;gap:16px;padding:24px;flex-wrap:wrap">
      {% render 'hero-button', label: mode, link: routes.root_url, style: 'solid', size: 'medium', corners: 'pill', arrow: true %}
      {% render 'hero-button', label: 'Outline', link: routes.root_url, style: 'outline', size: 'small', corners: 'square' %}
      {% render 'hero-button', label: 'Glass', link: routes.root_url, style: 'glass', size: 'large', corners: 'soft' %}
      {% render 'hero-button', label: 'Text link', link: routes.root_url, style: 'link', arrow: true %}
    </div>
  {% endfor %}
  <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px">
    {% assign sample = collections['shackets'].products.first %}
    {% for surface in (0..2) %}
      <div data-surface="{{ surface }}" style="--nk-card-surface-padding:{% if surface == 0 %}0{% elsif surface == 1 %}12{% else %}16{% endif %}px;--nk-card-surface-border:{% if surface == 0 %}0{% else %}1{% endif %}px;--nk-card-surface-shadow:{% if surface == 2 %}0 8px 24px rgb(0 0 0 / .08){% else %}none{% endif %}">
        {% render 'product-card', product: sample, actions: false %}
      </div>
    {% endfor %}
  </div>
</div>
{% schema %}
{ "name": "Temporary button audit", "settings": [] }
{% endschema %}
