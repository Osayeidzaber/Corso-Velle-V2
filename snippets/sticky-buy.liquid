{%- doc -%}
  Opt-in sticky purchase bar for the product section (src/components/product/sticky-buy.ts). It
  appears once the main Add to cart button has scrolled above the viewport and mirrors its size,
  price and state; it never adds before a size is chosen.

  @param {object} product - The product
  @param {object} variant - The initially selected variant
  @param {boolean} needs_choice - A size must still be chosen
  @param {string} scope - Section setting: 'off', 'mobile' (phones and tablets) or 'always'
  @param {object} [buy_block] - The section's Buy buttons block; nothing renders without one

  @example
  {% render 'sticky-buy', product: product, variant: variant, needs_choice: needs_choice, scope: 'mobile', buy_block: buy_block %}
{%- enddoc -%}
{%- if buy_block and scope == 'mobile' or buy_block and scope == 'always' -%}
<nk-sticky-buy class="sticky-buy" data-scope="{{ scope }}" hidden>
  <div class="sticky-buy__inner">
    <div class="sticky-buy__product">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 120 | image_tag: class: 'sticky-buy__thumb', loading: 'lazy', sizes: '40px', alt: '' }}
      {%- endif -%}
      <div class="sticky-buy__info">
        <p class="sticky-buy__title">{{ product.title | escape }}</p>
        <p class="sticky-buy__meta spec">
          {%- unless product.has_only_default_variant -%}
            <span data-sticky-variant>{% unless needs_choice %}{{ variant.title | escape }}{% endunless %}</span>
            <span aria-hidden="true">·</span>
          {%- endunless -%}
          <span class="price" data-sticky-price>{{ variant.price | money }}</span>
        </p>
      </div>
    </div>
    <button type="button" class="button sticky-buy__cta" data-sticky-cta>
      <span data-sticky-label>{{ 'product.add_to_cart' | t }}</span>
    </button>
  </div>
</nk-sticky-buy>
{%- endif -%}
