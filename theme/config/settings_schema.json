  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "Page width",
        "options": [
          {
            "value": "1200px",
            "label": "Narrow"
          },
          {
            "value": "1440px",
            "label": "Wide"
          },
          {
            "value": "100vw",
            "label": "Full"
          }
        ],
        "default": "1440px"
      },
      {
        "type": "select",
        "id": "section_spacing",
        "label": "Space between sections",
        "options": [
          {
            "value": "48",
            "label": "Compact"
          },
          {
            "value": "72",
            "label": "Regular"
          },
          {
            "value": "112",
            "label": "Airy"
          }
        ],
        "default": "72"
      },
      {
        "type": "select",
        "id": "corner_radius",
        "label": "Button and field corners",
        "options": [
          {
            "value": "0",
            "label": "Square"
          },
          {
            "value": "2",
            "label": "Soft"
          },
          {
            "value": "999",
            "label": "Pill"
          }
        ],
        "default": "2"
      },
      {
        "type": "header",
        "content": "Responsive spacing"
      },
      {
        "type": "paragraph",
        "content": "Page gutters set the side space used by shared content containers. Full-width media and sections with their own spacing keep their layout."
      },
      {
        "type": "range",
        "id": "gutter_mobile",
        "label": "Page gutter on phones",
        "min": 12,
        "max": 32,
        "step": 2,
        "unit": "px",
        "default": 16,
        "info": "Screens below 750px."
      },
      {
        "type": "range",
        "id": "gutter_tablet",
        "label": "Page gutter on tablets",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "default": 24,
        "info": "Screens from 750px to 1199px."
      },
      {
        "type": "range",
        "id": "gutter_desktop",
        "label": "Page gutter on large screens",
        "min": 24,
        "max": 80,
        "step": 4,
        "unit": "px",
        "default": 48,
        "info": "Screens from 1200px."
      },
      {
        "type": "select",
        "id": "section_spacing_mobile",
        "label": "Section spacing on smaller screens",
        "options": [
          {
            "value": "50",
            "label": "Compact"
          },
          {
            "value": "66",
            "label": "Regular"
          },
          {
            "value": "85",
            "label": "Airy"
          },
          {
            "value": "100",
            "label": "Same as desktop"
          }
        ],
        "default": "66",
        "info": "Below 990px, sections using shared spacing use 50%, 66%, 85% or 100% of Space between sections."
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "select",
        "id": "button_size",
        "label": "Default button size",
        "options": [
          {
            "value": "compact",
            "label": "Compact"
          },
          {
            "value": "regular",
            "label": "Regular"
          },
          {
            "value": "large",
            "label": "Large"
          }
        ],
        "default": "regular",
        "info": "Applies to shared boxed buttons. Product purchase buttons retain a 56px minimum; hero Small/Large choices override this size."
      },
      {
        "type": "select",
        "id": "button_corners",
        "label": "Default button corners",
        "options": [
          {
            "value": "inherit",
            "label": "Use Layout corner setting"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "soft",
            "label": "Rounded"
          },
          {
            "value": "pill",
            "label": "Pill"
          }
        ],
        "default": "inherit"
      },
      {
        "type": "select",
        "id": "button_motion",
        "label": "Button hover effects",
        "options": [
          {
            "value": "expressive",
            "label": "Sliding fill and hero label roll"
          },
          {
            "value": "subtle",
            "label": "Subtle fade"
          },
          {
            "value": "none",
            "label": "Instant states (no animation)"
          }
        ],
        "default": "expressive",
        "info": "Keyboard focus keeps its visible outline in all modes. Reduced motion and global Motion off always suppress travel."
      }
    ]
  },
