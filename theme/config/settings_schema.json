  {
    "name": "Size charts",
    "settings": [
      {
        "type": "text",
        "id": "size_chart_default_handle",
        "label": "Default reusable chart handle",
        "info": "Handle of a size_chart metaobject from Content > Metaobjects, e.g. classic-shirt. Used only when no product or collection assignment applies. Leave blank to preserve template fallbacks."
      },
      {
        "type": "paragraph",
        "content": "Assign verified measurements to collections or specific products. Product metafields override these rules. Product assignments override collection assignments; the first matching chart wins. Purchasable sizes and stock still come from Shopify product variants."
      },
      {
        "type": "header",
        "content": "Chart 1"
      },
      {
        "type": "collection_list",
        "id": "size_chart_1_collections",
        "label": "Apply to collections",
        "limit": 50
      },
      {
        "type": "product_list",
        "id": "size_chart_1_products",
        "label": "Apply to specific products",
        "limit": 50,
        "info": "Use a separate chart for products with different measurements."
      },
      {
        "type": "textarea",
        "id": "size_chart_1_table",
        "label": "Measurements",
        "info": "First line: Size,Chest,Length (or your headings). Then one comma-separated row per size. Enter only verified values, using the same size labels as product variants. Leave blank until verified."
      },
      {
        "type": "select",
        "id": "size_chart_1_unit",
        "label": "Unit",
        "options": [
          {
            "value": "cm",
            "label": "Centimetres"
          },
          {
            "value": "in",
            "label": "Inches"
          }
        ],
        "default": "cm"
      },
      {
        "type": "text",
        "id": "size_chart_1_basis",
        "label": "Measurement basis",
        "info": "For example: garment measured flat, or body measurements. State the actual method."
      },
      {
        "type": "text",
        "id": "size_chart_1_note",
        "label": "Size guide note"
      },
