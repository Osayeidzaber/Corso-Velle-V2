            "type": "color",
            "id": "text_muted",
            "label": "Secondary text",
            "default": "#55534E"
          },
          {
            "type": "color",
            "id": "line",
            "label": "Lines and borders",
            "default": "#D9D6CF"
          },
          {
            "type": "color",
            "id": "accent",
            "label": "Accent (buttons, links, focus, selected states)",
            "default": "#432D23",
            "info": "Defaults to the footer brown. Hover, active, selected, border and focus shades are derived from it automatically."
          },
          {
            "type": "color",
            "id": "accent_text",
            "label": "Text on accent",
            "default": "#F5ECDF"
          }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "text",
          "on_primary_button": "background",
          "primary_button_border": "text",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "icons": "text",
          "links": "accent"
        }
      },
      {
        "type": "header",
        "content": "Status colors"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Errors",
        "default": "#B42318"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Success",
        "default": "#146C43"
      }
