{%- comment -%}
  Main product (master-plan/08). Info column is merchant-ordered local blocks (S8 fallback model;
  theme-block nesting is validated on a dev store before switching).

  Re-render contract: the variant picker requests this section with ?option_values= and swaps
  only [data-region] price / picker / inventory / buy. Everything else — including app blocks —
  is left untouched.

  Explicit size choice is required on each enhanced page visit, including variant links.
  The hidden variant ID stays disabled until selection; no-JavaScript option links remain available.
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign required = settings.product_required_options | downcase | split: ','
  assign needs_choice = false
  unless product.has_only_default_variant or product.selected_variant
    for option in product.options_with_values
      assign option_name = option.name | downcase | strip
      for required_name in required
        assign required_clean = required_name | strip
        if option_name == required_clean
          assign needs_choice = true
        elsif required_clean == 'size' and option_name contains 'size'
          assign needs_choice = true
        endif
      endfor
    endfor
  endunless

  if variant == blank
    assign availability = 'unavailable'
  elsif variant.available
    assign availability = 'available'
  else
    assign availability = 'sold-out'
  endif

  assign primary_collection = collection
  if primary_collection == blank
    for c in product.collections
      unless c.handle == 'all' or c.handle == 'frontpage'
        assign primary_collection = c
        break
      endunless
    endfor
  endif
-%}

<div class="section-spacing product-section" data-product-section data-section-id="{{ section.id }}">
  <div class="product">
    {% render 'product-media', product: product, selected_variant: variant %}

    <div class="product__info">
      <nav class="product__breadcrumb spec" aria-label="Breadcrumb">
        <a href="{{ routes.all_products_collection_url }}">{{ 'collections.title' | t }}</a>
        {%- if primary_collection != blank -%}
          <span aria-hidden="true">/</span>
          <a href="{{ primary_collection.url }}">{{ primary_collection.title | escape }}</a>
        {%- endif -%}
        <span aria-hidden="true">/</span>
        <span aria-current="page">{{ product.title | truncate: 36 | escape }}</span>
      </nav>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}

          {%- when 'eyebrow' -%}
            {%- liquid
              assign eyebrow = block.settings.text
              if eyebrow == blank
                assign eyebrow = product.type
              endif
              if eyebrow == blank and primary_collection != blank
                assign eyebrow = primary_collection.title
              endif
              if eyebrow == blank
                assign eyebrow = product.vendor
              endif
            -%}
            <div class="product__eyebrow-row" {{ block.shopify_attributes }}>
              {%- if eyebrow != blank -%}
                <p class="product__eyebrow eyebrow">{{ eyebrow | escape }}</p>
              {%- endif -%}
              <div class="product__badges" data-region="badges">
                {%- if product.available == false -%}
                  <span class="badge badge--sold-out">{{ 'product.sold_out' | t }}</span>
                {%- elsif variant.compare_at_price > variant.price -%}
                  <span class="badge badge--sale">{{ 'product.sale' | t }}</span>
                {%- endif -%}
                {%- for tag in product.tags -%}
                  {%- assign tag_down = tag | downcase | strip -%}
                  {%- if tag_down == 'new' or tag_down == 'new arrival' -%}
                    <span class="badge">New</span>
                    {%- break -%}
                  {%- elsif tag_down == 'bestseller' or tag_down == 'best seller' -%}
                    <span class="badge">Bestseller</span>
                    {%- break -%}
                  {%- elsif tag_down == 'limited' or tag_down == 'limited edition' -%}
                    <span class="badge">Limited</span>
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'title' -%}
            {%- if request.design_mode -%}
              <h1 class="product__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>
            {%- else -%}
              <nk-text effect="cut" split="words" play-on-load {{ block.shopify_attributes }}>
                <h1 class="product__title" data-text-target>{{ product.title | escape }}</h1>
              </nk-text>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="product__price-row" data-region="price" {{ block.shopify_attributes }}>
              <div class="product__price">
                {% render 'price', product: product, variant: variant %}
              </div>
              {%- if variant.sku != blank -%}
                <span class="product__sku spec text-muted" data-product-sku>Ref. {{ variant.sku | escape }}</span>
              {%- endif -%}
            </div>

          {%- when 'text' -%}
            {%- if block.settings.text != blank -%}
              <div class="rte {{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'variant_picker' -%}
            {%- liquid
              assign size_modal_id = ''
              capture chart_rule
                render 'measurement-chart-rule', product: product
              endcapture
              assign chart_rule = chart_rule | strip
              assign size_table = block.settings.size_table
              assign size_unit = block.settings.size_unit
              assign size_heading = block.settings.size_heading
              assign size_note = block.settings.size_note
              if chart_rule != blank
                assign chart_prefix = 'size_chart_' | append: chart_rule
                assign table_key = chart_prefix | append: '_table'
                assign unit_key = chart_prefix | append: '_unit'
                assign basis_key = chart_prefix | append: '_basis'
                assign note_key = chart_prefix | append: '_note'
                assign size_table = settings[table_key]
                assign size_unit = settings[unit_key]
                assign size_heading = settings[basis_key]
                assign size_note = settings[note_key]
              endif
              capture size_chart_html
                render 'size-chart', product: product, page: block.settings.size_guide_page, table_csv: size_table, unit: size_unit, note: size_note, heading: size_heading, option: block.settings.size_guide_option, verified_chart: chart_rule
              endcapture
              assign size_chart_html = size_chart_html | strip
              if size_chart_html != blank
                assign size_modal_id = 'SizeGuide-' | append: section.id
              endif
            -%}

            {% render 'product-siblings', product: product %}

            {%- unless product.has_only_default_variant -%}
              <nk-variant-picker
                class="picker"
                data-region="picker"
                data-section-id="{{ section.id }}"
                data-product-url="{{ product.url }}"
                data-required-options="{{ settings.product_required_options | escape }}"
                data-explicit-size-choice
                {% unless needs_choice %}data-preselected{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign option_index = forloop.index
                    assign option_name = option.name | downcase | strip
                    assign size_names = block.settings.size_guide_option | downcase | strip
                    assign is_size_option = false
                    if option_name == size_names or option_name contains 'size'
                      assign is_size_option = true
                    endif
                    assign is_color_option = false
                    if option_name contains 'color' or option_name contains 'colour'
                      assign is_color_option = true
                    endif
                  -%}
                  <fieldset
                    class="option{% if is_size_option %} option--size{% endif %}{% if is_color_option %} option--color{% endif %}"
                    data-option-position="{{ option_index }}"
                    data-option-name="{{ option.name | escape }}"
                    {% if is_size_option %}data-size-fieldset{% endif %}
                  >
                    <div class="option__header">
                      <legend class="option__legend">
                        <span class="spec">
                          {{- option.name | escape }}:
                          <span class="option__selected-label" data-selected-value>
                            {%- if needs_choice and is_size_option -%}
                              {{ 'product.select_size_prompt' | t }}
                            {%- else -%}
                              {{ option.selected_value | escape }}
                            {%- endif -%}
                          </span>
                        </span>
                      </legend>
                      {%- if is_size_option and size_modal_id != blank -%}
                        <button type="button" class="size-guide-link spec" data-nk-open="{{ size_modal_id }}" aria-haspopup="dialog">
                          {{- 'product.size_guide' | t -}}
                        </button>
                      {%- endif -%}
                    </div>

                    <div class="option__values{% if is_size_option %} option__values--size{% endif %}" {% if is_size_option %}data-size-values{% endif %}>
                      {%- for value in option.values -%}
                        {%- liquid
                          assign state = 'available'
                          if value.variant == blank
                            assign state = 'missing'
                          elsif value.available == false
                            assign state = 'sold-out'
                          endif
                          if settings.product_sold_out_values == 'hide' and state != 'available' and value.selected == false
                            continue
                          endif
                          assign input_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index
                        -%}
                        {%- capture swatch_bg -%}{%- render 'swatch-color', value: value, is_color_option: is_color_option -%}{%- endcapture -%}
                        {%- assign swatch_bg = swatch_bg | strip -%}
                        <div
                          class="option__value option__value--{{ state }}{% if swatch_bg != blank %} option__value--swatch{% endif %}"
                          {% if is_size_option %}data-size-pill="{{ value | strip | upcase | escape }}"{% endif %}
                        >
                          <input
                            type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option_index }}"
                            value="{{ value | escape }}"
                            data-option-value-id="{{ value.id }}"
                            {% if value.product_url %}data-product-url="{{ value.product_url | escape }}"{% endif %}
                            data-focus-key="option-{{ value.id }}"
                            {% if value.selected %}checked{% endif %}
                            {% if is_size_option and state != 'available' %}disabled{% endif %}
                          >
                          <label for="{{ input_id }}">
                            {%- if swatch_bg != blank -%}
                              <span class="option__swatch" style="--swatch: {{ swatch_bg }}" aria-hidden="true"></span>
                            {%- endif -%}
                            <span class="option__label-text" data-text="{{ value | escape }}">{{- value | escape -}}</span>
                            {%- if state == 'sold-out' -%}
                              <span class="visually-hidden">{{ 'product.value_sold_out' | t }}</span>
                            {%- elsif state == 'missing' -%}
                              <span class="visually-hidden">{{ 'product.value_unavailable' | t }}</span>
                            {%- endif -%}
                          </label>
                        </div>
                      {%- endfor -%}
                      {%- if is_size_option -%}
                        <span class="option__underline" data-size-indicator aria-hidden="true"></span>
                      {%- endif -%}
                    </div>

                    {%- if is_size_option -%}
                      {% render 'product-measurements',
                        product: product,
                        size_option: option,
                        table_csv: size_table,
                        unit: size_unit,
                        heading: size_heading,
                        verified_chart: chart_rule,
                        modal_id: size_modal_id
                      %}
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}
                <p class="message message--error" data-picker-error role="alert" hidden>
                  {{ 'product.selection_failed' | t }}
                  <a href="{{ product.url }}">{{ 'product.reload_selection' | t }}</a>
                </p>
              </nk-variant-picker>

              {%- if size_modal_id != blank -%}
                <nk-modal id="{{ size_modal_id }}">
                  <dialog
                    class="drawer drawer--right size-guide-dialog"
                    aria-labelledby="SizeGuideTitle-{{ section.id }}"
                    data-swipe-close
                  >
                    <div class="size-guide-dialog__header" data-drag-handle>
                      <span class="size-guide-dialog__grip" aria-hidden="true"></span>
                      <div class="size-guide-dialog__titles">
                        <p class="size-guide-dialog__eyebrow spec">{{ 'product.size_guide' | t }}</p>
                        <h2 class="size-guide-dialog__title" id="SizeGuideTitle-{{ section.id }}" tabindex="-1" data-autofocus>
                          {{- product.title | escape -}}
                        </h2>
                      </div>
                      <button type="button" class="icon-button size-guide-dialog__close" data-nk-close aria-label="{{ 'general.close' | t }}">
                        {% render 'icon', name: 'close' %}
                      </button>
                    </div>
                    <div class="drawer__body size-guide__body">
                      {{ size_chart_html }}
                    </div>
                  </dialog>
                </nk-modal>
              {%- endif -%}
            {%- endunless -%}

          {%- when 'inventory' -%}
            <div class="inventory-note" data-region="inventory" {{ block.shopify_attributes }}>
              {%- liquid
                assign threshold = settings.inventory_threshold
              -%}
              {%- if variant and variant.available -%}
                {%- if variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny' and variant.inventory_quantity > 0 and variant.inventory_quantity <= threshold -%}
                  <span class="inventory-status inventory-status--low spec">
                    <span class="inventory-status__dot" aria-hidden="true"></span>
                    {{ 'product.low_stock' | t: count: variant.inventory_quantity }}
                  </span>
                {%- endif -%}
              {%- elsif availability == 'sold-out' -%}
                <span class="inventory-status inventory-status--sold-out spec">
                  <span class="inventory-status__dot" aria-hidden="true"></span>
                  {{ 'product.sold_out' | t }}

                </span>
              {%- endif -%}
            </div>

          {%- when 'buy_buttons' -%}
            <nk-product-form data-source-id="{{ section.id }}" {{ block.shopify_attributes }}>
              {%- assign form_id = 'ProductForm-' | append: section.id -%}
              {%- form 'product', product, id: form_id, novalidate: 'novalidate' -%}
                {%- if block.settings.show_quantity -%}
                  <div class="product__quantity-row" data-region="quantity">
                    <label class="spec" for="Quantity-{{ section.id }}">{{ 'product.quantity' | t }}</label>
                    <div class="quantity">
                      <button type="button" class="icon-button" data-qty-step="-1" aria-label="{{ 'product.decrease_quantity' | t }}">
                        {% render 'icon', name: 'minus', size: 16 %}
                      </button>
                      <input
                        id="Quantity-{{ section.id }}"
                        type="number"
                        inputmode="numeric"
                        name="quantity"
                        value="{{ variant.quantity_rule.min | default: 1 }}"
                        min="{{ variant.quantity_rule.min | default: 1 }}"
                        {% if variant.quantity_rule.max %}max="{{ variant.quantity_rule.max }}"{% endif %}
                        step="{{ variant.quantity_rule.increment | default: 1 }}"
                      >
                      <button type="button" class="icon-button" data-qty-step="1" aria-label="{{ 'product.increase_quantity' | t }}">
                        {% render 'icon', name: 'plus', size: 16 %}
                      </button>
                    </div>
                  </div>
                {%- endif -%}

                <div
                  class="buy"
                  data-region="buy"
                  data-availability="{{ availability }}"
                  data-variant-media-id="{{ variant.featured_media.id }}"
                  data-variant-title="{{ variant.title | escape }}"
                  data-variant-price="{{ variant.price | money | escape }}"
                >
                  {%- unless block.settings.show_quantity -%}
                    <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
                  {%- endunless -%}
                  <input type="hidden" name="id" value="{{ variant.id }}" {% if needs_choice %}disabled{% endif %}>
                  {%- liquid
                    case availability
                      when 'available'
                        assign label = 'product.add_to_cart' | t
                      when 'sold-out'
                        assign label = 'product.sold_out' | t
                      else
                        assign label = 'product.unavailable' | t
                    endcase
                  -%}
                  <button type="submit" name="add" class="button button--full buy__submit" {% if availability != 'available' %}disabled{% endif %}>
                    <span data-button-label>{{ label }}</span>
                    {%- if availability == 'available' -%}
                      <span class="buy__submit-sep" aria-hidden="true">·</span>
                      <span class="buy__submit-price" data-button-price>{{ variant.price | money }}</span>
                    {%- endif -%}
                  </button>

                </div>

                {%- unless product.has_only_default_variant -%}
                  <noscript>
                    {% render 'product-option-links', product: product %}
                  </noscript>
                {%- endunless -%}

              {%- endform -%}
              <p class="message message--error" data-form-error role="alert" hidden></p>
            </nk-product-form>

          {%- when 'description' -%}
            {%- liquid
              assign fabric_meta = product.metafields.custom.fabric | default: product.metafields.custom.materials
              assign fit_meta = product.metafields.custom.fit.value
              assign origin_meta = product.metafields.custom.origin.value
              assign care_meta = product.metafields.custom.care.value | default: product.metafields.custom.care_instructions.value
            -%}
            {%- if product.description != blank or fabric_meta != blank or fit_meta != blank or origin_meta != blank -%}
              <nk-disclosure {{ block.shopify_attributes }}>
                <details class="disclosure" {% if block.settings.open %}open{% endif %}>
                  {%- assign details_heading = 'product.details' | t -%}
                  <summary>{{ block.settings.heading | default: details_heading | escape }}</summary>
                  <div class="disclosure__content rte">
                    {%- if fabric_meta != blank or fit_meta != blank or origin_meta != blank -%}
                      <dl class="product__specs">
                        {%- if fabric_meta != blank -%}
                          <div class="product__spec-item">
                            <dt class="spec text-muted">Composition</dt>
                            <dd>{{ fabric_meta | metafield_tag }}</dd>
                          </div>
                        {%- endif -%}
                        {%- if fit_meta != blank -%}
                          <div class="product__spec-item">
                            <dt class="spec text-muted">Fit</dt>
                            <dd>{{ fit_meta | escape }}</dd>
                          </div>
                        {%- endif -%}
                        {%- if origin_meta != blank -%}
                          <div class="product__spec-item">
                            <dt class="spec text-muted">Origin</dt>
                            <dd>{{ origin_meta | escape }}</dd>
                          </div>
                        {%- endif -%}
                      </dl>
                    {%- endif -%}
                    {{ product.description }}
                  </div>
                </details>
              </nk-disclosure>
            {%- endif -%}
            {%- if care_meta != blank -%}
              <nk-disclosure>
                <details class="disclosure">
                  <summary>Fabric &amp; Care</summary>
                  <div class="disclosure__content rte">{{ product.metafields.custom.care | default: product.metafields.custom.care_instructions | metafield_tag }}</div>
                </details>
              </nk-disclosure>
            {%- endif -%}

          {%- when 'accordion' -%}
            {%- liquid
              assign accordion_content = block.settings.content
              if block.settings.page != blank
                assign accordion_content = block.settings.page.content
              endif
            -%}
            {%- if accordion_content != blank -%}
              <nk-disclosure {{ block.shopify_attributes }}>
                <details class="disclosure">
                  <summary>{{ block.settings.heading | escape }}</summary>
                  <div class="disclosure__content rte">{{ accordion_content }}</div>
                </details>
              </nk-disclosure>
            {%- endif -%}

          {%- when 'custom_liquid' -%}
            <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

</div>

{% schema %}
{
  "name": "Product information",
  "class": "main-product-section",
  "settings": [],
  "blocks": [
    { "type": "@app" },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "info": "Leave empty to show the product type, or its first collection." }
      ]
    },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "size_guide_option", "label": "Show size guide next to option", "default": "Size" },
        { "type": "page", "id": "size_guide_page", "label": "Size guide page (fallback)", "info": "Used when a product has no size_chart metafield." },
        { "type": "text", "id": "size_heading", "label": "Size guide heading", "default": "Measured flat, garment in hand" },
        {
          "type": "textarea",
          "id": "size_table",
          "label": "Size table",
          "info": "Optional merchant-verified chart shared by products using this template. Leave empty unless it applies to every such product. Prefer product metafields. First line: headings; subsequent lines: comma-separated measurements."
        },
        {
          "type": "select",
          "id": "size_unit",
          "label": "Table is written in",
          "options": [
            { "value": "in", "label": "Inches" },
            { "value": "cm", "label": "Centimetres" }
          ],
          "default": "in"
        },
        { "type": "text", "id": "size_note", "label": "Note under the table" }
      ]
    },
    { "type": "inventory", "name": "Inventory status", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity", "default": false }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "", "label": "Body" },
            { "value": "spec", "label": "Label" }
          ],
          "default": ""
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": true }
      ]
    },
    {
      "type": "accordion",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Fabric & care" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Content from page" }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
