{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}

<article class="section-spacing color-{{ section.settings.color_scheme }}" style="max-width: {{ section.settings.width | default: 72 }}ch; margin-inline: auto;">
  <div class="collection-header">
    <h1 class="display">{{ article.title | escape }}</h1>
  </div>

  <div style="margin-bottom: 24px;">{% render 'article-meta', article: article, show_date: section.settings.show_date, show_author: section.settings.show_author %}</div>

  {% if article.image and section.settings.show_image != false %}
    <div style="margin-bottom: 32px;">
      {{ article.image | image_url: width: 1400 | image_tag: widths: '600, 1000, 1400', sizes: '(min-width: 750px) 72ch, 100vw', alt: article.image.alt }}
    </div>
  {% endif %}

  <div class="rte">{{ article.content }}</div>

  {% if blog.comments_enabled? and section.settings.show_comments != false %}
    <div style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--nk-color-line);">
      <h2 style="margin-bottom: 20px;">{{ 'blog.article_comments' | t }}</h2>

      <div id="comments" style="display: grid; gap: 16px; margin-bottom: 32px;">
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div style="padding-bottom: 16px; border-bottom: 1px solid var(--nk-color-line);">
              <p class="spec">{{ comment.author | escape }} · {{- comment.created_at | time_tag: format: 'date' -}}</p>
              <div class="rte">{{ comment.content }}</div>
            </div>
          {% endfor %}

          {%- if paginate.pages > 1 -%}
            {% render 'pagination', paginate: paginate %}
          {%- endif -%}
        {% endpaginate %}
      </div>

      {% assign comment_form_id = 'CommentForm-' | append: section.id %}
      {% form 'new_comment', article, id: comment_form_id %}
        <h2 style="margin-bottom: 16px;">{{ 'blog.comment_form_title' | t }}</h2>
        {% if form.posted_successfully? %}<p class="message" role="status">{{ 'blog.comment_received' | t }}</p>{% endif %}

        {% if form.errors %}
          <div class="message message--error" style="margin-bottom: 16px;">{{ form.errors | default_errors }}</div>
        {% endif %}

        <div style="display: grid; gap: 16px;">
          <div style="display: grid; gap: 6px;">
            <label class="spec" for="CommentAuthor-{{ section.id }}">{{ 'blog.comment_form_name' | t }}</label>
            <input type="text" name="comment[author]" id="CommentAuthor-{{ section.id }}" value="{{ form.author | escape }}" required style="min-height: 48px; padding: 0 12px; border: 1px solid var(--nk-color-line); background: transparent;">
          </div>

          <div style="display: grid; gap: 6px;">
            <label class="spec" for="CommentEmail-{{ section.id }}">{{ 'blog.comment_form_email' | t }}</label>
            <input type="email" name="comment[email]" id="CommentEmail-{{ section.id }}" value="{{ form.email | escape }}" required style="min-height: 48px; padding: 0 12px; border: 1px solid var(--nk-color-line); background: transparent;">
          </div>

          <div style="display: grid; gap: 6px;">
            <label class="spec" for="CommentBody-{{ section.id }}">{{ 'blog.comment_form_body' | t }}</label>
            <textarea name="comment[body]" id="CommentBody-{{ section.id }}" rows="4" required style="padding: 12px; border: 1px solid var(--nk-color-line); background: transparent;">{{ form.body | escape }}</textarea>
          </div>

          <div>
            <button type="submit" class="button">{{ 'blog.comment_form_submit' | t }}</button>
          </div>
        </div>
      {% endform %}
    </div>
  {% endif %}
</article>

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "range",
      "id": "width",
      "label": "Reading width",
      "min": 56,
      "max": 96,
      "step": 4,
      "default": 72,
      "unit": "ch"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show article image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comments and comment form",
      "default": true,
      "info": "Requires comments to be enabled for this blog in Shopify."
    }
  ],
  "limit": 1,
  "enabled_on": {
    "templates": [
      "article"
    ]
  }
}
{% endschema %}
