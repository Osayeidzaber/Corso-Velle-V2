      "options": [
        {
          "value": "inherit",
          "label": "Use theme default"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        },
