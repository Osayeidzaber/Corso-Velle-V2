{%- comment -%}
  "You might also like": Shopify product recommendations, loaded when the section nears the
  viewport (<nk-recommendations>). The recommendations route renders this same section with
  recommendations.performed; the first render is an empty shell.
{%- endcomment -%}
{%- liquid
  assign source_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent
-%}
<div class="section-spacing color-{{ section.settings.color_scheme }} full-width">
  <div style="width: var(--content-width); margin-inline: auto;">
    <nk-recommendations url="{{ source_url }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="section-head">
          {%- liquid
            assign heading_html = section.settings.heading | escape
            assign italic = section.settings.heading_italic | escape
          -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: 'cut', class: 'display' %}
        </div>
        <nk-stagger>
          <ul class="product-grid" role="list" style="--nk-cols-desktop: {{ section.settings.columns_desktop }};">
            {%- for product in recommendations.products -%}
              <li data-stagger-item>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          </ul>
        </nk-stagger>
      {%- endif -%}
    </nk-recommendations>
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "class": "product-recommendations-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)", "default": "also like" },
    {
      "type": "select",
      "id": "intent",
      "label": "Show",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Product recommendations" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
