      "id": "link_label",
      "label": "Optional button label"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    },
    {
      "name": "Complementary products",
      "settings": {
        "intent": "complementary",
        "heading": "Complete the",
        "heading_italic": "look"
      }
    }
  ],
  "enabled_on": {
