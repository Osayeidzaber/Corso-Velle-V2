{%- comment -%}
  "You might also like": Shopify product recommendations, loaded when the section nears the
  viewport (<nk-recommendations>). The recommendations route renders this same section with
  recommendations.performed; the first render is an empty shell.
{%- endcomment -%}
{%- liquid
  assign source_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: section.settings.limit | append: '&intent=' | append: section.settings.intent
  assign suggested_products = recommendations.products
  if recommendations.products_count == 0 or recommendations.performed == false
    assign suggested_products = section.settings.fallback_collection.products
  endif
-%}
<div class="product-recommendations section-spacing section-presentation color-{{ section.settings.color_scheme }} full-width" data-align="{{ section.settings.heading_alignment }}" style="{% render 'section-presentation', presentation: section.settings %}--recommendations-gap:{{ section.settings.grid_gap | default: 8 }}px;">
  <div style="width: var(--content-width); margin-inline: auto;">
    <nk-recommendations url="{{ source_url }}" {% if section.settings.hide_empty == false %}show-empty{% endif %}>
      {%- if suggested_products.size > 0 -%}
        <div class="section-head">
          {%- liquid
            assign heading_html = section.settings.heading | escape
            assign italic = section.settings.heading_italic | escape
          -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: 'cut', class: 'display' %}
        </div>
        <nk-stagger>
          <ul class="product-grid" role="list" style="--nk-cols-desktop: {{ section.settings.columns_desktop }};--nk-cols-mobile:{{ section.settings.columns_mobile | default: 1 }};">
            {%- for product in suggested_products limit: section.settings.limit -%}
              <li data-stagger-item>{% render 'product-card', product: product, card_options: section.settings %}</li>
            {%- endfor -%}
          </ul>
        </nk-stagger>
        {% if section.settings.link != blank and section.settings.link_label != blank %}<a class="button button--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
      {% elsif section.settings.hide_empty == false %}
        <p class="text-muted">{{ section.settings.empty_text | escape }}</p>
      {%- endif -%}
    </nk-recommendations>
  </div>
</div>

{% stylesheet %}
  .product-recommendations .product-grid { column-gap: var(--recommendations-gap, 8px); }
  .product-recommendations[data-align='center'] .section-head { justify-content: center; text-align: center; }
  .product-recommendations nk-recommendations > .button { margin-top: 24px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "class": "product-recommendations-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You might"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic part)",
      "default": "also like"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection",
      "info": "Shown when Shopify has no recommendations, or if recommendations cannot load."
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Show",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products"
        }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "card_appearance",
