<section class="feature-grid full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-layout="{{ section.settings.layout }}" data-align="{{ section.settings.alignment }}" data-appearance="{{ section.settings.appearance }}" style="{% render 'section-presentation', presentation: section.settings %}--feature-cols:{{ section.settings.columns }};--feature-phone-cols:{{ section.settings.columns_mobile }};--feature-gap:{{ section.settings.gap }}px;--feature-icon-size:{{ section.settings.icon_size }}px;">
  <div class="feature-grid__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    {% assign wrapper = 'div' %}{% if section.settings.animate %}{% assign wrapper = 'nk-stagger' %}{% endif %}
    <{{ wrapper }}><ul class="feature-grid__items" role="list">
      {% for block in section.blocks %}<li {% if section.settings.animate %}data-stagger-item{% endif %}>{% render 'feature-card', block: block %}</li>{% endfor %}
    </ul></{{ wrapper }}>
  </div>
</section>

{% stylesheet %}
 .feature-grid__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
 .feature-grid__inner > h2 { font-size: clamp(2rem, 4vw, 3.5rem); overflow-wrap: anywhere; }
 .feature-grid__items { display: grid; grid-template-columns: repeat(var(--feature-phone-cols, 1), minmax(0, 1fr)); gap: var(--feature-gap, 24px); list-style: none; margin: 0; padding: 0; }
 .feature-grid__items > li { min-width: 0; }
 .feature-grid__items .feature-card { height: 100%; }
 .feature-grid[data-appearance='bordered'] { --feature-border: 1px; --feature-padding: 20px; }
 .feature-grid[data-appearance='surface'] { --feature-bg: var(--nk-color-surface); --feature-padding: 20px; }
 .feature-grid[data-align='center'] { text-align: center; }
 .feature-grid[data-align='center'] .feature-card { flex-direction: column; align-items: center; }
 @media (min-width: 750px) { .feature-grid__items { grid-template-columns: repeat(var(--feature-cols, 3), minmax(0, 1fr)); } }
 .feature-grid[data-layout='list'] .feature-grid__items { grid-template-columns: minmax(0, 1fr); }
{% endstylesheet %}

{% schema %}
{
  "name": "Feature grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What makes us different"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "appearance",
      "label": "Card appearance",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        },
        {
          "value": "surface",
          "label": "Surface"
        }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Phone columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Subtle card entrances",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit",
      "info": "Sets the width of the image and text together. Background stays full width. All options keep the theme's responsive page gutters."
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px. Custom values are exact and are not multiplied by the global smaller-screen spacing setting."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
