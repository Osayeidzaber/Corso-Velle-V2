            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "box",
              "label": "Package"
            },
            {
              "value": "truck",
              "label": "Delivery"
            }
          ],
          "default": "none"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Decorative icon or image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product feature"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "select",
          "id": "appearance",
          "label": "Appearance",
          "options": [
            {
              "value": "inherit",
              "label": "Use section choice"
            },
            {
              "value": "plain",
              "label": "Plain"
            },
            {
              "value": "bordered",
              "label": "Bordered"
            },
            {
              "value": "surface",
              "label": "Surface"
            }
          ],
          "default": "inherit"
