{%- comment -%}
  Button row: call-to-action links in the theme-wide button styles (Uiverse + HyperUI adaptations in snippets/nk-button).
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="button-row kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-align="{{ section.settings.alignment }}" data-width="{{ section.settings.button_width }}" data-mobile="{{ section.settings.mobile_layout }}" style="{% render 'section-presentation', presentation: section.settings %}--button-row-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="button-row__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <div class="button-row__buttons">
      {%- for block in section.blocks -%}
        <div class="button-row__item"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>{% render 'nk-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, new_tab: block.settings.new_tab %}</div>
      {%- endfor -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.button-row__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
.button-row__buttons { display: flex; flex-wrap: wrap; gap: var(--button-row-gap, 16px); align-items: center; }
.button-row__item { min-width: 0; max-width: 100%; }
.button-row[data-align='center'] .button-row__buttons { justify-content: center; }
.button-row[data-align='right'] .button-row__buttons { justify-content: flex-end; }
.button-row[data-width='equal'] .button-row__item { flex: 1 1 0; min-width: 180px; }
.button-row[data-width='equal'] .nk-btn, .button-row[data-width='full'] .nk-btn { width: 100%; }
.button-row[data-width='full'] .button-row__item { flex: 1 1 100%; }
@media (max-width: 749px) {
  .button-row[data-mobile='stack'] .button-row__buttons { flex-direction: column; flex-wrap: nowrap; align-items: stretch; }
  .button-row[data-mobile='stack'] .button-row__item { flex: none; width: 100%; }
  .button-row[data-mobile='stack'] .nk-btn { width: 100%; }
}
{% endstylesheet %}

