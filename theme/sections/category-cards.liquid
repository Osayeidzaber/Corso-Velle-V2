{%- comment -%}
  The wardrobe: restored lead-plus-four bento from 9e8375b, with full garment photography,
  live collection counts and existing stagger lifecycle/reduced-motion support.
{%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'category' -%}
{%- if cards.size > 0 -%}
  <div class="category-cards full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-palette="{{ section.settings.card_palette }}" data-style="{{ section.settings.card_style | default: 'studio' }}"{% if section.settings.card_outline %} data-outline{% endif %} style="{% render 'section-presentation', presentation: section.settings %}--cc-fit:{{ section.settings.image_fit | default: 'contain' }};--cc-radius:{{ section.settings.card_radius | default: 0 }}px;">
    <div class="category-cards__inner">
      <div class="section-head category-cards__head">
        <div class="category-cards__heading">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- liquid
            assign heading_html = section.settings.heading | escape
            assign italic = section.settings.heading_italic | escape
          -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: section.settings.heading_entrance, class: 'display' %}
        </div>
        {%- if section.settings.link != blank -%}
          <a class="category-cards__cta spec" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">↗</span></a>
        {%- endif -%}
      </div>
      {%- liquid
        assign layout = section.settings.layout | default: 'bento'
        assign uses_lead = true
        if layout == 'grid' or layout == 'scroller'
          assign uses_lead = false
        endif
        case section.settings.image_ratio
          when 'portrait'
            assign ratio = '4 / 5'
          when 'square'
            assign ratio = '1 / 1'
          when 'wide'
            assign ratio = '3 / 2'
          else
            assign ratio = '6 / 5'
        endcase
      -%}
      <nk-stagger
        class="category-cards__bento"
        data-count="{{ cards.size }}"
        data-layout="{{ layout }}"
        data-mobile="{{ section.settings.mobile_layout | default: 'stacked' }}"
        style="--cc-cols: {{ section.settings.columns | default: 4 }}; --cc-gap: {{ section.settings.gap | default: 16 }}px; --cc-ratio: {{ ratio }};"
      >
        {%- for block in cards -%}
          {%- liquid
            assign c = block.settings.collection
            assign image = block.settings.image | default: c.featured_image
            if image == blank and c != blank and c.products.first != blank
              assign image = c.products.first.featured_media.preview_image
            endif
            assign title = block.settings.title | default: c.title
            assign url = block.settings.link | default: c.url
            assign idx = forloop.index | prepend: '0' | slice: -2, 2
          -%}
          <article class="category-card{% if forloop.first and uses_lead %} category-card--lead{% endif %}{% if block.settings.custom_colors %} color-{{ block.settings.color_scheme }}{% endif %}" {% if block.settings.custom_colors %}data-custom-colors{% endif %} data-fit="{{ block.settings.image_fit }}" data-stagger-item {{ block.shopify_attributes }}>
            <div class="category-card__index spec">
              {% if section.settings.show_index != false %}<span>{{ idx }} /</span>{% endif %}
              {%- if c != blank and section.settings.show_count != false -%}<span>{{ 'collection.product_count' | t: count: c.all_products_count }}</span>{%- endif -%}
            </div>
            <div class="category-card__media" aria-hidden="true">
              {%- if image -%}
                {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200, 1600', sizes: '(min-width: 990px) 48vw, (min-width: 600px) 48vw, 100vw', alt: '' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="category-card__content">
              <div class="category-card__title-row">
                <h3 class="category-card__title display">{% if url != blank %}<a href="{{ url }}">{% endif %}<em>{{ title | escape }}</em>{% if url != blank %}</a>{% endif %}</h3>
                {% if url != blank %}<span class="category-card__arrow" aria-hidden="true">↗</span>{% endif %}
              </div>
              {%- if block.settings.description != blank and section.settings.show_description != false -%}<p class="category-card__description">{{ block.settings.description | escape }}</p>{%- endif -%}
              {%- assign sub = block.settings.menu -%}
              {%- if sub.links.size > 0 -%}
                <ul class="category-card__links" role="list">
                  {%- for link in sub.links limit: section.settings.menu_limit -%}<li><a class="spec link-underline" href="{{ link.url }}">{{ link.title | escape }} ↗</a></li>{%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </nk-stagger>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .category-cards[data-palette='scheme'] .category-card:nth-child(n),
  .category-cards .category-card[data-custom-colors]:nth-child(n) { background: var(--nk-color-surface); color: var(--nk-color-text); }
  .category-cards[data-outline][data-palette='scheme'] .category-card:nth-child(n),
  .category-cards[data-outline] .category-card[data-custom-colors]:nth-child(n) { border-color: var(--nk-color-line); }
  .category-cards[data-palette] .category-card__media > img { object-fit: var(--cc-fit, contain); }
  .category-cards .category-card[data-fit='cover'] .category-card__media > img { object-fit: cover; }
  .category-cards .category-card[data-fit='contain'] .category-card__media > img { object-fit: contain; }
  .category-cards[data-palette='scheme'] .category-card__arrow,
  .category-cards .category-card[data-custom-colors] .category-card__arrow { border-color: var(--nk-color-line); }
  @media (hover: hover) { .category-cards[data-palette='scheme'] .category-card:hover .category-card__arrow,
  .category-cards .category-card[data-custom-colors]:hover .category-card__arrow { background: var(--nk-color-text); color: var(--nk-color-bg); } }
  .category-cards__inner { width: var(--content-width); margin-inline: auto; }
  .category-cards__head { align-items: end; padding-bottom: 24px; }
  .category-cards__heading { display: grid; gap: 16px; }
  .category-cards__cta { display: inline-flex; align-items: center; gap: 32px; min-height: 44px; padding-block: 10px; border-bottom: 1px solid currentColor; text-decoration: none; }
  .category-cards__cta span { font-size: 20px; }

  /* ---------- Card ---------- */
  .category-cards .category-card { position: relative; display: flex; flex-direction: column; isolation: isolate; overflow: hidden; min-width: 0; background: #f0eee9; color: #24211d; border: 1px solid transparent; border-radius: var(--cc-radius, 0px); }
  .category-cards[data-outline] .category-card { border-color: rgba(36,33,29,.16); }
  .category-cards .category-card:nth-child(5n + 2) { background: #e9e6df; }
  .category-cards .category-card:nth-child(5n + 3) { background: #e9ebea; }
  .category-cards .category-card:nth-child(5n + 4) { background: #e7e9ed; }
  .category-cards .category-card:nth-child(5n + 5) { background: #eae4dc; }
  .category-card__index { position: relative; z-index: 2; display: flex; justify-content: space-between; gap: 12px; padding: 18px 20px 0; font-size: 10px; letter-spacing: .16em; }
  /* Fit the complete photograph inside each tile, including on hover. */
  .category-cards .category-card__media { position: relative; flex: 1 1 auto; min-height: 140px; margin: 12px 0 0; aspect-ratio: var(--cc-ratio, 6 / 5); overflow: hidden; }
  .category-cards .category-card__media > img, .category-cards .category-card__media > svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; object-position: center; }
  .category-cards .category-card__media > svg { object-fit: contain; }
  .category-card__content { padding: 12px 20px 22px; }
  .category-card__title-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .category-cards .category-card__title { margin: 0; font-size: clamp(24px, 2.6vw, 40px); line-height: 1.1; overflow-wrap: anywhere; }
  .category-card__title a { text-decoration: none; }
  .category-card__title a::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .category-card__arrow { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; border: 1px solid rgba(36,33,29,.24); border-radius: 50%; font-size: 22px; transition: color 250ms, background 250ms, transform 400ms; }
  .category-card__description { max-width: 36ch; margin: 8px 0 0; font-size: 12px; line-height: 1.5; opacity: .72; }
  .category-card__links { position: relative; z-index: 2; display: flex; flex-wrap: wrap; gap: 8px 16px; list-style: none; margin: 12px 0 0; padding: 0; }
  .category-card:focus-within { outline: 2px solid currentColor; outline-offset: -3px; }
  @media (hover: hover) and (pointer: fine) {
    .category-card:hover .category-card__arrow { background: #24211d; color: #faf8f5; transform: rotate(45deg); }
  }

  /* ---------- Layouts ----------
     --cc-cols (Columns), --cc-gap (Card spacing) and --cc-ratio (Image shape) come from section
     settings; data-layout is the desktop layout, data-mobile the phone layout (< 750px).
     The featured "lead" card exists only in the bento and banner layouts. */
  .category-cards__bento { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: min(var(--cc-gap, 16px), 10px); }

  /* Phone (< 750px) */
  @media (max-width: 749px) {
    .category-cards__head { align-items: start; gap: 20px; }
    .category-cards__cta { gap: 12px; }
    .category-card__index { padding: 12px 12px 0; font-size: 9px; flex-wrap: wrap; gap: 4px; }
    .category-cards .category-card__media { min-height: 120px; margin-top: 8px; }
    .category-card__content { padding: 10px 12px 16px; }
    .category-cards .category-card__title { font-size: clamp(20px, 6vw, 28px); }
    .category-card__arrow { width: 28px; height: 28px; font-size: 17px; }
    .category-card__description { font-size: 11px; }

    /* Featured card full width, then two columns (two columns when the layout has no lead). */
    .category-cards__bento[data-mobile='stacked'] .category-card--lead { grid-column: 1 / -1; }
    .category-cards__bento[data-mobile='stacked'] .category-card--lead .category-card__media { aspect-ratio: 4 / 3; min-height: 240px; }
    .category-cards__bento[data-mobile='stacked'] .category-card--lead .category-card__content { padding: 16px 20px 24px; }
    .category-cards__bento[data-mobile='stacked'] .category-card--lead .category-card__title { font-size: clamp(40px, 13vw, 52px); }
    /* A card left alone on the last row spans it instead of leaving a hole beside it. */
    .category-cards__bento[data-mobile='stacked']:has(.category-card--lead) .category-card:not(.category-card--lead):nth-child(even):last-child,
    .category-cards__bento[data-mobile='stacked']:not(:has(.category-card--lead)) .category-card:nth-child(odd):last-child,
    .category-cards__bento[data-mobile='two'] .category-card:nth-child(odd):last-child { grid-column: 1 / -1; }

    .category-cards__bento[data-mobile='one'] { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .category-cards__bento[data-mobile='one'] .category-card__title { font-size: clamp(28px, 9vw, 40px); }
    .category-cards__bento[data-mobile='one'] .category-card__content { padding: 14px 18px 20px; }

    /* Swipe row: cards snap and the next one peeks in, so the row reads as scrollable. */
    .category-cards__bento[data-mobile='scroll'] { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; gap: 10px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: none; margin-inline: calc(var(--nk-gutter) * -1); padding-inline: var(--nk-gutter); scroll-padding-inline: var(--nk-gutter); }
    .category-cards__bento[data-mobile='scroll']::-webkit-scrollbar { display: none; }
    .category-cards__bento[data-mobile='scroll'] > .category-card { scroll-snap-align: start; }
  }

  /* Tablet and up */
  @media (min-width: 750px) {
    .category-cards__bento { gap: var(--cc-gap, 16px); }
    .category-card--lead { grid-column: 1 / -1; }
    .category-cards .category-card--lead .category-card__media { min-height: 280px; aspect-ratio: 16 / 9; }
    .category-cards .category-card--lead .category-card__title { font-size: clamp(44px, 6vw, 88px); }
    .category-cards__bento[data-layout='grid'] { grid-template-columns: repeat(min(var(--cc-cols, 4), 3), minmax(0, 1fr)); }
    .category-cards__bento[data-layout='scroller'] { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: calc((100% - var(--cc-gap, 16px) * 1.5) / 2.5); overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; scrollbar-width: thin; padding-bottom: 8px; }
    .category-cards__bento[data-layout='scroller'] > .category-card { scroll-snap-align: start; }
  }

  /* Desktop */
  @media (min-width: 990px) {
    /* Bento: a 2x2 featured card beside a grid, on the left or the right. */
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right']) { grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-rows: minmax(300px, auto); grid-auto-flow: dense; }
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right']) .category-card--lead { grid-column: span 2; grid-row: span 2; }
    .category-cards__bento[data-layout='bento_right'] .category-card--lead { grid-column: 3 / span 2; grid-row: 1 / span 2; }
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right']) .category-card--lead .category-card__media { aspect-ratio: auto; }
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right'])[data-count='1'] .category-card--lead { grid-column: 1 / -1; grid-row: span 1; }
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right']):is([data-count='2'], [data-count='3']) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .category-cards__bento:is([data-layout='bento'], [data-layout='bento_right']):is([data-count='2'], [data-count='3']) .category-card--lead { grid-column: span 1; }
    .category-cards__bento[data-layout='bento_right']:is([data-count='2'], [data-count='3']) .category-card--lead { grid-column: 2; grid-row: 1 / span 2; }

    /* Banner: a wide featured card across the top, the rest in a row of --cc-cols. */
    .category-cards__bento[data-layout='banner'] { grid-template-columns: repeat(var(--cc-cols, 4), minmax(0, 1fr)); }
    .category-cards__bento[data-layout='banner'] .category-card--lead { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); grid-template-rows: auto 1fr; }
    .category-cards__bento[data-layout='banner'] .category-card--lead .category-card__index { grid-column: 2; grid-row: 1; }
    .category-cards__bento[data-layout='banner'] .category-card--lead .category-card__media { grid-column: 1; grid-row: 1 / span 2; margin: 0; aspect-ratio: 16 / 7; min-height: 320px; }
    .category-cards__bento[data-layout='banner'] .category-card--lead .category-card__content { grid-column: 2; grid-row: 2; align-self: end; }

    .category-cards__bento[data-layout='grid'] { grid-template-columns: repeat(var(--cc-cols, 4), minmax(0, 1fr)); }
    .category-cards__bento[data-layout='scroller'] { grid-auto-columns: calc((100% - var(--cc-gap, 16px) * (var(--cc-cols, 4) - 1)) / var(--cc-cols, 4)); }

    .category-card--lead .category-card__content { padding: 24px 32px 32px; }
    .category-card--lead .category-card__index { padding: 24px 32px 0; }
    .category-card--lead .category-card__description { font-size: 14px; }
  }

  /* ---------- Card styles (Card style setting, data-style) ----------
     Each style is scoped to .category-cards[data-style] and uses :nth-child(n) where it must beat
     the palette rules above. Layout (data-layout) still decides where cards sit. */
  .category-cards .category-card__media > img { transition: transform 900ms cubic-bezier(.22,.61,.36,1); }

  /* Full photo: the image fills the card; index and text sit over it on a shade. */
  .category-cards[data-style='overlay'] .category-card { display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); color: #fff; background: #24211d; }
  .category-cards[data-style='overlay'] .category-card > * { grid-area: 1 / 1; }
  .category-cards[data-style='overlay'] .category-card > .category-card__media { margin: 0; min-height: 240px; height: 100%; }
  .category-cards[data-style='overlay'] .category-card:not([data-fit='contain']) .category-card__media > img { object-fit: cover; }
  .category-cards[data-style='overlay'] .category-card > .category-card__index { align-self: start; padding-bottom: 40px; background: linear-gradient(rgb(20 18 16 / .45), transparent); }
  .category-cards[data-style='overlay'] .category-card > .category-card__content { align-self: end; position: relative; z-index: 2; padding-top: 72px; background: linear-gradient(transparent, rgb(20 18 16 / .72)); }
  .category-cards[data-style='overlay'] .category-card__arrow { border-color: rgb(255 255 255 / .6); }
  .category-cards[data-style='overlay'] .category-card__description { opacity: .88; }
  @media (hover: hover) and (pointer: fine) {
    .category-cards[data-style='overlay'] .category-card:hover .category-card__media > img { transform: scale(1.04); }
    .category-cards[data-style='overlay'] .category-card:hover .category-card__arrow { background: #fff; color: #24211d; }
  }

  /* Minimal: no tile; the photo stands on the page and the caption sits under it on a hairline. */
  .category-cards[data-style='minimal'] .category-card:nth-child(n) { background: transparent; color: inherit; border-color: transparent; border-radius: 0; }
  .category-cards[data-style='minimal'] .category-card > .category-card__media { order: -1; margin: 0; border-radius: var(--cc-radius, 0px); }
  .category-cards[data-style='minimal'][data-outline] .category-card > .category-card__media { outline: 1px solid rgba(36,33,29,.16); outline-offset: -1px; }
  .category-cards[data-style='minimal'] .category-card > .category-card__index { padding: 14px 0 0; }
  .category-cards[data-style='minimal'] .category-card > .category-card__content { padding: 6px 0 0; }
  .category-cards[data-style='minimal'] .category-card__title-row { padding-bottom: 12px; border-bottom: 1px solid currentColor; }
  .category-cards[data-style='minimal'] .category-card__arrow { width: auto; height: auto; border: 0; border-radius: 0; }
  @media (hover: hover) and (pointer: fine) {
    .category-cards[data-style='minimal'] .category-card:hover .category-card__media > img { transform: scale(1.03); }
    .category-cards[data-style='minimal'] .category-card:hover .category-card__arrow { background: none; color: inherit; transform: translate(3px, -3px); }
  }

  /* Gallery frame: a white mat around the photo, a soft shadow and a centred title. */
  .category-cards[data-style='framed'] .category-card:nth-child(n) { padding: 14px; background: #fff; color: #24211d; border-color: rgba(36,33,29,.12); box-shadow: 0 18px 40px -28px rgb(36 33 29 / .45); }
  .category-cards[data-style='framed'][data-palette='scheme'] .category-card:nth-child(n) { background: var(--nk-color-bg); color: var(--nk-color-text); border-color: var(--nk-color-line); }
  .category-cards[data-style='framed'] .category-card > .category-card__media { margin: 0; border-radius: max(0px, calc(var(--cc-radius, 0px) - 8px)); }
  .category-cards[data-style='framed'] .category-card > .category-card__index { order: 2; justify-content: center; gap: 18px; padding: 16px 0 0; opacity: .7; }
  .category-cards[data-style='framed'] .category-card > .category-card__content { order: 3; padding: 8px 8px 6px; text-align: center; }
  .category-cards[data-style='framed'] .category-card__title-row { justify-content: center; }
  .category-cards[data-style='framed'] .category-card__arrow { display: none; }
  .category-cards[data-style='framed'] .category-card__description { margin-inline: auto; }
  .category-cards[data-style='framed'] .category-card__links { justify-content: center; }
  .category-cards[data-style='framed'] .category-card { transition: transform 500ms cubic-bezier(.22,.61,.36,1), box-shadow 500ms cubic-bezier(.22,.61,.36,1); }
  @media (hover: hover) and (pointer: fine) {
    .category-cards[data-style='framed'] .category-card:nth-child(n):hover { transform: translateY(-4px); box-shadow: 0 26px 50px -28px rgb(36 33 29 / .55); }
  }

  /* Color band: the photo runs edge to edge, then a solid title bar closes the card. */
  .category-cards[data-style='band'] .category-card > .category-card__media { margin: 0; }
  .category-cards[data-style='band'] .category-card > .category-card__index { position: absolute; inset: 0 0 auto; }
  .category-cards[data-style='band'] .category-card > .category-card__content { margin-top: auto; padding: 18px 20px 20px; background: #24211d; color: #faf8f5; }
  .category-cards[data-style='band'][data-palette='scheme'] .category-card > .category-card__content,
  .category-cards[data-style='band'] .category-card[data-custom-colors] > .category-card__content { background: var(--nk-color-text); color: var(--nk-color-bg); }
  .category-cards[data-style='band'] .category-card__arrow { border-color: currentColor; }
  .category-cards[data-style='band'] .category-card__description { opacity: .78; }
  @media (hover: hover) and (pointer: fine) {
    .category-cards[data-style='band'] .category-card:hover .category-card__media > img { transform: scale(1.04); }
    .category-cards[data-style='band'] .category-card:hover .category-card__arrow { background: #faf8f5; color: #24211d; }
  }
  @media (min-width: 990px) {
    .category-cards[data-style='band'] .category-card--lead > .category-card__content { padding: 24px 32px 28px; }
  }
  @media (max-width: 749px) {
    .category-cards[data-style='framed'] .category-card:nth-child(n) { padding: 8px; }
    .category-cards[data-style='band'] .category-card > .category-card__content { padding: 12px 12px 14px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-cards .category-card__media > img, .category-card__arrow, .category-cards[data-style='framed'] .category-card { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "class": "category-cards-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic part)",
      "default": "wardrobe"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "default": "bento",
      "options": [
        {
          "value": "bento",
          "label": "Bento, featured card left"
        },
        {
          "value": "bento_right",
          "label": "Bento, featured card right"
        },
        {
          "value": "banner",
          "label": "Wide banner, then a row"
        },
        {
