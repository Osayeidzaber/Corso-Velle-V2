{%- comment -%}
  Shop by category (rewrite of the supplied cardnav example as a homepage section, Riviera
  board 16): a large lead card plus smaller cards, each a collection with its own image, an
  optional description and up to four sub-links. Cards rise in sequence (GSAP, <nk-stagger>).
  Layout uses Tailwind utilities.
{%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'category' -%}
{%- if cards.size > 0 -%}
  <div class="full-width section-spacing color-{{ section.settings.color_scheme }}">
    <div style="width: var(--content-width); margin-inline: auto;">
      <div class="section-head">
        <div class="flex flex-col gap-4">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- liquid
                assign heading_html = section.settings.heading | escape
                assign italic = section.settings.heading_italic | escape
              -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: 'fold', hover: 'refold', class: 'display' %}
        </div>
        {%- if section.settings.link != blank -%}
          <a class="spec link-underline" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>

      <nk-stagger class="grid grid-cols-2 gap-2 md:gap-4 lg:grid-cols-4 lg:grid-rows-2 lg:h-[min(78vh,760px)]">
        {%- for block in cards -%}
          {%- liquid
            assign c = block.settings.collection
            assign image = block.settings.image | default: c.featured_image
            assign title = block.settings.title | default: c.title
            assign url = c.url | default: block.settings.link
            assign span = 'col-span-1 aspect-[3/4] lg:aspect-auto'
            if forloop.first
              assign span = 'col-span-2 aspect-[4/5] lg:col-span-2 lg:row-span-2 lg:aspect-auto'
            endif
          -%}
          <div class="category-card group relative overflow-hidden bg-surface {{ span }}" data-stagger-item {{ block.shopify_attributes }}>
            {%- if image -%}
              {{ image | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out-soft group-hover:scale-105', alt: '' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'absolute inset-0 h-full w-full' }}
            {%- endif -%}
            <span class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" aria-hidden="true"></span>
            <div class="absolute inset-x-0 bottom-0 flex flex-col gap-3 p-5 text-[#FAF8F5] md:p-7">
              <h3 class="display {% if forloop.first %}text-5xl md:text-7xl{% else %}text-3xl md:text-4xl{% endif %}">
                <a href="{{ url }}" class="after:absolute after:inset-0 after:content-['']">
                  {%- if forloop.first -%}{{ title | escape }}{%- else -%}<em>{{ title | escape }}</em>{%- endif -%}
                </a>
              </h3>
              {%- if block.settings.description != blank -%}
                <p class="max-w-[36ch] text-sm leading-relaxed text-[#FAF8F5]/85">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- assign sub = block.settings.menu -%}
              {%- if sub.links.size > 0 -%}
                <ul class="relative z-10 flex flex-wrap gap-x-5 gap-y-1" role="list">
                  {%- for link in sub.links limit: 4 -%}
                    <li><a class="spec link-underline text-[#FAF8F5]" href="{{ link.url }}">↗ {{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </nk-stagger>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Shop by category",
  "class": "category-cards-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)", "default": "wardrobe" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "link_list", "id": "menu", "label": "Sub-links", "info": "Optional menu shown as links on the card (up to 4)." },
        { "type": "url", "id": "link", "label": "Link (if no collection)" }
      ]
    }
  ],
  "presets": [
    { "name": "Shop by category", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
