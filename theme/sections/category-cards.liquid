{%- comment -%}
  Shop by category ("The wardrobe"): architectural studio category index where every garment image
  fits completely inside its studio frame (object-contain, never cropped), paired with index
  numbering, live product counts, and staggered entrance choreography (<nk-stagger>).
{%- endcomment -%}
{%- assign cards = section.blocks | where: 'type', 'category' -%}
{%- if cards.size > 0 -%}
  <div class="category-cards full-width section-spacing color-{{ section.settings.color_scheme }}">
    <div style="width: var(--content-width); margin-inline: auto;">
      <div class="section-head category-cards__head">
        <div class="flex flex-col gap-3">
          {%- if section.settings.eyebrow != blank -%}
            <nk-reveal mode="fade">
              <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
            </nk-reveal>
          {%- endif -%}
          {%- liquid
            assign heading_html = section.settings.heading | escape
            assign italic = section.settings.heading_italic | escape
          -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: 'cut', class: 'display' %}
        </div>
        {%- if section.settings.link != blank -%}
          <nk-reveal mode="fade" delay="0.12">
            <a class="button button--secondary category-cards__cta" href="{{ section.settings.link }}" data-magnetic>
              {{- section.settings.link_label | escape }} →
            </a>
          </nk-reveal>
        {%- endif -%}
      </div>

      <nk-stagger class="grid grid-cols-2 gap-4 md:gap-5 lg:grid-cols-5">
        {%- for block in cards -%}
          {%- liquid
            assign c = block.settings.collection
            assign image = block.settings.image | default: c.featured_image
            if image == blank and c != blank and c.products.first != blank
              assign image = c.products.first.featured_media
            endif
            assign title = block.settings.title | default: c.title
            assign url = c.url | default: block.settings.link
            assign idx = forloop.index | prepend: '0' | slice: -2, 2
          -%}
          <article class="category-card group relative flex flex-col border border-line bg-bg transition-colors duration-300 hover:border-text" data-stagger-item {{ block.shopify_attributes }}>
            <div class="flex items-center justify-between border-b border-line px-3.5 py-2.5">
              <span class="spec text-muted">{{ idx }}</span>
              {%- if c != blank and c.all_products_count > 0 -%}
                <span class="spec text-muted">{{ 'collection.product_count' | t: count: c.all_products_count }}</span>
              {%- else -%}
                <span class="spec text-muted">↗</span>
              {%- endif -%}
            </div>

            <a
              href="{{ url }}"
              class="category-card__media relative flex aspect-[4/5] w-full items-center justify-center overflow-hidden bg-white p-4 md:p-5"
              tabindex="-1"
              aria-hidden="true"
              data-cursor="view"
            >
              {%- if image -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(min-width: 990px) 20vw, 50vw',
                    class: 'max-h-full max-w-full h-full w-full object-contain transition-transform duration-500 ease-out-soft group-hover:scale-[1.02]',
                    alt: ''
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'h-full w-full object-contain' }}
              {%- endif -%}
            </a>

            <div class="flex flex-1 flex-col justify-between gap-2 border-t border-line p-4">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="display text-2xl md:text-[1.75rem]">
                  <a href="{{ url }}" class="after:absolute after:inset-0 after:content-['']">
                    <em>{{ title | escape }}</em>
                  </a>
                </h3>
                <span class="spec transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
              </div>
              {%- if block.settings.description != blank -%}
                <p class="text-xs leading-relaxed text-muted">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              {%- assign sub = block.settings.menu -%}
              {%- if sub.links.size > 0 -%}
                <ul class="relative z-10 flex flex-wrap gap-x-4 gap-y-1 pt-1" role="list">
                  {%- for link in sub.links limit: 4 -%}
                    <li><a class="spec link-underline" href="{{ link.url }}">↗ {{ link.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </nk-stagger>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .category-cards__head {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--nk-color-line);
  }
  .category-cards__cta {
    min-height: 46px;
    padding-inline: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by category",
  "class": "category-cards-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)", "default": "wardrobe" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
        { "type": "text", "id": "description", "label": "Description" },
        { "type": "link_list", "id": "menu", "label": "Sub-links", "info": "Optional menu shown as links on the card (up to 4)." },
        { "type": "url", "id": "link", "label": "Link (if no collection)" }
      ]
    }
  ],
  "presets": [
    { "name": "Shop by category", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }, { "type": "category" }] }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
