{%- comment -%}
  Statistics that count up once when scrolled into view. Layout from HyperUI marketing/stats #1; script in src/components/count-up.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="counter-band kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-card="{{ section.settings.card_style }}" data-align="{{ section.settings.alignment }}" data-size="{{ section.settings.value_size }}" data-label="{{ section.settings.label_position }}" data-divider="{{ section.settings.dividers }}" data-accent="{{ section.settings.accent_values }}" style="{% render 'section-presentation', presentation: section.settings %}--counter-cols:{{ section.settings.columns }};--counter-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="counter-band__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <dl class="counter-band__list">
      {%- for block in section.blocks -%}
        <div class="counter-band__stat kit-card"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <dt class="counter-band__label">{{ block.settings.label | escape }}</dt>
          <dd class="counter-band__value">
            <span class="visually-hidden">{{ block.settings.prefix | escape }}{{ block.settings.value | escape }}{{ block.settings.suffix | escape }}</span>
            <span aria-hidden="true">{{ block.settings.prefix | escape }}{%- if section.settings.animate -%}<nk-count-up duration="{{ section.settings.duration }}">{{ block.settings.value | escape }}</nk-count-up>{%- else -%}{{ block.settings.value | escape }}{%- endif -%}{{ block.settings.suffix | escape }}</span>
          </dd>
          {%- if block.settings.text != blank -%}<dd class="counter-band__text rte text-muted">{{ block.settings.text }}</dd>{%- endif -%}
        </div>
      {%- endfor -%}
    </dl>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.counter-band__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.counter-band__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--counter-gap, 16px); margin: 0; }
.counter-band__stat { display: flex; flex-direction: column; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
.counter-band[data-card='plain'] .counter-band__stat { padding-block: 20px; }
.counter-band__label { order: 2; font-size: 0.9375rem; color: var(--nk-color-text-muted); }
.counter-band[data-label='above'] .counter-band__label { order: 0; font-family: var(--nk-font-spec); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
.counter-band__value { order: 1; margin: 0; font-family: var(--nk-font-heading); font-size: clamp(2.25rem, 5vw, 4rem); line-height: 1.05; font-variant-numeric: tabular-nums; }
.counter-band__text { order: 3; margin: 0; font-size: 0.875rem; }
.counter-band[data-accent='true'] .counter-band__value { color: var(--nk-color-accent); }
.counter-band[data-size='small'] .counter-band__value { font-size: clamp(1.75rem, 3.5vw, 2.75rem); }
.counter-band[data-size='large'] .counter-band__value { font-size: clamp(3rem, 7vw, 6rem); }
.counter-band[data-divider='true'] .counter-band__stat + .counter-band__stat { border-inline-start: 1px solid var(--nk-color-line); padding-inline-start: var(--counter-gap, 16px); }
.counter-band[data-align='center'] .counter-band__stat { text-align: center; align-items: center; }
@media (max-width: 989px) { .counter-band[data-divider='true'] .counter-band__stat:nth-child(odd) { border-inline-start: 0; padding-inline-start: 0; } }
@media (min-width: 990px) { .counter-band__list { grid-template-columns: repeat(var(--counter-cols, 4), minmax(0, 1fr)); } }
{% endstylesheet %}

