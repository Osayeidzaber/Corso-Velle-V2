{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/page
{% endcomment %}

{%- liquid
  assign page_empty = false
  assign page_text = page.content | strip_html | strip
  if page_text == blank
    assign page_empty = true
    if page.content contains '<img' or page.content contains '<iframe' or page.content contains '<video'
      assign page_empty = false
    endif
  endif
-%}
<div class="section-spacing utility-page color-{{ section.settings.color_scheme }}"{% if page_empty %} data-empty{% endif %} data-width="{{ section.settings.width }}">
  {% if section.settings.show_title != false %}<div class="collection-header">
    <h1 class="display">{{ page.title | escape }}</h1>
  </div>{% endif %}

  {% unless page_empty %}<div class="rte">{{ page.content }}</div>{% endunless %}
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow reading width"
        },
        {
          "value": "regular",
          "label": "Regular reading width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ],
  "limit": 1,
  "enabled_on": {
    "templates": [
      "page"
    ]
  }
}
{% endschema %}
