{%- comment -%}
  Team or maker profiles with photo, role, short bio and social link. Adapted from HyperUI marketing/team-sections #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="team-grid kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-align="{{ section.settings.alignment }}" data-gray="{{ section.settings.grayscale }}" data-card="{{ section.settings.card_style }}" style="{% render 'section-presentation', presentation: section.settings %}--team-cols:{{ section.settings.columns }};--team-cols-mobile:{{ section.settings.columns_mobile }};--team-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="team-grid__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="team-grid__list" role="list">
      {%- for block in section.blocks -%}
        <li class="team-grid__member kit-card"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <div class="team-grid__media kit-media" data-ratio="{{ section.settings.image_ratio }}"{% if section.settings.hover_zoom %} data-zoom{% endif %}>{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '275, 400, 550, 720', sizes: '(min-width: 990px) 25vw, 50vw', class: 'team-grid__image' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'team-grid__image kit-placeholder' }}{%- endif -%}</div>
          <div class="team-grid__meta">
            <div>
              <h3 class="team-grid__name" id="TeamName-{{ block.id }}">{{ block.settings.name | escape }}</h3>
              {%- if block.settings.role != blank -%}<p class="text-muted">{{ block.settings.role | escape }}</p>{%- endif -%}
            </div>
            {%- if block.settings.link != blank -%}
              <a class="team-grid__social" href="{{ block.settings.link }}" target="_blank" rel="noopener" aria-labelledby="TeamName-{{ block.id }} TeamLink-{{ block.id }}"><span id="TeamLink-{{ block.id }}">{{ block.settings.link_label | default: 'Profile' | escape }}</span> <span aria-hidden="true">↗</span></a>
            {%- endif -%}
          </div>
          {%- if section.settings.show_bio and block.settings.bio != blank -%}<div class="rte text-muted team-grid__bio">{{ block.settings.bio }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.team-grid__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.team-grid__list { display: grid; grid-template-columns: repeat(var(--team-cols-mobile, 2), minmax(0, 1fr)); gap: var(--team-gap, 24px); list-style: none; margin: 0; padding: 0; }
.team-grid__member { display: grid; gap: 12px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
.team-grid__media { background: var(--nk-color-surface); }
.team-grid[data-gray='true'] .team-grid__media img { filter: grayscale(1); }
.team-grid[data-gray='true'] .team-grid__member:hover .team-grid__media img { filter: none; }
.nk-anim .team-grid__media img { transition: filter 0.4s var(--nk-ease-out), scale 0.6s var(--nk-ease-out); }
.team-grid__meta { display: flex; justify-content: space-between; align-items: start; gap: 12px; }
.team-grid__meta p { margin: 2px 0 0; font-size: 0.875rem; }
.team-grid__name { font-size: 1.125rem; }
.team-grid__social { font-size: 0.8125rem; font-weight: 600; white-space: nowrap; }
.team-grid__bio { font-size: 0.9375rem; }
.team-grid[data-align='center'] .team-grid__member { text-align: center; }
.team-grid[data-align='center'] .team-grid__meta { flex-direction: column; align-items: center; }
@media (min-width: 990px) { .team-grid__list { grid-template-columns: repeat(var(--team-cols, 3), minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Team",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The people behind the label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (phones)",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between people",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Profile style",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "surface",
          "label": "Surface fill"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "shadow",
          "label": "Soft shadow"
        }
      ],
      "default": "plain"
    },
    {
      "type": "checkbox",
      "id": "show_bio",
      "label": "Show bios",
      "default": true
    },
    {
      "type": "header",
      "content": "Photos"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Photo ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "tall",
          "label": "Tall (2:3)"
        },
        {
          "value": "landscape",
          "label": "Landscape (3:2)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Black and white until hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Zoom photos on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "theme",
      "info": "Applies to images, cards and buttons in this section."
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Theme default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in section"
        },
        {
          "value": "stagger",
          "label": "Items rise one by one"
        }
      ],
      "default": "none",
      "info": "Skipped when visitors prefer reduced motion or motion is off in Theme settings."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "Team member",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Head of design"
        },
        {
          "type": "richtext",
          "id": "bio",
          "label": "Short bio"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Profile link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Instagram"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Team",
      "blocks": [
        {
          "type": "member"
        },
        {
          "type": "member",
          "settings": {
            "role": "Pattern cutter"
          }
        },
        {
          "type": "member",
          "settings": {
            "role": "Studio manager"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
