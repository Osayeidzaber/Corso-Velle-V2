{%- comment -%}
  Plans / service tiers (alterations, memberships, styling) with a featured card. Adapted from HyperUI marketing/pricing #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="pricing-cards kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-align="{{ section.settings.alignment }}" data-card="{{ section.settings.card_style }}" data-featured="{{ section.settings.featured_style }}" style="{% render 'section-presentation', presentation: section.settings %}--pricing-cols:{{ section.settings.columns }};--pricing-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="pricing-cards__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="pricing-cards__list" role="list">
      {%- for block in section.blocks -%}
        <li class="pricing-cards__plan kit-card{% if block.settings.featured %} is-featured{% endif %}"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.featured and block.settings.badge != blank -%}<p class="pricing-cards__badge spec">{{ block.settings.badge | escape }}</p>{%- endif -%}
          <h3 class="pricing-cards__name">{{ block.settings.name | escape }}</h3>
          <p class="pricing-cards__price">{%- if block.settings.compare_price != blank -%}<s class="text-muted">{{ block.settings.compare_price | escape }}</s>{%- endif -%}<strong>{{ block.settings.price | escape }}</strong>{%- if block.settings.period != blank -%}<span class="text-muted">{{ block.settings.period | escape }}</span>{%- endif -%}</p>
          {%- if block.settings.description != blank -%}<div class="rte text-muted">{{ block.settings.description }}</div>{%- endif -%}
          {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
          {%- if block.settings.features != blank -%}
            <ul class="pricing-cards__features" role="list">
              {%- for feature in features -%}{%- assign line = feature | strip -%}{%- if line != blank -%}<li>{% render 'section-icon', name: 'check' %}<span>{{ line | escape }}</span></li>{%- endif -%}{%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            {%- assign plan_style = block.settings.button_style -%}
            {%- if plan_style == 'auto' -%}{%- assign plan_style = 'outline' -%}{%- if block.settings.featured -%}{%- assign plan_style = 'solid' -%}{%- endif -%}{%- endif -%}
            <div class="pricing-cards__cta">{% render 'nk-button', label: block.settings.button_label, link: block.settings.button_link, style: plan_style %}</div>
          {%- endif -%}
          {%- if block.settings.footnote != blank -%}<p class="pricing-cards__footnote text-muted">{{ block.settings.footnote | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.pricing-cards__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.pricing-cards__list { display: grid; gap: var(--pricing-gap, 16px); list-style: none; margin: 0; padding: 0; align-items: stretch; }
.pricing-cards__plan { display: flex; flex-direction: column; gap: 14px; min-width: 0; overflow-wrap: anywhere; }
.pricing-cards[data-card='plain'] .pricing-cards__plan { padding: clamp(20px, 3vw, 32px) 0; }
.pricing-cards[data-featured='ring'] .pricing-cards__plan.is-featured { box-shadow: inset 0 0 0 2px var(--nk-color-text); }
/* Swap tokens through parent-level copies so the featured card can invert without a custom-property cycle. */
.pricing-cards__list { --pricing-inv-fg: var(--nk-color-bg); --pricing-inv-bg: var(--nk-color-text); }
.pricing-cards[data-featured='inverted'] .pricing-cards__plan.is-featured { --nk-color-text: var(--pricing-inv-fg); --nk-color-bg: var(--pricing-inv-bg); --nk-color-line: transparent; --nk-color-surface: var(--pricing-inv-bg); background: var(--nk-color-bg); color: var(--nk-color-text); }
.pricing-cards[data-featured='inverted'] .pricing-cards__plan.is-featured .text-muted { color: inherit; opacity: 0.75; }
.pricing-cards[data-featured='accent'] .pricing-cards__plan.is-featured { box-shadow: inset 0 0 0 2px var(--nk-color-accent); }
.pricing-cards__badge { align-self: flex-start; margin: 0; padding: 4px 10px; background: var(--nk-color-text); color: var(--nk-color-bg); border-radius: var(--nk-button-radius, 0); }
.pricing-cards[data-featured='accent'] .pricing-cards__badge { background: var(--nk-color-accent); }
.pricing-cards[data-featured='inverted'] .is-featured .pricing-cards__badge { background: var(--nk-color-accent); color: #fff; }
.pricing-cards__name { font-size: 1.125rem; }
.pricing-cards__price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 0; }
.pricing-cards__price strong { font-family: var(--nk-font-heading); font-size: clamp(2rem, 4vw, 2.75rem); font-weight: 400; }
.pricing-cards__features { display: grid; gap: 8px; list-style: none; margin: 0; padding: 0; }
.pricing-cards__features li { display: flex; gap: 8px; align-items: start; text-align: start; }
.pricing-cards__features svg { flex: none; width: 20px; height: 20px; color: var(--nk-color-accent); }
.pricing-cards__cta { margin-top: auto; padding-top: 8px; width: 100%; }
.pricing-cards__cta .nk-btn { width: 100%; }
.pricing-cards__footnote { margin: 0; font-size: 0.8125rem; }
.pricing-cards[data-align='center'] .pricing-cards__plan { text-align: center; align-items: center; }
.pricing-cards[data-align='center'] .pricing-cards__price { justify-content: center; }
@media (min-width: 750px) { .pricing-cards__list { grid-template-columns: repeat(min(2, var(--pricing-cols, 3)), minmax(0, 1fr)); } }
@media (min-width: 990px) { .pricing-cards__list { grid-template-columns: repeat(var(--pricing-cols, 3), minmax(0, 1fr)); } }
{% endstylesheet %}

