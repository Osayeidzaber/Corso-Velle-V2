{%- comment -%}
  Numbered or icon how-it-works steps joined by a line. Adapted from daisyUI steps and HyperUI application/steps.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="process-steps kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-layout="{{ section.settings.layout }}" data-align="{{ section.settings.alignment }}" data-marker="{{ section.settings.marker_style }}" data-connector="{{ section.settings.connector }}" data-card="{{ section.settings.card_style }}" style="{% render 'section-presentation', presentation: section.settings %}--steps-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="process-steps__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ol class="process-steps__list">
      {%- for block in section.blocks -%}
        <li class="process-steps__step"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <span class="process-steps__count" aria-hidden="true">
            {%- if section.settings.marker_content == 'icon' and block.settings.icon != 'none' -%}{% render 'section-icon', name: block.settings.icon %}{%- else -%}{{ forloop.index }}{%- endif -%}
          </span>
          <div class="process-steps__copy kit-card">
            <h3 class="process-steps__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button_label != blank -%}<div class="kit-buttons process-steps__footer">{% render 'nk-button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}</div>{%- endif -%}
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.process-steps__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 36px; }
.process-steps__list { display: grid; gap: var(--steps-gap, 28px); list-style: none; margin: 0; padding: 0; }
.process-steps__step { position: relative; display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 16px; min-width: 0; overflow-wrap: anywhere; }
.process-steps__step:not(:last-child)::after { content: ''; position: absolute; top: 48px; bottom: calc(var(--steps-gap, 28px) * -1 + 4px); inset-inline-start: 21px; width: 2px; background: var(--nk-color-line); }
.process-steps[data-connector='false'] .process-steps__step::after { content: none; }
.process-steps__count { position: relative; z-index: 1; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--nk-color-text); color: var(--nk-color-bg); font-family: var(--nk-font-spec); font-weight: 700; }
.process-steps__count svg { width: 22px; height: 22px; }
.process-steps[data-marker='outline'] .process-steps__count { background: var(--nk-color-bg); color: var(--nk-color-text); box-shadow: inset 0 0 0 2px var(--nk-color-text); }
.process-steps[data-marker='accent'] .process-steps__count { background: var(--nk-color-accent); color: var(--nk-color-bg); }
.process-steps[data-marker='square'] .process-steps__count { border-radius: var(--kit-radius); }
.process-steps__copy { display: grid; gap: 6px; align-content: start; }
.process-steps[data-card='plain'] .process-steps__copy { padding-top: 10px; }
.process-steps__title { font-size: 1.125rem; }
.process-steps[data-align='center'] .process-steps__footer { justify-content: center; }
@media (min-width: 990px) {
  .process-steps[data-layout='horizontal'] .process-steps__list { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); }
  .process-steps[data-layout='horizontal'] .process-steps__step { grid-template-columns: minmax(0, 1fr); align-content: start; }
  .process-steps[data-layout='horizontal'] .process-steps__step:not(:last-child)::after { top: 21px; bottom: auto; inset-inline: 56px calc(var(--steps-gap, 28px) * -1 + 12px); width: auto; height: 2px; }
  .process-steps[data-layout='horizontal'][data-align='center'] .process-steps__step { justify-items: center; text-align: center; }
  .process-steps[data-layout='horizontal'][data-align='center'] .process-steps__step:not(:last-child)::after { inset-inline: calc(50% + 32px) calc(-50% - var(--steps-gap, 28px) + 32px); }
}
{% endstylesheet %}

