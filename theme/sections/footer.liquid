{%- comment -%}
  Footer (master-plan/10 CS-08). Menu columns are disclosures on phones and plain columns on
  desktop. Social links, policies and payment icons come from store configuration; anything
  without a destination is omitted.
{%- endcomment -%}
<footer class="footer color-{{ section.settings.color_scheme }} full-width"{% if section.settings.reveal %} data-reveal{% endif %}>
  <div class="footer__inner" style="width: var(--content-width); margin-inline: auto;">
    <div class="footer__columns">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="footer__brand" {{ block.shopify_attributes }}>
              <p class="header__logo">
                {%- if settings.logo -%}
                  {{ settings.logo | image_url: width: 600 | image_tag: loading: 'lazy', alt: shop.name }}
                {%- else -%}
                  {{ shop.name | escape }}
                {%- endif -%}
              </p>
              {%- if block.settings.text != blank -%}
                <div class="text-muted">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          {%- when 'menu' -%}
            {%- assign footer_menu = block.settings.menu -%}
            {%- if footer_menu.links.size > 0 -%}
              <nav class="footer__menu" aria-label="{{ footer_menu.title | escape }}" {{ block.shopify_attributes }}>
                <nk-disclosure>
                  <details class="disclosure" open>
                    <summary>{{ block.settings.heading | default: footer_menu.title | escape }}</summary>
                    <ul role="list" class="disclosure__content">
                      {%- for link in footer_menu.links -%}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                      {%- endfor -%}
                    </ul>
                  </details>
                </nk-disclosure>
              </nav>
            {%- endif -%}
          {%- when 'social' -%}
            {%- liquid
              assign socials = ''
              if settings.social_instagram != blank
                assign socials = socials | append: 'instagram,'
              endif
              if settings.social_tiktok != blank
                assign socials = socials | append: 'tiktok,'
              endif
              if settings.social_facebook != blank
                assign socials = socials | append: 'facebook,'
              endif
              if settings.social_youtube != blank
                assign socials = socials | append: 'youtube,'
              endif
            -%}
            {%- if socials != '' -%}
              <div class="footer__menu" {{ block.shopify_attributes }}>
                <p class="spec">{{ 'footer.follow' | t }}</p>
                <ul role="list">
                  {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener">Instagram</a></li>{%- endif -%}
                  {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener">TikTok</a></li>{%- endif -%}
                  {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" rel="noopener">Facebook</a></li>{%- endif -%}
                  {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener">YouTube</a></li>{%- endif -%}
                </ul>
              </div>
            {%- elsif request.design_mode -%}
              <p class="text-muted" {{ block.shopify_attributes }}>{{ 'footer.social_setup' | t }}</p>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}</p>
      {%- if shop.policies.size > 0 -%}
        <ul class="footer__payments" role="list">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "reveal", "label": "Reveal footer on scroll (desktop)", "default": false, "info": "Page content scrolls away to uncover the footer. Desktop only." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Social links",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Add your profile links in Theme settings › Social media." }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
