{%- comment -%}
  Split hero: image on one half, copy and buttons on the other. Adapted from HyperUI CTA #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="hero-split kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-image="{{ section.settings.image_position }}" data-split="{{ section.settings.split }}" data-height="{{ section.settings.height }}" data-align="{{ section.settings.alignment }}" data-valign="{{ section.settings.vertical_alignment }}" data-panel="{{ section.settings.panel }}" data-fit="{{ section.settings.image_fit }}" data-mobile="{{ section.settings.mobile_order }}" style="{% render 'section-presentation', presentation: section.settings %}--hero-split-mobile-height:{{ section.settings.mobile_image_height }}vw;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="hero-split__inner">
    <div class="hero-split__media">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{%- endif -%}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 750px) 50vw, 100vw', class: 'hero-split__image' }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-split__image kit-placeholder' }}
      {%- endif -%}
    </div>
    <div class="hero-split__content">
      {%- if section.settings.eyebrow != blank -%}<p class="kit-caption" data-style="{{ section.settings.eyebrow_style }}">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="kit-display kit-display--{{ section.settings.heading_display }}{% if section.settings.heading_italic %} kit-italic{% endif %}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte kit-text" data-size="{{ section.settings.text_size }}">{{ section.settings.text }}</div>{%- endif -%}
      {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
      {%- if button_blocks.size > 0 -%}
        <div class="kit-buttons">
          {%- for block in button_blocks -%}<div {{ block.shopify_attributes }}>{% render 'nk-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, new_tab: block.settings.new_tab %}</div>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.hero-split__inner { width: var(--content-width); margin-inline: auto; display: grid; overflow: hidden; border-radius: var(--kit-radius); }
.hero-split[data-panel='surface'] .hero-split__inner { background: var(--nk-color-surface); }
.hero-split[data-panel='outline'] .hero-split__inner { border: 1px solid var(--nk-color-line); }
.hero-split__media { position: relative; min-height: var(--hero-split-mobile-height, 90vw); background: var(--nk-color-surface); }
.hero-split__media picture { display: contents; }
.hero-split__image, .hero-split__media .kit-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hero-split[data-fit='contain'] .hero-split__image { object-fit: contain; }
.hero-split__content { display: grid; gap: 20px; align-content: center; padding: clamp(28px, 6vw, 96px); min-width: 0; overflow-wrap: anywhere; }
.hero-split[data-panel='none'] .hero-split__content { padding-inline: clamp(0px, 4vw, 72px); }
.hero-split[data-valign='top'] .hero-split__content { align-content: start; }
.hero-split[data-valign='bottom'] .hero-split__content { align-content: end; }
.hero-split[data-align='center'] .hero-split__content { text-align: center; justify-items: center; }
.hero-split[data-align='center'] .kit-buttons { justify-content: center; }
.hero-split[data-mobile='text_first'] .hero-split__media { order: 2; }
@media (min-width: 750px) {
  .hero-split__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .hero-split .hero-split__media { min-height: 420px; order: 0; }
  .hero-split[data-split='image'] .hero-split__inner { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .hero-split[data-split='text'] .hero-split__inner { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .hero-split[data-image='right'] .hero-split__media { order: 2; }
  .hero-split[data-image='right'][data-split='image'] .hero-split__inner { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  .hero-split[data-image='right'][data-split='text'] .hero-split__inner { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
  .hero-split[data-height='medium'] .hero-split__inner { min-height: 60svh; }
  .hero-split[data-height='large'] .hero-split__inner { min-height: 85svh; }
  .hero-split[data-height='full'] .hero-split__inner { min-height: calc(100svh - var(--header-height, 0px)); }
}
{% endstylesheet %}

