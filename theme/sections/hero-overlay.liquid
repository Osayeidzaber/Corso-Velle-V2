{%- comment -%}
  Image banner with text over the image. Adapted from Shopify Dawn sections/image-banner.liquid.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="hero-overlay kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-height="{{ section.settings.height }}" data-mobile-height="{{ section.settings.mobile_height }}" data-position="{{ section.settings.content_position }}" data-mobile-position="{{ section.settings.mobile_position }}" data-align="{{ section.settings.alignment }}" data-tone="{{ section.settings.text_tone }}" data-overlay="{{ section.settings.overlay_style }}" data-box="{{ section.settings.content_box }}" style="{% render 'section-presentation', presentation: section.settings %}--hero-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--hero-overlay-width:{{ section.settings.content_max_width }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="hero-overlay__inner">
    <div class="hero-overlay__media">
      {%- if section.settings.image != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{%- endif -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', class: 'hero-overlay__image' }}
        </picture>
      {%- else -%}
        {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero-overlay__image kit-placeholder' }}
      {%- endif -%}
    </div>
    <div class="hero-overlay__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}<p class="kit-caption" data-style="{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }}</p>
          {%- when 'heading' -%}<h2 class="kit-display kit-display--{{ block.settings.size }}{% if block.settings.italic %} kit-italic{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}<div class="rte kit-text" data-size="{{ block.settings.size }}" data-color="{{ block.settings.color }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'spacer' -%}<div class="kit-spacer" style="height:{{ block.settings.height }}px;" aria-hidden="true" {{ block.shopify_attributes }}></div>
          {%- when 'button' -%}<div class="kit-buttons" {{ block.shopify_attributes }}>{% render 'nk-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, new_tab: block.settings.new_tab %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.hero-overlay__inner { position: relative; width: var(--content-width); margin-inline: auto; display: grid; min-height: 100vw; overflow: hidden; isolation: isolate; border-radius: var(--kit-radius); }
.hero-overlay[data-mobile-height='small'] .hero-overlay__inner { min-height: 70vw; }
.hero-overlay[data-mobile-height='large'] .hero-overlay__inner { min-height: 130vw; }
.hero-overlay[data-mobile-height='full'] .hero-overlay__inner { min-height: calc(100svh - var(--header-height, 0px)); }
.hero-overlay[data-tone='light'] .hero-overlay__inner { color: #fff; --nk-color-text: #fff; --nk-color-bg: #111; --nk-color-text-muted: rgb(255 255 255 / 0.82); }
.hero-overlay[data-tone='dark'] .hero-overlay__inner { color: #111; --nk-color-text: #111; --nk-color-bg: #fff; --nk-color-text-muted: rgb(17 17 17 / 0.72); }
.hero-overlay__media { position: absolute; inset: 0; z-index: -1; }
.hero-overlay__media picture { display: contents; }
.hero-overlay__media::after { content: ''; position: absolute; inset: 0; background: #000; opacity: var(--hero-overlay-opacity, 0.3); }
.hero-overlay[data-tone='dark'] .hero-overlay__media::after { background: #fff; }
.hero-overlay[data-overlay='bottom'] .hero-overlay__media::after { background: linear-gradient(to top, #000, transparent 75%); opacity: min(1, calc(var(--hero-overlay-opacity, 0.3) * 2)); }
.hero-overlay[data-overlay='side'] .hero-overlay__media::after { background: linear-gradient(to right, #000, transparent 70%); opacity: min(1, calc(var(--hero-overlay-opacity, 0.3) * 2)); }
.hero-overlay[data-tone='dark'][data-overlay='bottom'] .hero-overlay__media::after { background: linear-gradient(to top, #fff, transparent 75%); }
.hero-overlay[data-tone='dark'][data-overlay='side'] .hero-overlay__media::after { background: linear-gradient(to right, #fff, transparent 70%); }
.hero-overlay__image { width: 100%; height: 100%; object-fit: cover; }
.hero-overlay__content { display: grid; gap: 16px; align-self: end; justify-self: start; width: min(calc(100% - 32px), var(--hero-overlay-width, 720px)); margin: clamp(16px, 4vw, 64px); min-width: 0; overflow-wrap: anywhere; }
.hero-overlay[data-box='solid'] .hero-overlay__content { padding: clamp(20px, 3vw, 40px); background: var(--nk-color-bg); color: var(--nk-color-text); border-radius: var(--kit-radius); --nk-color-text: currentColor; }
.hero-overlay[data-tone='light'][data-box='solid'] .hero-overlay__content { background: #fff; color: #111; --nk-color-text: #111; --nk-color-bg: #fff; --nk-color-text-muted: rgb(17 17 17 / 0.7); }
.hero-overlay[data-tone='dark'][data-box='solid'] .hero-overlay__content { background: #111; color: #fff; --nk-color-text: #fff; --nk-color-bg: #111; --nk-color-text-muted: rgb(255 255 255 / 0.8); }
.hero-overlay[data-box='blur'] .hero-overlay__content { padding: clamp(20px, 3vw, 40px); background: rgb(0 0 0 / 0.25); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-radius: var(--kit-radius); }
.hero-overlay[data-tone='dark'][data-box='blur'] .hero-overlay__content { background: rgb(255 255 255 / 0.45); }
.hero-overlay[data-mobile-position='top'] .hero-overlay__content { align-self: start; }
.hero-overlay[data-mobile-position='middle'] .hero-overlay__content { align-self: center; }
.hero-overlay[data-align='center'] .hero-overlay__content { text-align: center; justify-items: center; }
.hero-overlay[data-align='center'] .kit-buttons { justify-content: center; }
@media (min-width: 750px) {
  .hero-overlay .hero-overlay__inner { min-height: 420px; }
  .hero-overlay[data-height='medium'] .hero-overlay__inner { min-height: 60svh; }
  .hero-overlay[data-height='large'] .hero-overlay__inner { min-height: 80svh; }
  .hero-overlay[data-height='full'] .hero-overlay__inner { min-height: calc(100svh - var(--header-height, 0px)); }
  .hero-overlay .hero-overlay__content { align-self: end; }
  .hero-overlay[data-position^='top'] .hero-overlay__content { align-self: start; }
  .hero-overlay[data-position^='middle'] .hero-overlay__content { align-self: center; }
  .hero-overlay[data-position$='center'] .hero-overlay__content { justify-self: center; }
  .hero-overlay[data-position$='right'] .hero-overlay__content { justify-self: end; }
}
{% endstylesheet %}

