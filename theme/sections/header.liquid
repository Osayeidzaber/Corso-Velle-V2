{%- comment -%}
  Header (master-plan/06 N-01, N-03, N-04).
  - Desktop parents: the title is a real link; a separate <details> disclosure opens its panel.
  - Phone: menu button opens <nk-nav-drawer> (dialog with level panels). Without JS the button
    is not shown and the desktop nav wraps, so every link stays reachable.
  - <shopify-account> renders in the header on desktop and phone when accounts are enabled.
{%- endcomment -%}
{%- liquid
  assign menu = section.settings.menu
  assign is_home = false
  if template.name == 'index'
    assign is_home = true
  endif
-%}

<nk-header
  class="color-{{ section.settings.color_scheme }} full-width"
  data-sticky="{{ section.settings.sticky }}"
  {% if section.settings.overlay_home and is_home %}
    data-overlay data-surface="overlay"
  {% endif %}
>
  <div class="header header--{{ section.settings.layout }}">
    <div class="header__start">
      <button
        type="button"
        class="icon-button header__menu-button"
        data-nk-open="MenuDrawer"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="MenuDrawer"
        aria-label="{{ 'header.menu' | t }}"
      >
        {% render 'icon', name: 'menu' %}
      </button>
      <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'header.search' | t }}">
        {% render 'icon', name: 'search' %}
      </a>

      {%- if menu.links.size > 0 -%}
        <nav class="header__nav" aria-label="{{ 'header.primary_navigation' | t }}">
          <ul class="nav" role="list">
            {%- for link in menu.links -%}
              <li class="nav__item">
                <a class="nav__link" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>
                  {{- link.title | escape -}}
                </a>
                {%- if link.links.size > 0 -%}
                  <details class="nav__disclosure">
                    <summary aria-label="{{ 'header.show_submenu' | t: title: link.title }}">
                      {% render 'icon', name: 'chevron-down', size: 12 %}
                    </summary>
                    <div class="nav__panel">
                      {%- assign has_grandchildren = false -%}
                      {%- for child in link.links -%}
                        {%- if child.links.size > 0 -%}{%- assign has_grandchildren = true -%}{%- endif -%}
                      {%- endfor -%}
                      {%- if has_grandchildren -%}
                        {%- for child in link.links -%}
                          <div>
                            <a class="spec" href="{{ child.url }}">{{ child.title | escape }}</a>
                            {%- if child.links.size > 0 -%}
                              <ul role="list">
                                {%- for grandchild in child.links -%}
                                  <li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>
                                {%- endfor -%}
                              </ul>
                            {%- endif -%}
                          </div>
                        {%- endfor -%}
                      {%- else -%}
                        <ul role="list">
                          {%- for child in link.links -%}
                            <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                      {%- for block in section.blocks -%}
                        {%- if block.type == 'promo' and block.settings.menu_item == link.title -%}
                          {% render 'menu-promo', block: block %}
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo -%}
        {%- assign logo_alt = settings.logo.alt | default: shop.name -%}
        {{ settings.logo | image_url: width: 600 | image_tag: alt: logo_alt, loading: 'eager', sizes: '(min-width: 990px) 300px, 200px' }}
      {%- else -%}
        {{ shop.name | escape }}
      {%- endif -%}
    </a>

    <div class="header__end">
      {%- if shop.customer_accounts_enabled -%}
        <span class="header__account">
          <shopify-account menu="{{ section.settings.customer_account_menu }}">
            {% render 'icon', name: 'account' %}
          </shopify-account>
        </span>
      {%- endif -%}
      <a
        class="icon-button header__cart"
        href="{{ routes.cart_url }}"
        data-nk-open="CartDrawer"
        aria-haspopup="dialog"
        aria-expanded="false"
        data-cart-count-label="{{ 'header.cart_count' | t: count: '[count]' | escape }}"
        aria-label="{{ 'header.cart_count' | t: count: cart.item_count }}"
      >
        {% render 'icon', name: 'cart' %}
        <span class="header__cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
          {{- cart.item_count -}}
        </span>
      </a>
    </div>
  </div>
</nk-header>

{% render 'nav-drawer', menu: menu, section: section %}

{% schema %}
{
  "name": "Header",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "link_list", "id": "customer_account_menu", "label": "Customer account menu", "default": "customer-account-main-menu" },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        { "value": "center", "label": "Logo centered" },
        { "value": "left", "label": "Logo left" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "sticky",
      "label": "Sticky header",
      "options": [
        { "value": "off", "label": "Off" },
        { "value": "always", "label": "Always visible" },
        { "value": "reveal", "label": "Show when scrolling up" }
      ],
      "default": "reveal"
    },
    { "type": "checkbox", "id": "overlay_home", "label": "Overlay the homepage hero", "default": false, "info": "Only applies when the first homepage section supports overlay (for example the campaign hero)." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "promo",
      "name": "Menu promo card",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "menu_item", "label": "Show under menu item", "info": "Type the exact title of a top-level menu item." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Campaign" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
