{%- comment -%}
  Email signup over a background image. Adapted from Shopify Dawn sections/email-signup-banner.liquid; uses snippets/newsletter-form.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="newsletter-banner kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-height="{{ section.settings.height }}" data-align="{{ section.settings.alignment }}" data-position="{{ section.settings.content_position }}" data-tone="{{ section.settings.text_tone }}" data-box="{{ section.settings.content_box }}" data-has-image="{% if section.settings.image != blank %}true{% else %}false{% endif %}" data-form="{{ section.settings.form_style }}" data-form-button="{{ section.settings.form_button }}" data-privacy="{{ section.settings.show_privacy }}" style="{% render 'section-presentation', presentation: section.settings %}--newsletter-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--kit-form-width:{{ section.settings.form_width }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="newsletter-banner__inner">
    {%- if section.settings.image != blank -%}
      <div class="newsletter-banner__media">
        <picture>
          {%- if section.settings.image_mobile != blank -%}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{%- endif -%}
          {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', class: 'newsletter-banner__image', alt: '' }}
        </picture>
      </div>
    {%- endif -%}
    <div class="newsletter-banner__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}<p class="kit-caption" data-style="{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }}</p>
          {%- when 'heading' -%}<h2 class="kit-display kit-display--{{ block.settings.size }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'paragraph' -%}<div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'email_form' -%}<div class="newsletter-banner__form kit-form" {{ block.shopify_attributes }}>{%- assign form_id = 'NewsletterBanner-' | append: section.id -%}{% render 'newsletter-form', id: form_id, class: 'newsletter-form' %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.newsletter-banner__inner { position: relative; width: var(--content-width); margin-inline: auto; display: grid; place-items: center; min-height: 320px; overflow: hidden; isolation: isolate; border-radius: var(--kit-radius); }
.newsletter-banner[data-has-image='false'] .newsletter-banner__inner { background: var(--nk-color-surface); }
.newsletter-banner[data-height='medium'] .newsletter-banner__inner { min-height: 50svh; }
.newsletter-banner[data-height='large'] .newsletter-banner__inner { min-height: 75svh; }
.newsletter-banner[data-has-image='true'][data-tone='light'] .newsletter-banner__inner { color: #fff; --nk-color-text: #fff; --nk-color-bg: #111; --nk-color-text-muted: rgb(255 255 255 / 0.8); }
.newsletter-banner[data-has-image='true'][data-tone='dark'] .newsletter-banner__inner { color: #111; --nk-color-text: #111; --nk-color-bg: #fff; --nk-color-text-muted: rgb(17 17 17 / 0.7); }
.newsletter-banner__media { position: absolute; inset: 0; z-index: -1; }
.newsletter-banner__media picture { display: contents; }
.newsletter-banner__media::after { content: ''; position: absolute; inset: 0; background: #000; opacity: var(--newsletter-overlay, 0.35); }
.newsletter-banner[data-tone='dark'] .newsletter-banner__media::after { background: #fff; }
.newsletter-banner__image { width: 100%; height: 100%; object-fit: cover; }
.newsletter-banner__content { display: grid; gap: 16px; width: min(100%, 38rem); padding: clamp(24px, 5vw, 64px); min-width: 0; overflow-wrap: anywhere; }
.newsletter-banner[data-box='panel'] .newsletter-banner__content { margin: clamp(16px, 4vw, 48px); width: min(calc(100% - 32px), 38rem); background: var(--nk-color-bg); color: var(--nk-color-text); border-radius: var(--kit-radius); }
.newsletter-banner[data-has-image='true'][data-tone='light'][data-box='panel'] .newsletter-banner__content { background: #fff; color: #111; --nk-color-text: #111; --nk-color-bg: #fff; --nk-color-text-muted: rgb(17 17 17 / 0.7); }
.newsletter-banner[data-box='blur'] .newsletter-banner__content { margin: clamp(16px, 4vw, 48px); width: min(calc(100% - 32px), 38rem); background: rgb(0 0 0 / 0.25); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); border-radius: var(--kit-radius); }
.newsletter-banner[data-tone='dark'][data-box='blur'] .newsletter-banner__content { background: rgb(255 255 255 / 0.45); }
.newsletter-banner[data-align='center'] .newsletter-banner__content { text-align: center; justify-items: center; }
.newsletter-banner[data-position='left'] .newsletter-banner__inner { place-items: center start; }
.newsletter-banner[data-position='right'] .newsletter-banner__inner { place-items: center end; }
{% endstylesheet %}

