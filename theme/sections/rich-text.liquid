{%- comment -%}
  Centered or offset editorial text. Adapted from Shopify Dawn sections/rich-text.liquid.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="rich-text kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-position="{{ section.settings.position }}" data-align="{{ section.settings.alignment }}" data-card="{{ section.settings.card_style }}" style="{% render 'section-presentation', presentation: section.settings %}--rich-text-width:{{ section.settings.max_width }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="rich-text__inner">
    <div class="rich-text__blocks kit-card">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'caption' -%}<p class="kit-caption" data-style="{{ block.settings.style }}" {{ block.shopify_attributes }}>{{ block.settings.caption | escape }}</p>
          {%- when 'heading' -%}<h2 class="kit-display kit-display--{{ block.settings.size }}{% if block.settings.italic %} kit-italic{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>
          {%- when 'text' -%}<div class="rte kit-text" data-size="{{ block.settings.size }}" data-color="{{ block.settings.color }}" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'spacer' -%}<div class="kit-spacer" style="height:{{ block.settings.height }}px;" aria-hidden="true" {{ block.shopify_attributes }}></div>
          {%- when 'button' -%}<div class="kit-buttons" {{ block.shopify_attributes }}>{% render 'nk-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, new_tab: block.settings.new_tab %}</div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.rich-text__inner { width: var(--content-width); margin-inline: auto; display: flex; }
.rich-text__blocks { display: grid; gap: 18px; width: min(100%, var(--rich-text-width, 720px)); min-width: 0; overflow-wrap: anywhere; }
.rich-text[data-position='center'] .rich-text__inner { justify-content: center; }
.rich-text[data-position='right'] .rich-text__inner { justify-content: flex-end; }
.rich-text[data-align='center'] .rich-text__blocks { text-align: center; justify-items: center; }
.rich-text[data-align='center'] .kit-buttons { justify-content: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "Content position (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 400,
      "max": 1200,
      "step": 40,
      "unit": "px",
      "default": 720
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Background panel",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "surface",
          "label": "Surface fill"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "shadow",
          "label": "Soft shadow"
        }
      ],
      "default": "plain"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "theme",
      "info": "Applies to images, cards and buttons in this section."
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Theme default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in section"
        },
        {
          "value": "stagger",
          "label": "Items rise one by one"
        }
      ],
      "default": "none",
      "info": "Skipped when visitors prefer reduced motion or motion is off in Theme settings."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "caption",
      "name": "Caption",
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "New season"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "spec",
              "label": "Small caps"
            },
            {
              "value": "badge",
              "label": "Badge"
            },
            {
              "value": "plain",
              "label": "Plain text"
            }
          ],
          "default": "spec"
        }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Talk about your brand"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "xlarge",
              "label": "Extra large"
            }
          ],
          "default": "medium"
        },
        {
          "type": "checkbox",
          "id": "italic",
          "label": "Italic",
          "default": false
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Pair large imagery with a short story about the collection, the fabric or the fit.</p>"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Text size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Text color",
          "options": [
            {
              "value": "default",
              "label": "Default"
            },
            {
              "value": "muted",
              "label": "Muted"
            }
          ],
          "default": "default"
        }
      ]
    },
    {
      "type": "spacer",
      "name": "Spacer",
      "settings": [
        {
          "type": "range",
          "id": "height",
          "label": "Height",
          "min": 0,
          "max": 80,
          "step": 4,
          "unit": "px",
          "default": 16
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "default": "/collections/all"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            {
              "value": "solid",
              "label": "Solid"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "pill",
              "label": "Pill"
            },
            {
              "value": "sweep",
              "label": "Center sweep"
            },
            {
              "value": "offset",
              "label": "Offset shadow"
            },
            {
              "value": "press",
              "label": "3D press"
            },
            {
              "value": "link",
              "label": "Text link"
            }
          ],
          "default": "solid"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in a new tab",
          "default": false
