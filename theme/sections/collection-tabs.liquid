{%- comment -%}
  Collection tabs (master-plan/05 T4): architectural tabbed collection showcase with a sliding
  active indicator, live piece counts, staggered card reveals, and a structured footer bar.
  ARIA tabs with JS; stacked sections with headings without JS. Images in hidden panels stay lazy.
{%- endcomment -%}
{%- assign tabs = section.blocks | where: 'type', 'tab' -%}
{%- if tabs.size > 0 -%}
  <div class="collection-tabs section-spacing color-{{ section.settings.color_scheme }} full-width">
    <div class="collection-tabs__inner">
      <nk-tabs class="collection-tabs__root">
        <div class="collection-tabs__top">
          <div class="collection-tabs__title-wrap">
            {%- if section.settings.eyebrow != blank -%}
              <nk-reveal mode="fade">
                <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
              </nk-reveal>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              {%- liquid
                assign heading_html = section.settings.heading | escape
                assign italic = section.settings.heading_italic | escape
              -%}
              {% render 'reveal-heading', text: heading_html, italic: italic, entrance: section.settings.entrance, class: 'display collection-tabs__heading' %}
            {%- endif -%}
          </div>

          <div class="tabs__list collection-tabs__tablist" data-ref="tablist" hidden>
            {%- for block in tabs -%}
              {%- liquid
                assign col = block.settings.collection
                assign label = block.settings.label | default: col.title | default: 'Collection'
                assign item_count = col.all_products_count | default: col.products_count | default: 0
              -%}
              <button
                type="button"
                class="tabs__tab collection-tabs__tab"
                id="Tab-{{ section.id }}-{{ block.id }}"
                data-ref="tab"
                {% if forloop.first %}data-selected{% endif %}
              >
                <span class="tabs__tab-label">{{- label | escape -}}</span>
                {%- if item_count > 0 -%}
                  <span class="tabs__count">({{ item_count }})</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
            <span class="tabs__indicator" data-ref="indicator" aria-hidden="true"></span>
          </div>
        </div>

        {%- for block in tabs -%}
          {%- liquid
            assign collection_source = block.settings.collection
            assign label = block.settings.label | default: collection_source.title | default: 'Collection'
            assign total_count = collection_source.all_products_count | default: collection_source.products_count | default: 0
          -%}
          <div
            class="tabs__panel collection-tabs__panel"
            id="TabPanel-{{ section.id }}-{{ block.id }}"
            data-ref="panel"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <h3 class="tabs__panel-heading">{{ label | escape }}</h3>
            {%- if collection_source.products.size > 0 -%}
              {%- if forloop.first %}<nk-stagger>{% endif -%}
                <ul
                  class="product-grid collection-tabs__grid"
                  role="list"
                  style="--nk-cols-mobile: 1; --nk-cols-desktop: {{ section.settings.columns_desktop }};"
                >
                  {%- for product in collection_source.products limit: section.settings.limit -%}
                    <li {% if forloop.parentloop.first %}data-stagger-item{% else %}data-tab-item{% endif %}>
                      {% render 'product-card', product: product %}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- if forloop.first %}</nk-stagger>{% endif -%}

              <div class="collection-tabs__footer">
                <span class="spec text-muted">
                  {{- label | escape }} · {{ 'collection.product_count' | t: count: total_count -}}
                </span>
                <a class="button button--secondary collection-tabs__cta" href="{{ collection_source.url }}" data-magnetic>
                  {{- 'collection.view_all' | t }} ({{ total_count }}) →
                </a>
              </div>
            {%- elsif request.design_mode -%}
              <p class="text-muted">{{ 'collection.choose_collection' | t }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nk-tabs>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tabs__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .collection-tabs__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
    padding-bottom: 0;
    border-bottom: 1px solid var(--nk-color-line);
  }

  @media (min-width: 990px) {
    .collection-tabs__top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }
  }

  .collection-tabs__title-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 18px;
  }

  .collection-tabs__heading {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  }

  .collection-tabs-section .collection-tabs__tablist {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.5vw, 36px);
    margin: 0;
    padding: 0;
    border-bottom: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .collection-tabs-section .collection-tabs__tablist::-webkit-scrollbar {
    display: none;
  }

  .collection-tabs-section .collection-tabs__tab {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-height: 48px;
    padding: 12px 2px 16px;
    font-family: var(--nk-font-spec);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in oklab, var(--nk-color-text) 48%, transparent);
    transition: color 260ms var(--nk-ease-out);
  }

  @media (hover: hover) {
    .collection-tabs-section .collection-tabs__tab:hover {
        color: color-mix(in oklab, var(--nk-color-text) 82%, transparent);
      }
  }

  .collection-tabs-section .collection-tabs__tab[aria-selected='true'] {
    color: var(--nk-color-text);
    font-style: normal;
  }

  .collection-tabs-section .tabs__count {
    font-family: var(--nk-font-spec);
    font-size: 0.625rem;
    font-style: normal;
    letter-spacing: 0.08em;
    color: var(--nk-color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .collection-tabs-section .tabs__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background: var(--nk-color-text);
    transition:
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1),
      width 460ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-tabs__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--nk-color-line);
  }

  .collection-tabs__cta {
    min-height: 46px;
    padding-inline: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection tabs",
  "class": "collection-tabs-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)", "default": "landed" },
    {
      "type": "select",
      "id": "entrance",
      "label": "Heading entrance",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "cut", "label": "Editorial masked reveal" },
        { "value": "rise", "label": "Rise word by word (Split Text)" },
        { "value": "blur", "label": "Blur in word by word (Text Effect)" },
        { "value": "fold", "label": "Paper fold (Fold Text)" },
        { "value": "flip", "label": "Flip up" },
        { "value": "skew", "label": "Skew in" },
        { "value": "pop", "label": "Pop" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "cut"
    },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [{ "name": "Collection tabs", "blocks": [{ "type": "tab" }, { "type": "tab" }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
