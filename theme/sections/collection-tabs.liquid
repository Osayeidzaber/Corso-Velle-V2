{%- comment -%}
  Collection tabs: one tab per collection with a sliding indicator, item counts, staggered card
  reveals and a footer bar.
  ARIA tabs with JS; stacked sections with headings without JS. Images in hidden panels stay lazy.
{%- endcomment -%}
{%- assign tabs = section.blocks | where: 'type', 'tab' -%}
{%- if tabs.size > 0 -%}
  <div class="collection-tabs section-spacing section-presentation color-{{ section.settings.color_scheme }} full-width" style="{% render 'section-presentation', presentation: section.settings %}--tabs-gap:{{ section.settings.grid_gap | default: 8 }}px;" data-tabs-style="{{ section.settings.tab_style }}">
    <div class="collection-tabs__inner">
      <nk-tabs class="collection-tabs__root" label="{{ section.settings.heading | escape }}" {% if section.settings.tab_style == 'sidebar' %}data-orientation="vertical"{% endif %} {% if section.settings.transitions == false %}no-transition{% endif %}>
        <div class="collection-tabs__top">
          <div class="collection-tabs__title-wrap">
            {%- if section.settings.eyebrow != blank -%}
              <nk-reveal mode="fade">
                <span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>
              </nk-reveal>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              {%- liquid
                assign heading_html = section.settings.heading | escape
                assign italic = section.settings.heading_italic | escape
              -%}
              {% render 'reveal-heading', text: heading_html, italic: italic, entrance: section.settings.entrance, class: 'display collection-tabs__heading' %}
            {%- endif -%}
          </div>

          <div class="tabs__list collection-tabs__tablist" data-ref="tablist" hidden>
            {%- for block in tabs -%}
              {%- liquid
                assign col = block.settings.collection
                assign label = block.settings.label | default: col.title | default: 'Collection'
                assign tab_limit = block.settings.limit | default: 0 | plus: 0
                if tab_limit == 0
                  assign tab_limit = section.settings.limit
                endif
                assign item_count = col.products.size | at_most: tab_limit
              -%}
              <button
                type="button"
                class="tabs__tab collection-tabs__tab"
                id="Tab-{{ section.id }}-{{ block.id }}"
                data-ref="tab"
                {% if forloop.first %}data-selected{% endif %}
              >
                <span class="tabs__tab-label">{{- label | escape -}}</span>
                {%- if item_count > 0 -%}
                  <span class="tabs__count">({{ item_count }})</span>
                {%- endif -%}
              </button>
            {%- endfor -%}
            <span class="tabs__indicator" data-ref="indicator" aria-hidden="true"></span>
          </div>
        </div>

        {%- for block in tabs -%}
          {%- liquid
            assign collection_source = block.settings.collection
            assign label = block.settings.label | default: collection_source.title | default: 'Collection'
            assign total_count = collection_source.all_products_count | default: collection_source.products_count | default: 0
            assign tab_limit = block.settings.limit | default: 0 | plus: 0
            if tab_limit == 0
              assign tab_limit = section.settings.limit
            endif
            assign shown_count = collection_source.products.size | at_most: tab_limit
          -%}
          <div
            class="tabs__panel collection-tabs__panel"
            id="TabPanel-{{ section.id }}-{{ block.id }}"
            data-ref="panel"
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            <h3 class="tabs__panel-heading">{{ label | escape }}</h3>
            {%- if collection_source.products.size > 0 -%}
              {%- if forloop.first %}<nk-stagger>{% endif -%}
                <ul
                  class="product-grid collection-tabs__grid"
                  role="list"
                  style="--nk-cols-mobile: {{ section.settings.columns_mobile | default: 1 }}; --nk-cols-desktop: {{ section.settings.columns_desktop }};"
                >
                  {%- for product in collection_source.products limit: tab_limit -%}
                    <li {% if forloop.parentloop.first %}data-stagger-item{% else %}data-tab-item{% endif %}>
                      {% render 'product-card', product: product, card_options: section.settings %}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- if forloop.first %}</nk-stagger>{% endif -%}

              <div class="collection-tabs__footer">
                <span class="spec text-muted">
                  {{- 'collection.showing_count' | t: shown: shown_count, total: total_count -}}
                </span>
                <a class="button button--secondary collection-tabs__cta" href="{{ collection_source.url }}" data-magnetic>
                  {{- 'collection.view_all' | t }} ({{ total_count }}) →
                </a>
              </div>
            {%- elsif request.design_mode -%}
              <p class="text-muted">{{ 'collection.choose_collection' | t }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nk-tabs>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tabs .product-grid { column-gap: var(--tabs-gap, 8px); }
  .collection-tabs[data-tabs-style='pills'] .collection-tabs__tab { border: 1px solid var(--nk-color-line); border-radius: 999px; padding: 12px 18px; margin-block: 8px; }
  .collection-tabs[data-tabs-style='pills'] .collection-tabs__tab[aria-selected='true'] { background: var(--nk-color-text); color: var(--nk-color-bg); }
  .collection-tabs[data-tabs-style='pills'] .tabs__indicator { display: none; }
  .collection-tabs nk-tabs[no-transition] .tabs__indicator { transition: none; }
  @media (min-width: 990px) {
    .collection-tabs[data-tabs-style='sidebar'] nk-tabs[data-enhanced] { display: grid; grid-template-columns: minmax(160px, 240px) minmax(0, 1fr); gap: 32px; }
    .collection-tabs[data-tabs-style='sidebar'] .collection-tabs__top { display: block; align-self: start; border: 0; }
    .collection-tabs[data-tabs-style='sidebar'] .collection-tabs__heading { font-size: 2rem; }
    .collection-tabs[data-tabs-style='sidebar'] .collection-tabs__tablist { flex-direction: column; align-items: stretch; gap: 8px; }
    .collection-tabs[data-tabs-style='sidebar'] .tabs__indicator { display: none; }
    .collection-tabs[data-tabs-style='sidebar'] .collection-tabs__panel { grid-column: 2; grid-row: 1; min-width: 0; }
  }
  .collection-tabs__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .collection-tabs__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 36px;
    padding-bottom: 0;
    border-bottom: 1px solid var(--nk-color-line);
  }

  @media (min-width: 990px) {
    .collection-tabs__top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 32px;
    }
  }

  .collection-tabs__title-wrap {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 18px;
  }

  .collection-tabs__heading {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  }

  .collection-tabs-section .collection-tabs__tablist {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.5vw, 36px);
    margin: 0;
    padding: 0;
    border-bottom: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .collection-tabs-section .collection-tabs__tablist::-webkit-scrollbar {
    display: none;
  }

  .collection-tabs-section .collection-tabs__tab {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-height: 48px;
    padding: 12px 2px 16px;
    font-family: var(--nk-font-spec);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in oklab, var(--nk-color-text) 48%, transparent);
    transition: color 260ms var(--nk-ease-out);
  }

  @media (hover: hover) {
    .collection-tabs-section .collection-tabs__tab:hover {
        color: color-mix(in oklab, var(--nk-color-text) 82%, transparent);
      }
  }

  .collection-tabs-section .collection-tabs__tab[aria-selected='true'] {
    color: var(--nk-color-text);
    font-style: normal;
  }

  .collection-tabs-section .tabs__count {
    font-family: var(--nk-font-spec);
    font-size: 0.625rem;
    font-style: normal;
    letter-spacing: 0.08em;
    color: var(--nk-color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .collection-tabs-section .tabs__indicator {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    background: var(--nk-color-text);
    transition:
      transform 460ms cubic-bezier(0.22, 1, 0.36, 1),
      width 460ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection-tabs__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--nk-color-line);
  }

  .collection-tabs__cta {
    min-height: 46px;
    padding-inline: 24px;
  }
{% endstylesheet %}

{% schema %}
