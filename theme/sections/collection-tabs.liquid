{%- comment -%}
  Collection tabs (rewrite of the supplied tabswithtransctition example): one tab per chosen
  collection, each panel a product grid using the shared card. ARIA tabs with JS; stacked
  sections with headings without JS. Images in hidden panels stay lazy.
{%- endcomment -%}
{%- assign tabs = section.blocks | where: 'type', 'tab' -%}
{%- if tabs.size > 0 -%}
  <div class="section-spacing color-{{ section.settings.color_scheme }} full-width">
    <div style="width: var(--content-width); margin-inline: auto;">
      <div class="section-head" style="margin-bottom: 8px;">
        <div class="flex flex-col gap-4">
          {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- liquid
                assign heading_html = section.settings.heading | escape
                assign italic = section.settings.heading_italic | escape
              -%}
            {% render 'reveal-heading', text: heading_html, italic: italic, entrance: section.settings.entrance, class: 'display' %}
          {%- endif -%}
        </div>
      </div>
      <nk-tabs>
        <div class="tabs__list" data-ref="tablist" hidden>
          {%- for block in tabs -%}
            {%- assign label = block.settings.label | default: block.settings.collection.title | default: 'Collection' -%}
            <button
              type="button"
              class="tabs__tab"
              id="Tab-{{ block.id }}"
              data-ref="tab"
              {% if forloop.first %}data-selected{% endif %}
            >
              <span class="tabs__tab-label">{{- label | escape -}}</span>
              {%- if block.settings.collection.products_count > 0 -%}<sup class="tabs__count">{{ block.settings.collection.products_count }}</sup>{%- endif -%}
            </button>
          {%- endfor -%}
          <span class="tabs__indicator" data-ref="indicator" aria-hidden="true"></span>
        </div>

        {%- for block in tabs -%}
          {%- assign collection_source = block.settings.collection -%}
          {%- assign label = block.settings.label | default: collection_source.title | default: 'Collection' -%}
          <div class="tabs__panel" id="TabPanel-{{ block.id }}" data-ref="panel" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
            <h3 class="tabs__panel-heading">{{ label | escape }}</h3>
            {%- if collection_source.products.size > 0 -%}
              {%- comment -%}
                Only the first panel reveals on scroll; other panels are hidden until chosen, so the
                tabs component plays their cards in when they open.
              {%- endcomment -%}
              {%- if forloop.first %}<nk-stagger>{% endif -%}
                <ul class="product-grid" role="list" style="--nk-cols-desktop: {{ section.settings.columns_desktop }};">
                  {%- for product in collection_source.products limit: section.settings.limit -%}
                    <li {% if forloop.parentloop.first %}data-stagger-item{% else %}data-tab-item{% endif %}>{% render 'product-card', product: product %}</li>
                  {%- endfor -%}
                </ul>
              {%- if forloop.first %}</nk-stagger>{% endif -%}
              <p class="collection-tabs__more"><a class="spec link-underline" href="{{ collection_source.url }}">{% render 'letter-swap', text: label %} — {{ 'collection.view_all' | t }}</a></p>
            {%- elsif request.design_mode -%}
              <p class="text-muted">{{ 'collection.choose_collection' | t }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nk-tabs>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .collection-tabs-section .tabs__list {
    gap: clamp(18px, 3vw, 40px);
    margin: 28px 0 36px;
    border-bottom: 0;
    padding-bottom: 10px;
  }
  .collection-tabs-section .tabs__tab {
    display: inline-flex;
    align-items: flex-start;
    gap: 4px;
    padding: 0;
    font-family: var(--nk-font-heading);
    font-size: clamp(1.375rem, 2.6vw, 2.125rem);
    letter-spacing: -0.015em;
    text-transform: none;
    color: color-mix(in oklab, var(--nk-color-text) 38%, transparent);
    transition: color 300ms var(--nk-ease-out);
  }
  .collection-tabs-section .tabs__tab:hover { color: color-mix(in oklab, var(--nk-color-text) 70%, transparent); }
  .collection-tabs-section .tabs__tab[aria-selected='true'] { color: var(--nk-color-text); font-style: italic; }
  .tabs__count {
    font-family: var(--nk-font-spec);
    font-size: 0.625rem;
    font-style: normal;
    letter-spacing: 0.1em;
    top: 0.2em;
  }
  .collection-tabs-section .tabs__indicator {
    height: 1px;
    background: var(--nk-color-text);
    transition: transform 520ms cubic-bezier(.2,.7,.2,1), width 520ms cubic-bezier(.2,.7,.2,1);
  }
  .collection-tabs__more { margin-top: 32px; text-align: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection tabs",
  "class": "collection-tabs-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Just" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)", "default": "landed" },
    {
      "type": "select",
      "id": "entrance",
      "label": "Heading entrance",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "rise", "label": "Rise letter by letter (Split Text)" },
        { "value": "blur", "label": "Blur in word by word (Text Effect)" },
        { "value": "fold", "label": "Paper fold (Fold Text)" },
        { "value": "flip", "label": "Flip up" },
        { "value": "skew", "label": "Skew in" },
        { "value": "pop", "label": "Pop" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "blur"
    },
    { "type": "range", "id": "limit", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Tab label", "info": "Defaults to the collection title." }
      ]
    }
  ],
  "presets": [{ "name": "Collection tabs", "blocks": [{ "type": "tab" }, { "type": "tab" }] }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
