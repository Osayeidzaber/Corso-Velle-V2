    },
    {
      "type": "select",
      "id": "toolbar_width",
      "label": "Filter toolbar width",
      "options": [
        {
          "value": "full",
          "label": "Full bleed"
        },
        {
          "value": "contained",
          "label": "Within content"
        }
      ],
      "default": "full"
