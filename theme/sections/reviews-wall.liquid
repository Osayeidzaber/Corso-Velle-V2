{%- comment -%}One semantic list of genuine reviews. Only inert animation copies are hidden.{%- endcomment -%}
{%- assign quotes = section.blocks | where: 'type', 'quote' -%}
{%- if quotes.size > 0 or request.design_mode -%}
  <div class="reviews-wall full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" style="{% render 'section-presentation', presentation: section.settings %}--wall-h: {{ section.settings.height }}px; --wall-cols: {{ section.settings.columns }};" data-align="{{ section.settings.alignment }}" data-card="{{ section.settings.card_style }}">
    <div class="reviews-wall__inner">
      {%- if section.settings.heading != blank -%}
        {% render 'reveal-heading', text: section.settings.heading, entrance: 'cut', class: 'reviews-wall__heading' %}
      {%- endif -%}
      <nk-marquee class="reviews-wall__marquee" direction="up" speed="{{ section.settings.speed }}" hover-speed="0" static-on-phone {% if section.settings.layout == 'grid' %}static{% endif %}>
        <div class="marquee__track" data-ref="track">
          <ul class="marquee__list reviews-wall__list" data-ref="list" role="list">
            {%- for block in quotes -%}
              <li class="marquee__item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                <figure class="review-card">
                  <blockquote>{{ block.settings.quote }}</blockquote>
                  <figcaption class="spec">
                    {{- block.settings.name | escape -}}
                    {%- if block.settings.product != blank %} · <a href="{{ block.settings.product.url }}">{{ block.settings.product.title | escape }}</a>{%- endif -%}
                  </figcaption>
                </figure>
              </li>
            {%- endfor -%}
          </ul>
        </div>
        <button type="button" class="marquee__pause" data-ref="pause" aria-pressed="false" aria-label="{{ 'marquee.pause' | t }}" hidden>❚❚</button>
      </nk-marquee>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .reviews-wall__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 24px; min-width: 0; }
  .reviews-wall__heading { font-size: clamp(1.75rem, 5vw, 3rem); overflow-wrap: anywhere; }
  .reviews-wall .reviews-wall__marquee { height: auto; overflow: visible; }
  .reviews-wall .reviews-wall__marquee[data-moving] { height: var(--wall-h, 520px); overflow: hidden; }
  .reviews-wall .marquee__track { width: 100%; }
  .reviews-wall .reviews-wall__list { display: grid; grid-template-columns: repeat(var(--wall-cols, 2), minmax(0, 1fr)); align-items: stretch; width: 100%; gap: 16px; padding-block: 8px; }
  .reviews-wall .marquee__item { min-width: 0; padding: 0; white-space: normal; }
  .reviews-wall .review-card { margin: 0; padding: 18px; height: 100%; display: grid; align-content: start; gap: 10px; background: var(--nk-color-surface); border: 1px solid var(--nk-color-line); overflow-wrap: anywhere; }
  .reviews-wall[data-card='flat'] .review-card { background: transparent; border: 0; }
  .reviews-wall[data-align='center'] { text-align: center; }
  .review-card blockquote { margin: 0; line-height: 1.5; }
  @media (max-width: 749px) { .reviews-wall .reviews-wall__list { grid-template-columns: minmax(0, 1fr); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews wall",
  "class": "reviews-wall-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What customers say" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "wall", "label": "Moving wall" }, { "value": "grid", "label": "Static grid" }], "default": "wall", "info": "Phones, reduced motion and the editor show all reviews statically. Moving columns travel together so one pause button controls the wall." },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }, { "value": "3", "label": "3" }], "default": "2" },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "select", "id": "card_style", "label": "Review cards", "options": [{ "value": "bordered", "label": "Bordered" }, { "value": "flat", "label": "Minimal" }], "default": "bordered" },
    { "type": "range", "id": "height", "label": "Moving wall height", "min": 320, "max": 800, "step": 20, "unit": "px", "default": 520, "visible_if": "{{ section.settings.layout == 'wall' }}" },
    { "type": "range", "id": "speed", "label": "Speed", "min": 10, "max": 80, "step": 5, "unit": "px", "default": 25, "visible_if": "{{ section.settings.layout == 'wall' }}" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "Only add real reviews with the customer's permission. Review apps can also be added as app blocks on product pages." }
  ],
  "blocks": [{ "type": "quote", "name": "Review", "settings": [
    { "type": "richtext", "id": "quote", "label": "Review text" },
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "product", "id": "product", "label": "Product reviewed" }
  ] }],
  "presets": [{ "name": "Reviews wall" }, { "name": "Reviews grid", "settings": { "layout": "grid", "card_style": "flat", "alignment": "center" } }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
