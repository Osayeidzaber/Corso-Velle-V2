{%- comment -%}
  Before / after image slider. Clip layout adapted from daisyUI diff, driven by a native range input (src/components/image-compare).
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="image-compare kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-handle="{{ section.settings.handle_color }}" data-handle-style="{{ section.settings.handle_style }}" data-labels="{{ section.settings.label_position }}" style="{% render 'section-presentation', presentation: section.settings %}--compare-cols:{{ section.settings.columns }};--compare-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="image-compare__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <div class="image-compare__grid">
      {%- for block in section.blocks -%}
        <figure class="image-compare__item"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <nk-image-compare class="image-compare__frame" data-ratio="{{ section.settings.ratio }}" style="--position:{{ block.settings.start }}%;">
            <div class="image-compare__layer image-compare__layer--after">{%- if block.settings.after != blank -%}{{ block.settings.after | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', class: 'image-compare__image' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag: 'image-compare__image kit-placeholder' }}{%- endif -%}</div>
            <div class="image-compare__layer image-compare__layer--before">{%- if block.settings.before != blank -%}{{ block.settings.before | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', class: 'image-compare__image' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'image-compare__image kit-placeholder' }}{%- endif -%}</div>
            <span class="image-compare__label image-compare__label--before" aria-hidden="true">{{ block.settings.before_label | escape }}</span>
            <span class="image-compare__label image-compare__label--after" aria-hidden="true">{{ block.settings.after_label | escape }}</span>
            <span class="image-compare__handle" aria-hidden="true"></span>
            {%- assign slider_label = 'sections.compare.slider' | t: before: block.settings.before_label, after: block.settings.after_label -%}
            <input class="image-compare__range" data-ref="range" type="range" min="0" max="100" step="1" value="{{ block.settings.start }}" aria-label="{{ slider_label | escape }}" hidden>
          </nk-image-compare>
          {%- if block.settings.caption != blank -%}<figcaption class="text-muted">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.image-compare__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
.image-compare__grid { display: grid; gap: var(--compare-gap, 24px); }
.image-compare__item { display: grid; gap: 10px; margin: 0; min-width: 0; }
.image-compare__frame { --handle: #fff; --handle-ink: #111; position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; user-select: none; background: var(--nk-color-surface); border-radius: var(--kit-radius); }
.image-compare[data-handle='dark'] .image-compare__frame { --handle: #111; --handle-ink: #fff; }
.image-compare[data-handle='accent'] .image-compare__frame { --handle: var(--nk-color-accent); --handle-ink: #fff; }
.image-compare__frame[data-ratio='square'] { aspect-ratio: 1; }
.image-compare__frame[data-ratio='landscape'] { aspect-ratio: 3 / 2; }
.image-compare__frame[data-ratio='wide'] { aspect-ratio: 16 / 9; }
.image-compare__frame[data-ratio='tall'] { aspect-ratio: 2 / 3; }
.image-compare__layer { position: absolute; inset: 0; }
.image-compare__layer--before { clip-path: inset(0 calc(100% - var(--position, 50%)) 0 0); }
.image-compare__image { width: 100%; height: 100%; object-fit: cover; display: block; }
.image-compare__handle { position: absolute; top: 0; bottom: 0; left: var(--position, 50%); width: 2px; translate: -1px 0; background: var(--handle); box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12); pointer-events: none; }
.image-compare__handle::after { content: '‹ ›'; position: absolute; top: 50%; left: 50%; translate: -50% -50%; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--handle); color: var(--handle-ink); font-weight: 700; letter-spacing: 0.1em; box-shadow: 0 2px 10px rgb(0 0 0 / 0.25); }
.image-compare[data-handle-style='bar'] .image-compare__handle::after { width: 12px; height: 56px; border-radius: 999px; content: ''; }
.image-compare[data-handle-style='line'] .image-compare__handle::after { content: none; }
.image-compare__label { position: absolute; bottom: 12px; padding: 4px 10px; background: rgb(0 0 0 / 0.55); color: #fff; font-family: var(--nk-font-spec); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; pointer-events: none; border-radius: var(--nk-button-radius, 0); }
.image-compare[data-labels='top'] .image-compare__label { bottom: auto; top: 12px; }
.image-compare[data-labels='none'] .image-compare__label { display: none; }
.image-compare__label--before { left: 12px; }
.image-compare__label--after { right: 12px; }
.image-compare__label:empty { display: none; }
@media (min-width: 990px) { .image-compare__grid { grid-template-columns: repeat(var(--compare-cols, 1), minmax(0, 1fr)); } }
{% endstylesheet %}

