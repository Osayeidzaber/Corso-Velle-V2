{%- comment -%}
  Image / logo strip (rewrite of the supplied infiniteslider example): endless row of images
  that slows down on hover. Each image can link somewhere. Static scrollable rail under reduced
  motion.
{%- endcomment -%}
{%- assign items = section.blocks | where: 'type', 'image' -%}
{%- if items.size > 0 -%}
  <div class="image-strip full-width section-spacing color-{{ section.settings.color_scheme }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-strip__heading spec">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <nk-marquee speed="{{ section.settings.speed }}" hover-speed="0.2" {% if section.settings.reverse %}direction="right"{% endif %} fade-edges style="--nk-marquee-gap: {{ section.settings.gap | divided_by: 2 }}px; --strip-h: {{ section.settings.height }}px;">
      <div class="marquee__track" data-ref="track">
        <ul class="marquee__list" data-ref="list" role="list">
          {%- for block in items -%}
            <li class="marquee__item image-strip__item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
              {%- capture media -%}
                {%- if block.settings.image -%}
                  {%- assign alt = block.settings.image.alt | default: block.settings.label | escape -%}
                  {{ block.settings.image | image_url: height: 400 | image_tag: loading: 'lazy', alt: alt, height: section.settings.height }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'image-strip__placeholder' }}
                {%- endif -%}
              {%- endcapture -%}
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}">{{ media }}</a>
              {%- else -%}
                {{ media }}
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <button type="button" class="marquee__pause" data-ref="pause" aria-pressed="false" aria-label="{{ 'marquee.pause' | t }}" hidden>❚❚</button>
    </nk-marquee>
  </div>
{%- endif -%}

{% stylesheet %}
  .image-strip__heading { width: var(--content-width); margin: 0 auto 16px; }
  .image-strip__item img, .image-strip__placeholder {
    display: block;
    height: var(--strip-h, 120px);
    width: auto;
    max-width: none;
    object-fit: cover;
  }
  .image-strip__placeholder { width: var(--strip-h, 120px); background: var(--nk-color-surface); }
{% endstylesheet %}

{% schema %}
{
  "name": "Image strip",
  "class": "image-strip-section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "height", "label": "Image height", "min": 40, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "range", "id": "gap", "label": "Gap", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "speed", "label": "Speed", "min": 10, "max": 120, "step": 10, "unit": "px", "default": 40 },
    { "type": "checkbox", "id": "reverse", "label": "Move left to right", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Accessible label", "info": "Used when the image has no alt text, e.g. a press logo name." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Image strip", "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }] }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
