{%- comment -%}
  Shoppable image with product hotspots. Layout from Shopify Dawn collage; hotspot dot from daisyUI status; card from Flowbite popover, rebuilt on native <details> (no script).
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="lookbook kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-marker="{{ section.settings.marker }}" data-marker-color="{{ section.settings.marker_color }}" data-numbers="{{ section.settings.show_numbers }}" data-list="{{ section.settings.list_position }}" data-pulse="{{ section.settings.pulse }}" style="{% render 'section-presentation', presentation: section.settings %}--lookbook-marker:{{ section.settings.marker_size }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="lookbook__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <div class="lookbook__layout">
      <div class="lookbook__stage kit-media" data-ratio="{{ section.settings.image_ratio }}">
        {%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 1200px) 1200px, 100vw', class: 'lookbook__image' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'lookbook__image kit-placeholder' }}{%- endif -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign product = block.settings.product
            assign spot_title = product.title | default: block.settings.label | default: 'Product'
            assign spot_label = 'sections.lookbook.hotspot' | t: title: spot_title
            assign side = 'right'
            if block.settings.x > 60
              assign side = 'left'
            endif
            assign vertical = 'below'
            if block.settings.y > 60
              assign vertical = 'above'
            endif
          -%}
          <details class="lookbook__spot" name="Lookbook-{{ section.id }}" data-side="{{ side }}" data-vertical="{{ vertical }}" style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%;" {{ block.shopify_attributes }}>
            <summary class="lookbook__marker"><span class="visually-hidden">{{ spot_label | escape }}</span><span class="lookbook__dot" aria-hidden="true" data-index="{{ forloop.index }}"></span></summary>
            <div class="lookbook__card">
              {%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'lookbook__thumb', alt: '' }}{%- elsif block.settings.image != blank -%}{{ block.settings.image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'lookbook__thumb', alt: '' }}{%- endif -%}
              <div class="lookbook__card-copy">
                <p class="lookbook__card-title">{{ spot_title | escape }}</p>
                {%- if product -%}<p class="spec">{{ product.price | money }}</p>{%- endif -%}
                {%- assign spot_url = product.url | default: block.settings.link -%}
                {%- if spot_url != blank -%}<a class="kit-link" href="{{ spot_url }}">{%- if block.settings.link_label != blank -%}{{ block.settings.link_label | escape }}{%- else -%}{{ 'sections.lookbook.view' | t }}{%- endif -%} <span aria-hidden="true">→</span></a>{%- endif -%}
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.list_position != 'none' -%}
        <ol class="lookbook__list" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            {%- assign spot_url = product.url | default: block.settings.link -%}
            <li class="lookbook__row"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %}>
              <span class="lookbook__index spec" aria-hidden="true">{{ forloop.index }}</span>
              {%- if product.featured_media and section.settings.list_thumbs -%}{{ product.featured_media.preview_image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'lookbook__list-thumb', alt: '' }}{%- endif -%}
              <span class="lookbook__row-copy">
                {%- if spot_url != blank -%}<a href="{{ spot_url }}">{{ product.title | default: block.settings.label | escape }}</a>{%- else -%}{{ product.title | default: block.settings.label | escape }}{%- endif -%}
                {%- if product -%}<span class="text-muted">{{ product.price | money }}</span>{%- endif -%}
              </span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.lookbook__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 24px; }
.lookbook__layout { display: grid; gap: 24px; }
.lookbook__stage { position: relative; overflow: visible; }
.lookbook__stage > .lookbook__image, .lookbook__stage > .kit-placeholder { border-radius: var(--kit-radius); }
.lookbook__stage[data-ratio='adapt'] .kit-placeholder { aspect-ratio: 3 / 2; }
.lookbook__spot { position: absolute; left: var(--x); top: var(--y); translate: -50% -50%; z-index: 1; }
.lookbook__spot[open] { z-index: 3; }
.lookbook__marker { display: grid; place-items: center; width: max(44px, var(--lookbook-marker, 26px)); height: max(44px, var(--lookbook-marker, 26px)); list-style: none; cursor: pointer; }
.lookbook__marker::-webkit-details-marker { display: none; }
.lookbook__marker::after { content: none; }
.lookbook__dot { --dot-bg: #fff; --dot-fg: #111; position: relative; display: grid; place-items: center; width: var(--lookbook-marker, 26px); height: var(--lookbook-marker, 26px); border-radius: 50%; background: var(--dot-bg); color: var(--dot-fg); box-shadow: 0 0 0 2px rgb(0 0 0 / 0.15), 0 2px 8px rgb(0 0 0 / 0.25); font-family: var(--nk-font-spec); font-size: calc(var(--lookbook-marker, 26px) * 0.45); font-weight: 700; line-height: 1; }
.lookbook[data-marker-color='dark'] .lookbook__dot { --dot-bg: #111; --dot-fg: #fff; }
.lookbook[data-marker-color='accent'] .lookbook__dot { --dot-bg: var(--nk-color-accent); --dot-fg: #fff; }
.lookbook[data-marker='plus'] .lookbook__dot::before { content: '+'; font-size: calc(var(--lookbook-marker, 26px) * 0.7); font-weight: 400; }
.lookbook[data-marker='dot'] .lookbook__dot::before { content: ''; width: 36%; height: 36%; border-radius: 50%; background: var(--dot-fg); }
.lookbook[data-numbers='true'] .lookbook__dot::before { content: attr(data-index); width: auto; height: auto; background: none; font-size: calc(var(--lookbook-marker, 26px) * 0.45); font-weight: 700; }
.lookbook__spot[open] .lookbook__dot { outline: 2px solid var(--dot-bg); outline-offset: 3px; }
@media (prefers-reduced-motion: no-preference) {
  .nk-anim .lookbook[data-pulse='true'] .lookbook__spot:not([open]) .lookbook__dot::after { content: ''; position: absolute; inset: 0; z-index: -1; border-radius: 50%; background: var(--dot-bg); animation: lookbook-ping 2.2s var(--nk-ease-out) infinite; }
}
@keyframes lookbook-ping { 0% { scale: 1; opacity: 0.6; } 80%, 100% { scale: 2.2; opacity: 0; } }
.lookbook__card { position: absolute; top: calc(100% + 4px); left: 50%; display: flex; gap: 12px; width: max-content; max-width: min(280px, 70vw); padding: 12px; background: var(--nk-color-bg); color: var(--nk-color-text); border: 1px solid var(--nk-color-line); border-radius: var(--kit-radius); box-shadow: 0 8px 28px rgb(0 0 0 / 0.16); }
.lookbook__spot[data-side='left'] .lookbook__card { left: auto; right: 50%; }
.lookbook__spot[data-vertical='above'] .lookbook__card { top: auto; bottom: calc(100% + 4px); }
.lookbook__thumb { width: 64px; height: 80px; object-fit: cover; border-radius: var(--kit-radius); }
.lookbook__card-copy { display: grid; gap: 4px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
.lookbook__card-copy p { margin: 0; }
.lookbook__card-title { font-weight: 600; }
.lookbook__list { display: grid; gap: 4px; list-style: none; margin: 0; padding: 0; counter-reset: none; }
.lookbook__row { display: flex; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--nk-color-line); }
.lookbook__index { display: grid; place-items: center; flex: none; width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--nk-color-line); font-size: 0.75rem; }
.lookbook__list-thumb { width: 48px; height: 60px; object-fit: cover; border-radius: var(--kit-radius); }
.lookbook__row-copy { display: grid; gap: 2px; min-width: 0; }
@media (min-width: 750px) { .lookbook[data-list='below'] .lookbook__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; } }
@media (min-width: 990px) {
  .lookbook[data-list='side'] .lookbook__layout { grid-template-columns: minmax(0, 2fr) minmax(260px, 1fr); align-items: start; gap: 40px; }
  .lookbook[data-list='below'] .lookbook__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Lookbook hotspots",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the look"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "tall",
          "label": "Tall (2:3)"
        },
        {
          "value": "landscape",
          "label": "Landscape (3:2)"
        },
        {
          "value": "wide",
          "label": "Wide (16:9)"
        }
      ],
      "default": "adapt",
      "info": "Fixed ratios crop the image; hotspot positions are relative to the visible frame."
    },
    {
      "type": "header",
      "content": "Hotspots"
    },
    {
      "type": "select",
      "id": "marker",
      "label": "Marker",
      "options": [
        {
          "value": "plus",
          "label": "Plus"
        },
        {
          "value": "dot",
          "label": "Dot"
        }
      ],
      "default": "plus"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Number the markers",
      "default": false
    },
    {
      "type": "select",
      "id": "marker_color",
      "label": "Marker color",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "light"
    },
    {
      "type": "range",
      "id": "marker_size",
      "label": "Marker size",
      "min": 16,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 26
    },
    {
      "type": "checkbox",
      "id": "pulse",
      "label": "Pulse markers",
      "default": true
    },
    {
      "type": "header",
      "content": "Product list"
    },
    {
      "type": "select",
      "id": "list_position",
      "label": "Product list",
      "options": [
        {
          "value": "below",
          "label": "Below the image"
        },
        {
          "value": "side",
          "label": "Beside the image (desktop)"
        },
        {
          "value": "none",
          "label": "Hidden"
        }
      ],
      "default": "below"
    },
    {
      "type": "checkbox",
      "id": "list_thumbs",
      "label": "Show product thumbnails in the list",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "theme",
      "info": "Applies to images, cards and buttons in this section."
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Theme default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in section"
        },
        {
          "value": "stagger",
          "label": "Items rise one by one"
        }
      ],
      "default": "none",
      "info": "Skipped when visitors prefer reduced motion or motion is off in Theme settings."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Without a product"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Thumbnail"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "info": "Defaults to \"View product\"."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Lookbook hotspots",
      "blocks": [
        {
          "type": "hotspot",
          "settings": {
            "x": 35,
            "y": 30
          }
        },
        {
          "type": "hotspot",
          "settings": {
            "x": 62,
            "y": 66
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
