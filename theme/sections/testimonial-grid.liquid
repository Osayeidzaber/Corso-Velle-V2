{%- comment -%}
  Customer quotes with optional star rating, avatar and purchased product; grid or swipe row. Adapted from HyperUI marketing/testimonials.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="testimonial-grid kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-card="{{ section.settings.card_style }}" data-align="{{ section.settings.alignment }}" data-layout="{{ section.settings.layout }}" data-quote="{{ section.settings.quote_size }}" data-avatar="{{ section.settings.avatar_shape }}" style="{% render 'section-presentation', presentation: section.settings %}--testimonial-cols:{{ section.settings.columns }};--testimonial-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="testimonial-grid__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="testimonial-grid__list" role="list"{% if section.settings.layout == 'scroll' %} tabindex="0" aria-label="{{ section.settings.heading | default: 'Testimonials' | escape }}"{% endif %}>
      {%- for block in section.blocks -%}
        <li class="testimonial-grid__slot"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <figure class="testimonial-grid__card kit-card">
            {%- if section.settings.show_mark -%}<svg class="testimonial-grid__mark" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M7.17 6.17A5.5 5.5 0 0 0 3 11.5V18a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H6.06a3.5 3.5 0 0 1 2.35-2.79 1 1 0 1 0-.62-1.9Zm10 0A5.5 5.5 0 0 0 13 11.5V18a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-4.44a3.5 3.5 0 0 1 2.35-2.79 1 1 0 1 0-.62-1.9Z"/></svg>{%- endif -%}
            {%- if section.settings.show_rating and block.settings.rating > 0 -%}
              {%- assign rating_label = 'sections.testimonials.rating' | t: rating: block.settings.rating -%}
              <p class="testimonial-grid__stars" role="img" aria-label="{{ rating_label | escape }}">
                {%- for i in (1..5) -%}<span aria-hidden="true"{% if i > block.settings.rating %} class="is-empty"{% endif %}>★</span>{%- endfor -%}
              </p>
            {%- endif -%}
            {%- if block.settings.title != blank -%}<p class="testimonial-grid__title">{{ block.settings.title | escape }}</p>{%- endif -%}
            <blockquote class="testimonial-grid__quote">{{ block.settings.quote }}</blockquote>
            <figcaption class="testimonial-grid__author">
              {%- if section.settings.show_avatar and block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'testimonial-grid__avatar', alt: '' }}{%- endif -%}
              <span><strong>{{ block.settings.author | escape }}</strong>{%- if block.settings.role != blank -%}<span class="text-muted">{{ block.settings.role | escape }}</span>{%- endif -%}</span>
            </figcaption>
            {%- assign product = block.settings.product -%}
            {%- if product != blank -%}
              <a class="testimonial-grid__product" href="{{ product.url }}">
                {%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
                <span>{{ product.title | escape }}</span>
              </a>
            {%- endif -%}
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.testimonial-grid__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.testimonial-grid__list { display: grid; gap: var(--testimonial-gap, 16px); list-style: none; margin: 0; padding: 0; }
.testimonial-grid__slot { min-width: 0; }
.testimonial-grid__card { display: flex; flex-direction: column; gap: 14px; height: 100%; margin: 0; overflow-wrap: anywhere; }
.testimonial-grid[data-card='plain'] .testimonial-grid__card { padding: 0; }
.testimonial-grid__mark { width: 28px; height: 28px; color: var(--nk-color-accent); }
.testimonial-grid__stars { margin: 0; letter-spacing: 0.15em; color: var(--nk-color-accent); }
.testimonial-grid__stars .is-empty { opacity: 0.25; }
.testimonial-grid__title { margin: 0; font-weight: 700; }
.testimonial-grid__quote { margin: 0; font-size: 1.0625rem; line-height: 1.6; }
.testimonial-grid[data-quote='small'] .testimonial-grid__quote { font-size: 0.9375rem; }
.testimonial-grid[data-quote='large'] .testimonial-grid__quote { font-family: var(--nk-font-heading); font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.35; }
.testimonial-grid__quote p { margin: 0; }
.testimonial-grid__author { display: flex; align-items: center; gap: 12px; margin-top: auto; }
.testimonial-grid__author > span { display: grid; gap: 2px; font-size: 0.875rem; }
.testimonial-grid__avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; }
.testimonial-grid[data-avatar='square'] .testimonial-grid__avatar { border-radius: var(--kit-radius); }
.testimonial-grid__product { display: flex; align-items: center; gap: 10px; padding-top: 12px; border-top: 1px solid var(--nk-color-line); font-size: 0.8125rem; text-decoration: none; }
.testimonial-grid__product img { width: 40px; height: 48px; object-fit: cover; border-radius: var(--kit-radius); }
.testimonial-grid__product span { text-decoration: underline; text-underline-offset: 0.2em; }
.testimonial-grid[data-align='center'] .testimonial-grid__card { text-align: center; align-items: center; }
.testimonial-grid[data-layout='scroll'] .testimonial-grid__list { grid-auto-flow: column; grid-auto-columns: min(82%, 360px); overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; padding-bottom: 12px; scrollbar-width: thin; }
.testimonial-grid[data-layout='scroll'] .testimonial-grid__slot { scroll-snap-align: start; }
@media (min-width: 750px) { .testimonial-grid[data-layout='grid'] .testimonial-grid__list { grid-template-columns: repeat(min(2, var(--testimonial-cols, 3)), minmax(0, 1fr)); } }
@media (min-width: 990px) {
  .testimonial-grid[data-layout='grid'] .testimonial-grid__list { grid-template-columns: repeat(var(--testimonial-cols, 3), minmax(0, 1fr)); }
  .testimonial-grid[data-layout='scroll'] .testimonial-grid__list { grid-auto-columns: calc((100% - (var(--testimonial-cols, 3) - 1) * var(--testimonial-gap, 16px)) / var(--testimonial-cols, 3)); }
  .testimonial-grid[data-layout='masonry'] .testimonial-grid__list { display: block; columns: var(--testimonial-cols, 3); column-gap: var(--testimonial-gap, 16px); }
  .testimonial-grid[data-layout='masonry'] .testimonial-grid__slot { break-inside: avoid; margin-bottom: var(--testimonial-gap, 16px); }
}
{% endstylesheet %}

