{%- comment -%}
  All Collections index (/collections): architectural studio directory inspired by wrclo.com.
  Displays each collection in a numbered gallery frame with live item count, uncropped studio
  imagery, and staggered GSAP entrance animation.
{%- endcomment -%}
{%- liquid
 assign directory_size = collections.size
 if section.settings.collections != blank
   assign directory_size = section.settings.collections.size
 endif
 assign heading_tag = 'h2'
 if request.page_type == 'list-collections' and section.index == 1
   assign heading_tag = 'h1'
 endif
-%}
<div class="collections-index section-spacing section-presentation full-width color-{{ section.settings.color_scheme }}" data-fit="{{ section.settings.image_fit }}" data-ratio="{{ section.settings.image_ratio }}" data-frame="{{ section.settings.image_frame }}" style="{% render 'section-presentation', presentation: section.settings %}"><div class="collections-index__inner">
  <header class="collections-index__header">
    <nk-reveal entrance="rise" duration="0.65">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    </nk-reveal>
    <div class="collections-index__title-row">
      {%- liquid
        assign page_title = 'collections.title' | t
        assign page_title = section.settings.heading | default: page_title | escape -%}
      {% render 'reveal-heading',
        text: page_title,
        entrance: 'words',
        class: 'collections-index__title display',
        tag: heading_tag,
        play_on_load: true
      %}
      <nk-reveal entrance="rise" delay="0.16" duration="0.7">
        <span class="collections-index__total spec">({{ directory_size }})</span>
      </nk-reveal>
    </div>
  </header>

  {% if section.settings.collections != blank %}
    {% paginate section.settings.collections by section.settings.page_size %}
      {% render 'collection-directory-grid', items: section.settings.collections, paginate: paginate, section: section %}
    {% endpaginate %}
  {% else %}
    {% paginate collections by section.settings.page_size %}
      {% render 'collection-directory-grid', items: collections, paginate: paginate, section: section %}
    {% endpaginate %}
  {% endif %}
</div></div>

{% stylesheet %}
 .collections-index__inner { width: var(--content-width); margin-inline: auto; }
 .collections-index[data-fit='cover'] .collections-card__media img { object-fit: cover; padding: 0; }
 .collections-index[data-ratio='square'] .collections-card__media { aspect-ratio: 1; }
 .collections-index[data-ratio='landscape'] .collections-card__media { aspect-ratio: 4/3; }
 .collections-index[data-frame='scheme'] .collections-card__media { background: var(--nk-color-surface); }
 .collections-index .collections-card__title { overflow-wrap: anywhere; }
  .collections-index__header {
    display: grid;
    gap: 10px;
    padding-bottom: clamp(20px, 3vw, 32px);
    margin-bottom: clamp(28px, 4vw, 44px);
    border-bottom: 1px solid var(--nk-color-line);
  }

  .collections-index__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }

  .collections-index__title {
    margin: 0;
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    line-height: 0.96;
  }

  .collections-index__total {
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    color: var(--nk-color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .collections-index__grid {
    --collection-card-size: 300px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(var(--collection-card-size), 100%), 1fr));
    gap: var(--grid-gap, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collections--compact {
    --collection-card-size: 240px;
  }

  .collections--full {
    --collection-card-size: 320px;
  }

  .collections-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--nk-color-line);
    background: var(--nk-color-bg);
    color: var(--nk-color-text);
    text-decoration: none;
    transition:
      border-color 380ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 480ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collections-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--nk-color-line);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    color: var(--nk-color-text-muted);
  }

  .collections-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #fff;
  }

  .collections-card__media .collections-card__image {
    width: 100%;
    height: 100%;
  }

  .collections-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: clamp(12px, 2vw, 24px);
    transition: transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collections-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 20px;
    text-align: center;
  }

  .collections-card__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding: 16px 14px;
    border-top: 1px solid var(--nk-color-line);
  }

  .collections-card__meta {
    display: grid;
    gap: 4px;
  }

  .collections-card__title {
    margin: 0;
    font-family: var(--nk-font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .collections-card__desc {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .collections-card__arrow {
    font-size: 0.9375rem;
    line-height: 1;
    color: var(--nk-color-text-muted);
    transition:
      transform 360ms cubic-bezier(0.22, 1, 0.36, 1),
      color 260ms var(--nk-ease-out);
  }

  /* Hover is read from the static list item so the 3px lift never moves the card out from under
     a pointer resting on its bottom edge. */
  @media (hover: hover) and (pointer: fine) {
    .collections-index__grid > li:hover > .collections-card {
      border-color: var(--nk-color-text);
      transform: translateY(-3px);
    }

    .collections-index__grid > li:hover .collections-card__media img {
      transform: scale(1.045);
    }

    .collections-index__grid > li:hover .collections-card__arrow {
      transform: translate(2px, -2px);
      color: var(--nk-color-text);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "Card size",
      "options": [
        {
          "value": "collections--compact",
          "label": "Compact"
        },
        {
          "value": "collections--full",
          "label": "Large"
        }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Grid gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the translated collections title."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Directory"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Selected collections",
      "info": "Choose and reorder collections. Empty uses all store collections."
    },
    {
      "type": "range",
      "id": "page_size",
      "label": "Collections per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_empty",
      "label": "Show empty collections",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_index",
      "label": "Show index",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Entire image"
        },
        {
          "value": "cover",
          "label": "Fill and crop"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_frame",
      "label": "Image background",
      "options": [
        {
          "value": "studio",
          "label": "White studio"
        },
        {
          "value": "scheme",
          "label": "Scheme surface"
        }
      ],
      "default": "studio"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit",
      "info": "Sets the width of the image and text together. Background stays full width. All options keep the theme's responsive page gutters."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px. Custom values are exact and are not multiplied by the global smaller-screen spacing setting."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Collections grid"
    },
    {
      "name": "Curated collection directory",
      "settings": {
        "image_frame": "scheme",
        "image_ratio": "square"
      }
    }
  ]
}
{% endschema %}
