<section class="statistics full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-layout="{{ section.settings.layout }}" data-style="{{ section.settings.appearance }}" data-align="{{ section.settings.alignment }}" data-size="{{ section.settings.value_size }}" style="{% render 'section-presentation', presentation: section.settings %}--stats-cols:{{ section.settings.columns }};--stats-gap:{{ section.settings.gap }}px;">
  <div class="statistics__inner">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    <ul class="statistics__items" role="list">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          {% assign wrapper = 'div' %}{% if section.settings.animate %}{% assign wrapper = 'nk-reveal' %}{% endif %}
          <{{ wrapper }} class="statistics__metric" {% if section.settings.animate %}mode="fade"{% endif %}>
            <h3 class="spec">{{ block.settings.label | escape }}</h3>
            <p class="statistics__value">{{ block.settings.value | escape }}</p>
            {% if block.settings.text != blank %}<div class="rte text-muted">{{ block.settings.text }}</div>{% endif %}
          </{{ wrapper }}>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% stylesheet %}
 .statistics__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
 .statistics__inner > h2 { font-size: clamp(2rem, 4vw, 3.5rem); }
 .statistics__items { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--stats-gap, 24px); list-style: none; padding: 0; margin: 0; }
 .statistics__items li { min-width: 0; overflow-wrap: anywhere; }
 .statistics__metric { display: grid; gap: 16px; align-content: start; height: 100%; }
 .statistics__value { font-family: var(--nk-font-heading); font-size: clamp(2.5rem, 5vw, 5rem); line-height: 1.1; }
 .statistics[data-style='surface'] .statistics__metric { background: var(--nk-color-surface); padding: 24px; }
 .statistics[data-style='ruled'] .statistics__metric { border-top: 1px solid var(--nk-color-line); padding-top: 24px; }
 .statistics[data-align='center'] { text-align: center; }
 .statistics[data-size='compact'] .statistics__value { font-size: clamp(2rem, 4vw, 3.5rem); }
 .statistics[data-size='large'] .statistics__value { font-size: clamp(3rem, 7vw, 7rem); }
 @media (min-width: 750px) { .statistics__items { grid-template-columns: repeat(var(--stats-cols, 3), minmax(0, 1fr)); } }
 .statistics[data-layout='list'] .statistics__items { grid-template-columns: minmax(0, 1fr); }
{% endstylesheet %}

{% schema %}
{
  "name": "Statistics",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "By the numbers"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Card gap",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit",
      "info": "Sets the width of the image and text together. Background stays full width. All options keep the theme's responsive page gutters."
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px. Custom values are exact and are not multiplied by the global smaller-screen spacing setting."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "select",
      "id": "appearance",
      "label": "Appearance",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "ruled",
          "label": "Ruled"
        },
        {
          "value": "surface",
          "label": "Surface cards"
        }
      ],
      "default": "ruled"
    },
    {
      "type": "select",
      "id": "value_size",
      "label": "Value size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Regular"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "checkbox",
      "id": "animate",
      "label": "Subtle entrances",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Your metric"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "—",
          "info": "Enter verified figures. Text supports units, prefixes and localized number formatting without automatic parsing."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Explanation"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Statistics",
      "blocks": [
        {
          "type": "metric"
        },
        {
          "type": "metric"
        },
        {
          "type": "metric"
        }
      ]
    },
    {
      "name": "Metric cards",
      "settings": {
        "appearance": "surface",
        "alignment": "center"
      },
      "blocks": [
        {
          "type": "metric"
        },
        {
          "type": "metric"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
