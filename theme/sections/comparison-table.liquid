{%- comment -%}
  Compare up to four products, fabrics or plans feature by feature. Adapted from HyperUI application/tables #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
{%- liquid
  assign columns = 2
  if section.settings.column_3 != blank
    assign columns = 3
  endif
  if section.settings.column_3 != blank and section.settings.column_4 != blank
    assign columns = 4
  endif
-%}
<section class="comparison-table kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-highlight="{{ section.settings.highlight }}" data-style="{{ section.settings.appearance }}" data-sticky="{{ section.settings.sticky_first }}" data-mark="{{ section.settings.mark_style }}" data-size="{{ section.settings.text_size }}" data-head="{{ section.settings.header_style }}" style="{% render 'section-presentation', presentation: section.settings %}">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="comparison-table__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <div class="comparison-table__scroll" role="region" aria-label="{{ section.settings.heading | default: section.settings.feature_label | escape }}" tabindex="0">
      <table class="comparison-table__table">
        <thead>
          <tr>
            <th scope="col">{{ section.settings.feature_label | escape }}</th>
            {%- for i in (1..columns) -%}{%- assign key = 'column_' | append: i -%}<th scope="col" class="comparison-table__col-{{ i }}">{{ section.settings[key] | escape }}</th>{%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature | escape }}{%- if block.settings.note != blank -%}<span class="comparison-table__note text-muted">{{ block.settings.note | escape }}</span>{%- endif -%}</th>
              {%- for i in (1..columns) -%}
                {%- liquid
                  assign key = 'value_' | append: i
                  assign value = block.settings[key] | strip
                  assign normalized = value | downcase
                -%}
                <td class="comparison-table__col-{{ i }}">
                  {%- if normalized == 'yes' -%}
                    <span class="comparison-table__yes" aria-hidden="true">{% render 'section-icon', name: 'check' %}<span class="comparison-table__word">{{ 'sections.comparison.included' | t }}</span></span><span class="visually-hidden">{{ 'sections.comparison.included' | t }}</span>
                  {%- elsif normalized == 'no' or value == blank -%}
                    <span aria-hidden="true" class="text-muted comparison-table__no">—</span><span class="visually-hidden">{{ 'sections.comparison.not_included' | t }}</span>
                  {%- else -%}
                    {{ value | escape }}
                  {%- endif -%}
                </td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
    {%- if section.settings.footnote != blank -%}<div class="rte text-muted comparison-table__footnote">{{ section.settings.footnote }}</div>{%- endif -%}
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.comparison-table__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
/* position: relative keeps the cells' visually-hidden labels inside the scroll box on phones. */
.comparison-table__scroll { position: relative; overflow-x: auto; border-radius: var(--kit-radius); }
.comparison-table[data-style='boxed'] .comparison-table__scroll { border: 1px solid var(--nk-color-line); }
.comparison-table__table { width: 100%; min-width: 520px; border-collapse: collapse; font-size: 0.9375rem; }
.comparison-table[data-size='small'] .comparison-table__table { font-size: 0.8125rem; }
.comparison-table[data-size='large'] .comparison-table__table { font-size: 1.0625rem; }
.comparison-table__table th, .comparison-table__table td { padding: 14px 16px; border-bottom: 1px solid var(--nk-color-line); text-align: start; vertical-align: middle; }
.comparison-table__table tbody tr:last-child > * { border-bottom: 0; }
.comparison-table__table td { text-align: center; }
.comparison-table__table thead th { font-family: var(--nk-font-spec); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; }
.comparison-table[data-head='heading'] .comparison-table__table thead th { font-family: var(--nk-font-heading); font-size: 1.25rem; letter-spacing: 0; text-transform: none; font-weight: 400; }
.comparison-table__table thead th:not(:first-child) { text-align: center; }
.comparison-table__table tbody th { font-weight: 500; }
.comparison-table__note { display: block; font-size: 0.8125rem; font-weight: 400; }
.comparison-table__yes { display: inline-flex; align-items: center; justify-content: center; gap: 6px; color: var(--nk-color-accent); }
.comparison-table__yes svg { width: 20px; height: 20px; }
.comparison-table__word { display: none; color: var(--nk-color-text); }
.comparison-table[data-mark='word'] .comparison-table__yes svg { display: none; }
.comparison-table[data-mark='word'] .comparison-table__word { display: inline; }
.comparison-table[data-mark='dot'] .comparison-table__yes svg { display: none; }
.comparison-table[data-mark='dot'] .comparison-table__yes::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: currentColor; }
.comparison-table[data-style='striped'] tbody tr:nth-child(odd) { background: var(--nk-color-surface); }
.comparison-table[data-highlight='1'] .comparison-table__col-1, .comparison-table[data-highlight='2'] .comparison-table__col-2, .comparison-table[data-highlight='3'] .comparison-table__col-3, .comparison-table[data-highlight='4'] .comparison-table__col-4 { background: color-mix(in srgb, var(--nk-color-accent) 9%, var(--nk-color-bg)); font-weight: 600; }
.comparison-table[data-sticky='true'] .comparison-table__table tr > :first-child { position: sticky; inset-inline-start: 0; z-index: 1; background: var(--nk-color-bg); }
.comparison-table[data-sticky='true'][data-style='striped'] tbody tr:nth-child(odd) > :first-child { background: var(--nk-color-surface); }
.comparison-table__footnote { font-size: 0.8125rem; }
{% endstylesheet %}

