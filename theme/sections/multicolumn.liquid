{%- comment -%}
  Columns of image or icon, title, text and link. Adapted from Shopify Dawn sections/multicolumn.liquid.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="multicolumn kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-align="{{ section.settings.alignment }}" data-card="{{ section.settings.card_style }}" data-image-width="{{ section.settings.image_width }}" data-title="{{ section.settings.title_size }}" style="{% render 'section-presentation', presentation: section.settings %}--multicolumn-cols:{{ section.settings.columns }};--multicolumn-cols-mobile:{{ section.settings.columns_mobile }};--multicolumn-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="multicolumn__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="multicolumn__list" role="list">
      {%- for block in section.blocks -%}
        <li class="multicolumn__item kit-card"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="multicolumn__media kit-media" data-ratio="{{ section.settings.image_ratio }}"{% if section.settings.hover_zoom %} data-zoom{% endif %}>{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '275, 550, 720, 1000, 1200', sizes: '(min-width: 990px) 33vw, 50vw', class: 'multicolumn__image' }}</div>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="multicolumn__icon">{% render 'section-icon', name: block.settings.icon %}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="multicolumn__title">{{ block.settings.title | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link != blank -%}<a class="kit-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.button_label != blank -%}
      <div class="kit-buttons multicolumn__footer">{% render 'nk-button', label: section.settings.button_label, link: section.settings.button_link, style: section.settings.button_style %}</div>
    {%- endif -%}
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.multicolumn__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.multicolumn__list { display: grid; grid-template-columns: repeat(var(--multicolumn-cols-mobile, 1), minmax(0, 1fr)); gap: var(--multicolumn-gap, 32px); list-style: none; margin: 0; padding: 0; }
.multicolumn__item { display: grid; gap: 12px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
.multicolumn[data-image-width='half'] .multicolumn__media { width: 50%; }
.multicolumn[data-image-width='icon'] .multicolumn__media { width: 72px; }
.multicolumn__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--nk-color-surface); color: var(--nk-color-accent); }
.multicolumn[data-card='surface'] .multicolumn__icon { background: var(--nk-color-bg); }
.multicolumn__icon svg { width: 26px; height: 26px; }
.multicolumn__title { font-size: 1.25rem; }
.multicolumn[data-title='small'] .multicolumn__title { font-size: 1rem; }
.multicolumn[data-title='large'] .multicolumn__title { font-size: clamp(1.4rem, 2.5vw, 1.75rem); }
.multicolumn[data-align='center'] .multicolumn__item { text-align: center; justify-items: center; }
.multicolumn[data-align='center'] .multicolumn__footer { justify-content: center; }
@media (min-width: 990px) { .multicolumn__list { grid-template-columns: repeat(var(--multicolumn-cols, 3), minmax(0, 1fr)); } }
{% endstylesheet %}

