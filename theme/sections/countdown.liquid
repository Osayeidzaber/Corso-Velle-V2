{%- comment -%}
  Sale / drop countdown to a date in the shop time zone. Rolling digits adapted from daisyUI countdown; script in src/components/countdown.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
{%- liquid
  assign end_time = section.settings.end_time | default: '00:00'
  assign ends_at = section.settings.end_date | append: 'T' | append: end_time | append: ':00'
-%}
<section class="countdown kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-style="{{ section.settings.appearance }}" data-align="{{ section.settings.alignment }}" data-layout="{{ section.settings.layout }}" data-labels="{{ section.settings.show_labels }}" data-separator="{{ section.settings.separators }}" data-days="{{ section.settings.show_days }}" data-accent="{{ section.settings.accent_digits }}" style="{% render 'section-presentation', presentation: section.settings %}--countdown-size:{{ section.settings.digit_size }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="countdown__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <div class="countdown__body">
      <nk-countdown class="countdown__timer" ends-at="{{ ends_at | escape }}" utc-offset="{{ 'now' | date: '%z' }}" {% if section.settings.hide_when_ended %}hide-ended{% endif %}>
        <div class="countdown__clock" data-ref="clock" aria-hidden="true">
          <div class="countdown__unit countdown__unit--days"><span class="countdown__digits"><span data-ref="days" style="--value:0;">00</span></span><span class="countdown__label">{{ 'sections.countdown.days' | t }}</span></div>
          <div class="countdown__unit countdown__unit--hours"><span class="countdown__digits"><span data-ref="hours" style="--value:0;">00</span></span><span class="countdown__label">{{ 'sections.countdown.hours' | t }}</span></div>
          <div class="countdown__unit countdown__unit--minutes"><span class="countdown__digits"><span data-ref="minutes" style="--value:0;">00</span></span><span class="countdown__label">{{ 'sections.countdown.minutes' | t }}</span></div>
          <div class="countdown__unit countdown__unit--seconds"><span class="countdown__digits"><span data-ref="seconds" style="--value:0;">00</span></span><span class="countdown__label">{{ 'sections.countdown.seconds' | t }}</span></div>
        </div>
        {%- if section.settings.end_date != blank and section.settings.show_date -%}
          {%- assign ends_label = section.settings.end_date | append: ' ' | append: end_time -%}
          <p class="countdown__date spec text-muted">{{ 'sections.countdown.ends_on' | t: date: ends_label }}</p>
        {%- endif -%}
        <p class="countdown__ended" data-ref="ended" hidden>{%- if section.settings.ended_message != blank -%}{{ section.settings.ended_message | escape }}{%- else -%}{{ 'sections.countdown.ended' | t }}{%- endif -%}</p>
      </nk-countdown>
      {%- assign button_blocks = section.blocks | where: 'type', 'button' -%}
      {%- if button_blocks.size > 0 -%}
        <div class="kit-buttons">
          {%- for block in button_blocks -%}<div {{ block.shopify_attributes }}>{% render 'nk-button', label: block.settings.label, link: block.settings.link, style: block.settings.style, new_tab: block.settings.new_tab %}</div>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.countdown__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
.countdown__body { display: grid; gap: 24px; }
.countdown__timer { display: grid; gap: 12px; }
.countdown__clock { display: flex; flex-wrap: wrap; gap: 8px; }
.countdown__unit { position: relative; display: grid; gap: 6px; justify-items: center; min-width: 64px; }
.countdown[data-style='boxes'] .countdown__unit { padding: 14px 8px; background: var(--nk-color-surface); border-radius: var(--kit-radius); }
.countdown[data-style='outline'] .countdown__unit { padding: 14px 8px; border: 1px solid var(--nk-color-line); border-radius: var(--kit-radius); }
.countdown[data-style='inverted'] .countdown__unit { padding: 14px 8px; background: var(--nk-color-text); color: var(--nk-color-bg); border-radius: var(--kit-radius); }
.countdown[data-style='inverted'] .countdown__label { color: inherit; opacity: 0.7; }
.countdown__digits { font-family: var(--nk-font-heading); font-size: clamp(2rem, 9vw, var(--countdown-size, 72px)); line-height: 1; font-variant-numeric: tabular-nums; }
.countdown[data-accent='true'] .countdown__digits { color: var(--nk-color-accent); }
.countdown__label { font-family: var(--nk-font-spec); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nk-color-text-muted); }
.countdown[data-labels='false'] .countdown__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
.countdown[data-days='false'] .countdown__unit--days { display: none; }
.countdown[data-separator='true'] .countdown__unit:not(:last-child)::after { content: ':'; position: absolute; inset-inline-end: -7px; top: 0.1em; font-family: var(--nk-font-heading); font-size: clamp(1.5rem, 6vw, calc(var(--countdown-size, 72px) * 0.7)); color: var(--nk-color-text-muted); }
.countdown[data-separator='true'] .countdown__clock { gap: 14px; }
.countdown__ended { margin: 0; font-family: var(--nk-font-heading); font-size: 1.5rem; }
.countdown[data-align='center'] .countdown__clock, .countdown[data-align='center'] .kit-buttons { justify-content: center; }
.countdown[data-align='center'] .countdown__timer, .countdown[data-align='center'] .countdown__body { justify-items: center; text-align: center; }
@media (min-width: 750px) { .countdown__clock { gap: 12px; } .countdown__unit { min-width: 96px; } .countdown[data-separator='true'] .countdown__clock { gap: 20px; } .countdown[data-separator='true'] .countdown__unit:not(:last-child)::after { inset-inline-end: -14px; } }
@media (min-width: 990px) {
  .countdown[data-layout='inline'] .countdown__inner { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 48px; }
  .countdown[data-layout='inline'] .countdown__body { justify-items: end; text-align: end; }
  .countdown[data-layout='inline'] .kit-intro { justify-self: start; text-align: start; }
}
{% endstylesheet %}

{% schema %}
{
