    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Aspect ratio",
      "options": [
        {
          "value": "landscape",
          "label": "16:9"
        },
        {
          "value": "cinema",
          "label": "Cinema 21:9"
        },
        {
          "value": "classic",
          "label": "4:3"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait 9:16"
