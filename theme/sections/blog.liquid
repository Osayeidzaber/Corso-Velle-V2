{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

{% assign journal = section.settings.blog_source | default: blog %}
<div class="section-spacing journal color-{{ section.settings.color_scheme }}" data-layout="{{ section.settings.layout }}">
  <div class="collection-header">
    <h1 class="display">{{ section.settings.heading | default: journal.title | escape }}</h1>
  </div>

  {% paginate journal.articles by section.settings.per_page %}
    <ul class="product-grid" role="list" style="--nk-cols-desktop:{{ section.settings.columns }};--nk-cols-mobile:{{ section.settings.columns_mobile }};">
      {% for article in journal.articles %}
        <li>
          <article class="card">
            {% if article.image and section.settings.show_images != false %}
              <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                {%- assign article_image_alt = article.image.alt | default: article.title -%}
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: article_image_alt }}
              </a>
            {% endif %}
            {% render 'article-meta', article: article, show_date: section.settings.show_date, show_author: section.settings.show_author %}
            <h2 class="card__heading">
              <a class="card__title" href="{{ article.url }}">{{ article.title | escape }}</a>
            </h2>
            {% if article.excerpt != blank and section.settings.show_excerpt != false %}
              <div class="text-muted">{{ article.excerpt }}</div>
            {% endif %}
          </article>
        </li>
      {% endfor %}
    </ul>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {% endpaginate %}
</div>

{% stylesheet %}
  .journal[data-layout='list'] .product-grid { grid-template-columns: minmax(0, 1fr); }
  .journal[data-layout='list'] .card { grid-template-columns: minmax(80px, 28%) minmax(0, 1fr); gap: 12px 24px; }
  .journal[data-layout='list'] .card > :not(.card__media) { grid-column: 2; }
  .journal[data-layout='list'] .card__media { grid-row: 1 / span 4; }
  .journal[data-layout='list'] .card:not(:has(.card__media)) { grid-template-columns: minmax(0, 1fr); }
  .journal[data-layout='list'] .card:not(:has(.card__media)) > * { grid-column: 1; }
  @media (min-width: 750px) { .journal[data-layout='editorial'] .product-grid > li:first-child { grid-column: span 2; } }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "blog",
      "id": "blog_source",
      "label": "Blog source override"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "list",
          "label": "List"
        },
        {
          "value": "editorial",
          "label": "Editorial first story"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Phone columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "Show images",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "limit": 1,
  "enabled_on": {
    "templates": [
      "blog"
    ]
  }
}
{% endschema %}
