{% comment %}
  This section is used in the blog template to render the blog page listing all
  articles within a blog.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/blog
{% endcomment %}

<div class="section-spacing">
  <div class="collection-header">
    <h1 class="display">{{ blog.title }}</h1>
  </div>

  {% paginate blog.articles by 12 %}
    <ul class="product-grid" role="list">
      {% for article in blog.articles %}
        <li>
          <article class="card">
            {% if article.image %}
              <a class="card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
                {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 750px) 33vw, 100vw', alt: article.image.alt }}
              </a>
            {% endif %}
            {% assign date = article.published_at | time_tag: format: 'date' %}
            <p class="spec text-muted">{{ 'blog.article_metadata_html' | t: date: date, author: article.author }}</p>
            <h2 class="card__heading">
              <a class="card__title" href="{{ article.url }}">{{ article.title | escape }}</a>
            </h2>
            {% if article.excerpt != blank %}
              <div class="text-muted">{{ article.excerpt }}</div>
            {% endif %}
          </article>
        </li>
      {% endfor %}
    </ul>

    {%- if paginate.pages > 1 -%}
      {% render 'pagination', paginate: paginate %}
    {%- endif -%}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "t:general.blog",
  "settings": []
}
{% endschema %}
