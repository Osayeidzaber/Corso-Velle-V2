{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="section-spacing utility-page color-{{ section.settings.color_scheme }}" data-width="{{ section.settings.width }}">
  {% if section.settings.show_logo and settings.logo %}{{ settings.logo | image_url: width: 320 | image_tag: alt: shop.name, loading: 'eager' }}{% endif %}
  <div class="collection-header">
    <h1 class="display">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'password.title' | t }}{% endif %}</h1>
  </div>

  {% if shop.password_message %}
    <p class="text-muted" style="margin-bottom: 20px;">{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password', class: 'search-page__form' %}
    {% if form.errors %}
      <div class="message message--error" style="width: 100%;">{{ form.errors | default_errors }}</div>
    {% endif %}

    <label class="visually-hidden" for="PasswordInput-{{ section.id }}">
      {{ 'password.password' | t }}
    </label>

    <input type="password" name="password" id="PasswordInput-{{ section.id }}" placeholder="{{ 'password.password' | t }}" style="flex: 1 1 220px; min-height: 54px; padding: 0 16px; border: 1px solid var(--nk-color-line); background: transparent;">

    <button type="submit" class="button">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
  {% if section.settings.show_newsletter %}
    <div class="utility-page__signup"><h2>{{ section.settings.newsletter_heading | escape }}</h2>
      {% assign newsletter_id = 'PasswordNewsletter-' | append: section.id %}
      {% render 'newsletter-form', id: newsletter_id, class: 'newsletter-form' %}
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow reading width"
        },
        {
          "value": "regular",
          "label": "Regular reading width"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": false
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in touch"
    }
  ],
  "limit": 1,
  "enabled_on": {
    "templates": [
      "password"
    ]
  }
}
{% endschema %}
