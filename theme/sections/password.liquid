{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="section-spacing">
  <div class="collection-header">
    <h1 class="display">{{ 'password.title' | t }}</h1>
  </div>

  {% if shop.password_message %}
    <p class="text-muted" style="margin-bottom: 20px;">{{ shop.password_message }}</p>
  {% endif %}

  {% form 'storefront_password', class: 'search-page__form' %}
    {% if form.errors %}
      <div class="message message--error" style="width: 100%;">{{ form.errors | default_errors }}</div>
    {% endif %}

    <label class="visually-hidden" for="password-input">
      {{ 'password.password' | t }}
    </label>

    <input type="password" name="password" id="password-input" placeholder="{{ 'password.password' | t }}" style="flex: 1 1 220px; min-height: 54px; padding: 0 16px; border: 1px solid var(--nk-color-line); background: transparent;">

    <button type="submit" class="button">
      {{ 'password.enter' | t }}
    </button>
  {% endform %}
</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
