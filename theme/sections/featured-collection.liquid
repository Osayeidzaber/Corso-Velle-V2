{%- comment -%}
  Featured collection (master-plan/10 CS-03): bounded product grid using the shared card.
  In the editor an empty collection shows placeholder cards; on the storefront it renders nothing.
{%- endcomment -%}
{%- assign featured = section.settings.collection -%}
{%- if featured.products.size > 0 or request.design_mode -%}
  <div class="section-spacing color-{{ section.settings.color_scheme }} full-width">
    <div style="width: var(--content-width); margin-inline: auto;">
      <div class="collection-header">
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if featured != blank and section.settings.show_view_all -%}
          <a class="spec" href="{{ featured.url }}">{{ 'collection.view_all' | t }}</a>
        {%- endif -%}
      </div>

      <ul
        class="product-grid"
        role="list"
        style="--nk-cols-mobile: {{ section.settings.columns_mobile }}; --nk-cols-desktop: {{ section.settings.columns_desktop }};"
      >
        {%- if featured.products.size > 0 -%}
          {%- for product in featured.products limit: section.settings.limit -%}
            <li>{% render 'product-card', product: product %}</li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>
              <article class="card">
                <span class="card__media">{{ 'product-1' | placeholder_svg_tag }}</span>
                <p class="card__title">{{ 'collection.placeholder_product' | t }}</p>
              </article>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "class": "featured-collection-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Featured collection" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
