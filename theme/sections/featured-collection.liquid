{%- comment -%}
  Featured collection (master-plan/10 CS-03): signature editorial product grid showcase with
  eyebrow, italic heading accent, live piece count, optional description, and staggered card reveals.
  In the editor an empty collection shows placeholder cards; on the storefront it renders nothing.
{%- endcomment -%}
{%- assign featured = section.settings.collection -%}
{%- if featured.products.size > 0 or request.design_mode -%}
  {%- liquid
    assign eyebrow = section.settings.eyebrow
    if eyebrow == blank and featured != blank
      assign eyebrow = 'Featured drop'
    endif
    assign total_count = featured.all_products_count | default: featured.products_count | default: 0
    assign description = section.settings.description
    if description == blank and section.settings.show_collection_description and featured.description != blank
      assign description = featured.description | strip_html | truncatewords: 28
    endif
  -%}
  <div class="featured-collection section-spacing color-{{ section.settings.color_scheme }} full-width">
    <div class="featured-collection__inner">
      <div class="featured-collection__header">
        <div class="featured-collection__title-group">
          {%- if eyebrow != blank -%}
            <nk-reveal mode="fade">
              <span class="eyebrow">{{ eyebrow | escape }}</span>
            </nk-reveal>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            {%- liquid
              assign heading_html = section.settings.heading | escape
              assign italic = section.settings.heading_italic | escape
            -%}
            <div class="featured-collection__title-row">
              {% render 'reveal-heading', text: heading_html, italic: italic, entrance: 'cut', class: 'display featured-collection__heading' %}
              {%- if total_count > 0 -%}
                <span class="featured-collection__count spec">({{ total_count }})</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if description != blank -%}
            <nk-reveal mode="fade" delay="0.1">
              <p class="featured-collection__desc text-muted">{{ description | escape }}</p>
            </nk-reveal>
          {%- endif -%}
        </div>

        {%- if featured != blank and section.settings.show_view_all -%}
          <nk-reveal mode="fade" delay="0.14">
            <a class="button button--secondary featured-collection__cta" href="{{ featured.url }}" data-magnetic>
              {{- 'collection.view_all' | t }}{% if total_count > 0 %} ({{ total_count }}){% endif %} →
            </a>
          </nk-reveal>
        {%- endif -%}
      </div>

      {%- if section.settings.layout == 'carousel' -%}
        <nk-carousel
          id="Carousel-{{ section.id }}"
          class="product-carousel"
          data-effect="{{ section.settings.carousel_effect | default: 'liquid' }}"
          data-intro="{{ section.settings.carousel_intro | default: 'rise' }}"
          data-canvas-label="{{ 'carousel.canvas_label' | t | escape }}"
          data-sold-out-label="{{ 'product.sold_out' | t | escape }}"
          data-select-size-label="{{ 'product.select_size_prompt' | t | escape }}"
          {% if section.settings.carousel_autoplay %}data-autoplay{% endif %}
          speed="{{ section.settings.carousel_speed }}"
          role="region"
          aria-roledescription="carousel"
          aria-label="{{ section.settings.heading | default: featured.title | escape }}"
        >
          <div class="product-carousel__viewport" data-ref="viewport">
            <ul class="product-carousel__track" data-ref="track" role="list">
              {%- for product in featured.products limit: section.settings.limit -%}
                <li class="product-carousel__slide">
                  {%- render 'product-card', product: product, actions: false, sizes: '(min-width: 990px) 28vw, (min-width: 600px) 44vw, 82vw' -%}
                  {%- render 'carousel-product-data', product: product -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
          {%- comment -%}
            Size selector and one Add to cart button for whichever product is highlighted.
            The button stays disabled until a size is chosen (JS fills the sizes from the product data).
          {%- endcomment -%}
          <div class="product-carousel__purchase">
            <div class="product-carousel__sizes" data-ref="sizes" role="radiogroup" aria-labelledby="CarouselSizes-{{ section.id }}" hidden>
              <span class="product-carousel__sizes-label spec" id="CarouselSizes-{{ section.id }}" data-ref="sizes-label">{{ 'product.size' | t }}</span>
              <div class="product-carousel__size-options" data-size-options></div>
              <span class="product-carousel__sizes-context spec text-muted" data-ref="sizes-context" hidden></span>
            </div>
            <button type="button" class="button product-carousel__add" data-ref="add" data-index="0" disabled>
              <span class="product-carousel__add-label" data-add-label>{{ 'product.select_size_prompt' | t }}</span>
              <span class="product-carousel__add-product" data-add-product aria-hidden="true"></span>
            </button>
            <p class="product-carousel__purchase-status" data-ref="purchase-status" role="status" aria-live="polite"></p>
          </div>
          <div class="product-carousel__controls">
            <span class="spec text-muted">{{ 'carousel.hint' | t }}</span>
            <div class="product-carousel__buttons">
              <button type="button" class="icon-button" data-carousel-step="-1" aria-label="{{ 'carousel.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
              <button type="button" class="product-carousel__pause spec" data-carousel-pause data-play-label="{{ 'carousel.play' | t }}" data-pause-label="{{ 'carousel.pause' | t }}" aria-pressed="false" hidden><span data-carousel-pause-label>{{ 'carousel.pause' | t }}</span></button>
              <button type="button" class="icon-button" data-carousel-step="1" aria-label="{{ 'carousel.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
            </div>
          </div>
        </nk-carousel>
      {%- else -%}
      <nk-stagger>
        <ul
          class="product-grid"
          role="list"
          style="--nk-cols-mobile: {{ section.settings.columns_mobile }}; --nk-cols-desktop: {{ section.settings.columns_desktop }};"
        >
          {%- if featured.products.size > 0 -%}
            {%- for product in featured.products limit: section.settings.limit -%}
              <li data-stagger-item>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li data-stagger-item>
                <article class="card">
                  <span class="card__media">{{ 'product-1' | placeholder_svg_tag }}</span>
                  <p class="card__title">{{ 'collection.placeholder_product' | t }}</p>
                </article>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </nk-stagger>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .featured-collection__inner {
    width: var(--content-width);
    margin-inline: auto;
  }

  .featured-collection__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px 32px;
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--nk-color-line);
  }

  .featured-collection__title-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 64ch;
    min-width: 0;
  }

  .featured-collection__title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
    min-width: 0;
  }

  .featured-collection__heading {
    margin: 0;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
  }

  .featured-collection__count {
    flex-shrink: 0;
    color: var(--nk-color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .featured-collection__desc {
    margin: 4px 0 0;
    max-width: 54ch;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .featured-collection__cta {
    min-height: 46px;
    padding-inline: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured collection",
  "class": "featured-collection-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured drop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New in" },
    { "type": "text", "id": "heading_italic", "label": "Heading (italic part)" },
    { "type": "text", "id": "description", "label": "Description" },
    { "type": "checkbox", "id": "show_collection_description", "label": "Use collection description when empty", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Product carousel" }], "default": "grid" },
    { "type": "select", "id": "carousel_effect", "label": "Carousel style", "options": [{ "value": "liquid", "label": "Editorial strip" }, { "value": "native", "label": "Classic product rail" }], "default": "liquid", "info": "Phones and tablets use a lightweight swipe rail.", "visible_if": "{{ section.settings.layout == 'carousel' }}" },
    { "type": "select", "id": "carousel_intro", "label": "Carousel entrance", "options": [{ "value": "rise", "label": "Rise" }, { "value": "bloom", "label": "Bloom" }, { "value": "deal", "label": "Spread" }, { "value": "none", "label": "None" }], "default": "rise", "visible_if": "{{ section.settings.layout == 'carousel' and section.settings.carousel_effect == 'liquid' }}" },
    { "type": "checkbox", "id": "carousel_autoplay", "label": "Advance products automatically", "default": true, "info": "Pauses while a shopper hovers, drags, focuses the strip or chooses a size.", "visible_if": "{{ section.settings.layout == 'carousel' and section.settings.carousel_effect == 'liquid' }}" },
    { "type": "range", "id": "carousel_speed", "label": "Carousel speed", "min": 10, "max": 80, "step": 5, "default": 35, "unit": "px" },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on phones",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'View all' button", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Featured collection" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
