{%- comment -%}
  Copy, benefits and an optional image beside an email signup. Adapted from HyperUI marketing/newsletter-signup #1; uses snippets/newsletter-form.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="newsletter-split kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-layout="{{ section.settings.layout }}" data-card="{{ section.settings.card_style }}" data-image="{% if section.settings.image != blank %}{{ section.settings.image_position }}{% else %}none{% endif %}" data-align="{{ section.settings.alignment }}" data-form="{{ section.settings.form_style }}" data-form-button="{{ section.settings.form_button }}" data-privacy="{{ section.settings.show_privacy }}" style="{% render 'section-presentation', presentation: section.settings %}--kit-form-width:{{ section.settings.form_width }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="newsletter-split__inner kit-card">
    {%- if section.settings.image != blank -%}
      <div class="newsletter-split__media kit-media" data-ratio="{{ section.settings.image_ratio }}">{{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900, 1200', sizes: '(min-width: 990px) 33vw, 100vw' }}</div>
    {%- endif -%}
    <div class="newsletter-split__copy">
      {%- if section.settings.heading != blank -%}<h2 class="kit-display kit-display--{{ section.settings.heading_display }}">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="rte text-muted">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="newsletter-split__benefits" role="list">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{% render 'section-icon', name: block.settings.icon %}<span>{{ block.settings.text | escape }}</span></li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    <div class="newsletter-split__form kit-form">{%- assign form_id = 'NewsletterSplit-' | append: section.id -%}{% render 'newsletter-form', id: form_id, class: 'newsletter-form' %}</div>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.newsletter-split__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; align-items: center; }
.newsletter-split[data-card='plain'] .newsletter-split__inner { padding: 0; }
.newsletter-split__copy { display: grid; gap: 14px; min-width: 0; overflow-wrap: anywhere; }
.newsletter-split__benefits { display: grid; gap: 8px; list-style: none; margin: 0; padding: 0; }
.newsletter-split__benefits li { display: flex; gap: 8px; align-items: start; text-align: start; }
.newsletter-split__benefits svg { flex: none; width: 20px; height: 20px; color: var(--nk-color-accent); }
.newsletter-split[data-align='center'] .newsletter-split__inner { text-align: center; justify-items: center; }
.newsletter-split[data-align='center'] .newsletter-split__benefits { justify-items: center; }
@media (min-width: 990px) {
  .newsletter-split[data-layout='split'] .newsletter-split__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; }
  .newsletter-split[data-layout='split'] .newsletter-split__media { display: none; }
  .newsletter-split[data-layout='split'][data-image='left'] .newsletter-split__inner, .newsletter-split[data-layout='split'][data-image='right'] .newsletter-split__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px; }
  .newsletter-split[data-layout='split'][data-image='left'] .newsletter-split__media, .newsletter-split[data-layout='split'][data-image='right'] .newsletter-split__media { display: block; }
  .newsletter-split[data-layout='split'][data-image='right'] .newsletter-split__media { order: 3; }
  .newsletter-split[data-layout='stacked'] .newsletter-split__media { max-width: 480px; }
}
{% endstylesheet %}

