{%- comment -%}
  Campaign hero (master-plan/10 CS-01, Riviera board 16). Styles: src/styles/components/hero.css.
  Media priority: Shopify video → video URL (+ poster) → image → collection image.
  Media drifts with GSAP parallax (<nk-parallax>). Headline: Split Text rise with hover lift and a
  Gradient Text italic tail (<nk-text>); eyebrow: Shiny Text; intro copy: Text Effect blur.
  Scroll cue fades out as the page moves.

  Layouts: overlay (full-bleed, copy over media), editorial (full-bleed, magazine-cover grid),
  split (media beside a solid text panel). Entrances: fade-up, text (masked line reveal), zoom
  (media settles from a zoom), curtain (media unveils, copy follows), none. Media entrances are CSS
  keyed off html.nk-anim, which is only set while decorative motion is allowed; copy entrances
  are <nk-reveal>, which checks the same policy.
  Overlay-eligible (a transparent header can sit on top when it is the first section) unless the
  layout is split, where the header would land on the text panel.
  Type styles (hero--type-*) restyle the copy only: fonts, size, case and tracking. Custom fonts
  from the Fonts settings override the family of whichever type style is picked.
{%- endcomment -%}
{%- liquid
  assign type_style = section.settings.type_style | default: 'signature'
  assign custom_heading = section.settings.custom_heading_font
  assign custom_text = section.settings.custom_text_font
-%}
{%- if custom_heading or custom_text -%}
  <style>
    {%- if custom_heading -%}{{ section.settings.heading_font | font_face: font_display: 'swap' }}{% assign heading_italic_font = section.settings.heading_font | font_modify: 'style', 'italic' %}{% if heading_italic_font %}{{ heading_italic_font | font_face: font_display: 'swap' }}{% endif %}{%- endif -%}
    {%- if custom_text -%}{{ section.settings.text_font | font_face: font_display: 'swap' }}{%- endif -%}
  </style>
{%- endif -%}
{%- liquid
  assign desktop = section.settings.image | default: section.settings.collection.featured_image
  assign video = section.settings.video
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif

  assign layout = section.settings.layout | default: 'overlay'
  assign entrance = section.settings.entrance | default: 'fade-up'

  assign wrap = 'nk-reveal'
  assign copy_mode = 'fade'
  assign buttons_mode = 'fade'
  assign offset = 0
  case entrance
    when 'none'
      assign wrap = 'div'
    when 'text'
      assign copy_mode = 'split'
      assign buttons_mode = 'rise'
      assign offset = 0.08
    when 'zoom'
      assign offset = 0.3
    when 'curtain'
      assign copy_mode = 'cut'
      assign offset = 0.55
  endcase
  assign eyebrow_delay = 0.06 | plus: offset
  assign text_delay = 0.28 | plus: offset
  assign buttons_delay = 0.4 | plus: offset

  # Positions are "<vertical>-<horizontal>", or "center" for both.
  assign position_classes = ''
  assign positions = section.settings.position | default: 'bottom-left' | append: ',' | append: section.settings.position_mobile
  assign positions = positions | split: ','
  for pos in positions
    if pos == blank or pos == 'same'
      continue
    endif
    assign prefix = 'hero--'
    if forloop.index == 2
      assign prefix = 'hero--m'
    endif
    if pos == 'center'
      assign v = 'center'
      assign h = 'center'
    else
      assign parts = pos | split: '-'
      assign v = parts[0]
      assign h = parts[1]
    endif
    assign position_classes = position_classes | append: ' ' | append: prefix | append: 'v-' | append: v | append: ' ' | append: prefix | append: 'h-' | append: h
  endfor
  if section.settings.text_align != blank and section.settings.text_align != 'auto'
    assign position_classes = position_classes | append: ' hero--text-' | append: section.settings.text_align
  endif
-%}
<nk-scene
  preset="{% if section.settings.scroll_exit == false %}none{% else %}hero{% endif %}"
  class="hero full-width color-{{ section.settings.color_scheme }} hero--{{ layout }} hero--{{ section.settings.height }}{{ position_classes }} hero--media-{{ section.settings.media_position }} hero--enter-{{ entrance }} hero--phone-{{ section.settings.height_mobile }} hero--fit-{{ section.settings.media_fit }} hero--tint-{{ section.settings.tint_direction }} hero--type-{{ type_style }}{% if custom_heading %} hero--custom-heading{% endif %}{% if custom_text %} hero--custom-text{% endif %}"
  {% unless layout == 'split' %}
    data-overlay-eligible
  {% endunless %}
  style="--nk-scrim: {{ section.settings.scrim | divided_by: 100.0 }}; --hero-width: {{ section.settings.content_width | default: 1100 }}px; --hero-gap: {{ section.settings.block_gap | default: 22 }}px;{% if custom_heading %} --hero-custom-heading: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }}; --hero-custom-heading-weight: {{ section.settings.heading_font.weight }};{% endif %}{% if custom_text %} --hero-custom-text: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};{% endif %}"
>
  {%- liquid
    assign slides = section.blocks | where: 'type', 'slide'
    assign media_sizes = '100vw'
    if layout == 'split'
      assign media_sizes = '(min-width: 990px) 55vw, 100vw'
    endif
  -%}
  <nk-parallax class="hero__media" strength="{% if section.settings.media_fit == 'contain' %}0{% else %}{{ section.settings.parallax }}{% endif %}">
    <div class="hero__media-inner" data-parallax-media>
      {%- if slides.size > 0 -%}
        <nk-hero-slides
          class="hero__slides"
          data-interval="{{ section.settings.slide_interval }}"
          data-transition="{{ section.settings.slide_transition }}"
          {% if section.settings.slide_autoplay %}data-autoplay{% endif %}
        >
          {%- for block in slides -%}
            {%- liquid
              assign slide_first = false
              if is_first and forloop.first
                assign slide_first = true
              endif
            -%}
            <div class="hero__slide" data-slide data-block-id="{{ block.id }}" {% if forloop.first %}data-active{% endif %} {{ block.shopify_attributes }}>
              {% render 'hero-media',
                video: block.settings.video,
                video_url: block.settings.video_url,
                image: block.settings.image,
                video_mobile: block.settings.video_mobile,
                video_url_mobile: block.settings.video_url_mobile,
                image_mobile: block.settings.image_mobile,
                sizes: media_sizes,
                first: slide_first,
                autoplay: section.settings.video_autoplay
              %}
            </div>
          {%- endfor -%}
        </nk-hero-slides>
      {%- else -%}
        {% render 'hero-media',
          video: video,
          video_url: section.settings.video_url,
          poster: section.settings.poster_url,
          image: desktop,
          video_mobile: section.settings.video_mobile,
          video_url_mobile: section.settings.video_url_mobile,
          poster_mobile: section.settings.poster_url_mobile,
          image_mobile: section.settings.image_mobile,
          sizes: media_sizes,
          first: is_first,
          autoplay: section.settings.video_autoplay
        %}
      {%- endif -%}
    </div>
  </nk-parallax>
  {%- case section.settings.scrim_style -%}
    {%- when 'solid' -%}<span class="hero__scrim" aria-hidden="true"></span>
    {%- when 'blur' -%}<span class="nk-scrim-blur" aria-hidden="true"></span>
  {%- endcase -%}
  {%- if slides.size > 1 -%}
    <div class="hero__slide-controls" data-slides-controls{% if section.settings.slide_dots == false %} data-no-dots{% endif %}>
      <button type="button" class="hero__slide-arrow" data-slides-prev aria-label="{{ 'media.previous_slide' | t }}"><span aria-hidden="true">←</span></button>
      <div class="hero__slide-dots" role="group" aria-label="{{ 'media.slides' | t }}">
        {%- for block in slides -%}
          <button type="button" class="hero__slide-dot" data-slides-dot="{{ forloop.index0 }}" aria-label="{{ 'media.slide_n' | t: number: forloop.index, count: slides.size }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>
        {%- endfor -%}
      </div>
      <button type="button" class="hero__slide-arrow" data-slides-next aria-label="{{ 'media.next_slide' | t }}"><span aria-hidden="true">→</span></button>
      <button type="button" class="hero__slide-pause" data-slides-pause aria-label="{{ 'media.pause_slideshow' | t }}" data-pause-label="{{ 'media.pause_slideshow' | t }}" data-play-label="{{ 'media.play_slideshow' | t }}"{% unless section.settings.slide_autoplay %} hidden{% endunless %}><span aria-hidden="true">❚❚</span></button>
    </div>
  {%- endif -%}

  <div class="hero__content" data-scene-copy>
    <div class="hero__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <{{ wrap }}
              class="hero__block hero__block--eyebrow"
              style="--hero-eyebrow-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }};"
              {% if wrap == 'nk-reveal' %}
                mode="{{ copy_mode }}" delay="{{ eyebrow_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <p class="eyebrow hero__eyebrow">
                <span class="{% if block.settings.shine %}nk-text-shine{% endif %}">{{ block.settings.text | escape }}</span>
              </p>
            </{{ wrap }}>
          {%- when 'heading' -%}
            <div
              class="hero__block hero__block--heading"
              style="--hero-heading-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }}; --hero-heading-scale-mobile: {{ block.settings.size_mobile | default: 100 | divided_by: 100.0 }};"
              {{ block.shopify_attributes }}
            >
              {%- liquid
                assign heading_tag = 'h2'
                if is_first
                  assign heading_tag = 'h1'
                endif
                assign heading_html = block.settings.heading | escape
                assign italic = block.settings.heading_italic | escape
                assign heading_entrance = block.settings.entrance
                if entrance == 'none'
                  assign heading_entrance = 'none'
                endif
              -%}
              {% render 'reveal-heading',
                text: heading_html,
                italic: italic,
                italic_break: true,
                tag: heading_tag,
                entrance: heading_entrance,
                hover: block.settings.hover,
                italic_style: block.settings.italic_style,
                style: block.settings.text_style,
                class: 'hero__heading display',
                play_on_load: true
              %}
            </div>
          {%- when 'text' -%}
            <{{ wrap }}
              class="hero__block hero__block--text"
              style="--hero-text-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }}; --hero-text-width: {{ block.settings.width | default: 42 }}ch;"
              {% if wrap == 'nk-reveal' %}
                mode="{{ copy_mode }}" delay="{{ text_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="hero__text">{{ block.settings.text }}</div>
            </{{ wrap }}>
          {%- when 'buttons' -%}
            <{{ wrap }}
              class="hero__block hero__block--buttons"
              style="--hero-buttons-gap: {{ block.settings.gap | default: 14 }}px; --hero-buttons-offset: {{ block.settings.offset | default: 0 }}px;"
              {% if wrap == 'nk-reveal' %}
                mode="{{ buttons_mode }}" delay="{{ buttons_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="hero__buttons hero__buttons--align-{{ block.settings.alignment | default: 'auto' }} hero__buttons--{{ block.settings.arrangement | default: 'row' }}{% if block.settings.full_width_mobile %} hero__buttons--fill-mobile{% endif %}">
                {% render 'hero-button',
                  label: block.settings.label_1,
                  link: block.settings.link_1,
                  style: block.settings.style_1,
                  size: block.settings.size,
                  corners: block.settings.corners,
                  arrow: block.settings.arrow
                %}
                {% render 'hero-button',
                  label: block.settings.label_2,
                  link: block.settings.link_2,
                  style: block.settings.style_2,
                  size: block.settings.size,
                  corners: block.settings.corners,
                  arrow: false
                %}
              </div>
            </{{ wrap }}>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_scroll_cue -%}
      <span class="hero__cue" aria-hidden="true">
        <span class="hero__cue-label">{{ 'general.scroll' | t }}</span>
        <span class="hero__cue-line"></span>
      </span>
    {%- endif -%}
  </div>
</nk-scene>

{% schema %}
{
  "name": "Campaign hero",
  "class": "hero-section",
  "max_blocks": 16,
  "settings": [
    { "type": "checkbox", "id": "scroll_exit", "label": "Gentle scroll exit", "default": true, "info": "Copy subtly drifts and fades as the hero leaves. Full motion only; separate from the entrance setting." },
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted video. Plays muted." },
    { "type": "checkbox", "id": "video_autoplay", "label": "Autoplay background video", "default": true, "info": "Muted. Pauses offscreen and when hidden. Reduced motion and the editor require pressing Play. Native controls remain available without JavaScript." },
    { "type": "url", "id": "video_url", "label": "Video file URL", "info": "Optional MP4 address from Content › Files, used when no video is picked above." },
    { "type": "url", "id": "poster_url", "label": "Video poster image URL" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Also the video poster when no poster URL is set." },
    { "type": "collection", "id": "collection", "label": "Use collection image", "info": "Shown when no video or image is set." },
    { "type": "header", "content": "Phone media", "info": "Optional. Shown on screens under 750px instead of the media above, so a tall phone picture or video isn't cropped from a wide one." },
    { "type": "video", "id": "video_mobile", "label": "Phone video" },
    { "type": "url", "id": "video_url_mobile", "label": "Phone video file URL", "info": "Used when no phone video is picked above." },
    { "type": "url", "id": "poster_url_mobile", "label": "Phone video poster image URL" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image" },
    { "type": "header", "content": "Slideshow", "info": "Add Slide blocks to turn the media into a slideshow. Each slide can have its own desktop and phone image or video; the text and buttons stay the same." },
    { "type": "checkbox", "id": "slide_autoplay", "label": "Change slides automatically", "default": true, "info": "Visitors can pause it. Off for visitors who prefer reduced motion and in the theme editor." },
    { "type": "range", "id": "slide_interval", "label": "Time per slide", "min": 3, "max": 15, "step": 1, "unit": "s", "default": 6 },
    { "type": "select", "id": "slide_transition", "label": "Transition", "options": [{ "value": "fade", "label": "Crossfade" }, { "value": "zoom", "label": "Fade with slow zoom" }, { "value": "slide", "label": "Slide sideways" }], "default": "fade" },
    { "type": "checkbox", "id": "slide_dots", "label": "Show slide dots", "default": true },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "height_mobile", "label": "Height on phones", "options": [{ "value": "inherit", "label": "Use desktop choice" }, { "value": "compact", "label": "Compact (55% of screen)" }, { "value": "full", "label": "Full screen" }], "default": "inherit", "info": "Content can grow taller. Split layouts apply this to the image panel." },
    { "type": "select", "id": "media_fit", "label": "Media fit", "options": [{ "value": "cover", "label": "Fill and crop" }, { "value": "contain", "label": "Show entire image or video" }], "default": "cover", "info": "Show entire media disables parallax to avoid cropping. Set image focal points in Shopify's image picker." },
    { "type": "select", "id": "tint_direction", "label": "Tint distribution", "options": [{ "value": "bottom", "label": "Stronger at bottom" }, { "value": "top", "label": "Stronger at top" }, { "value": "uniform", "label": "Even tint" }], "default": "bottom" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Full-bleed, text over media" },
        { "value": "editorial", "label": "Editorial cover" },
        { "value": "split", "label": "Split, media beside text" }
      ],
      "default": "overlay",
      "info": "Editorial puts the heading bottom left with the text and buttons in a ruled column on the right. Split shows the media next to a solid panel in the color scheme."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media side (split layout)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "medium", "label": "Medium" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "center-left", "label": "Middle left" },
        { "value": "center", "label": "Center" },
        { "value": "center-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left",
      "info": "Used by the full-bleed and split layouts. Text aligns to the side you pick."
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "Content position on phones",
      "options": [
        { "value": "same", "label": "Same as desktop" },
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Middle left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "same"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "auto", "label": "Follow the position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "auto"
    },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 1400, "step": 20, "unit": "px", "default": 1100 },
    { "type": "range", "id": "block_gap", "label": "Space between blocks", "min": 8, "max": 56, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "parallax", "label": "Parallax depth", "min": 0, "max": 30, "step": 2, "unit": "%", "default": 14 },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": false },
    {
      "type": "select",
      "id": "scrim_style",
      "label": "Text backdrop",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Tint" },
        { "value": "blur", "label": "Progressive blur" }
      ],
      "default": "solid"
    },
    { "type": "range", "id": "scrim", "label": "Tint strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Typography" },
    {
      "type": "select",
      "id": "type_style",
      "label": "Type style",
      "options": [
        { "value": "signature", "label": "Signature: large display serif" },
        { "value": "quiet", "label": "Quiet: small and understated" },
        { "value": "lowercase", "label": "Nonchalant: relaxed lowercase" },
        { "value": "caption", "label": "Caption: tiny spaced capitals" },
        { "value": "poster", "label": "Poster: heavy capitals, outlined second line" },
        { "value": "romantic", "label": "Romantic: light italic serif" },
        { "value": "typewriter", "label": "Typewriter: monospace notes" },
        { "value": "classic", "label": "Classic caps: spaced serif capitals" },
        { "value": "mixed", "label": "Mixed: small sans over a big italic" }
      ],
      "default": "signature",
      "info": "Changes the fonts, size and case of the eyebrow, heading and text. The heading block's Size setting still scales it."
    },
    { "type": "checkbox", "id": "custom_heading_font", "label": "Use a custom heading font", "default": false },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "newsreader_n4", "visible_if": "{{ section.settings.custom_heading_font }}" },
    { "type": "checkbox", "id": "custom_text_font", "label": "Use a custom text font", "default": false },
    { "type": "font_picker", "id": "text_font", "label": "Text font", "default": "inter_n4", "visible_if": "{{ section.settings.custom_text_font }}" },
    { "type": "header", "content": "Animation" },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance",
      "options": [
        { "value": "fade-up", "label": "Fade up" },
        { "value": "text", "label": "Text reveal, line by line" },
        { "value": "zoom", "label": "Media zooms out" },
        { "value": "curtain", "label": "Media curtain, then text" },
        { "value": "none", "label": "None" }
      ],
      "default": "fade-up",
      "info": "Plays when the page loads. The heading keeps its own entrance unless this is None. Not shown to visitors who prefer reduced motion or when Motion is off."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 10,
      "settings": [
        { "type": "paragraph", "content": "Slide media. Text and buttons come from the section's other blocks." },
        { "type": "header", "content": "Desktop" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Also the video poster." },
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "url", "id": "video_url", "label": "Video file URL", "info": "Used when no video is picked." },
        { "type": "header", "content": "Phone" },
        { "type": "image_picker", "id": "image_mobile", "label": "Phone image", "info": "Optional. Uses the desktop media when empty." },
        { "type": "video", "id": "video_mobile", "label": "Phone video" },
        { "type": "url", "id": "video_url_mobile", "label": "Phone video file URL" }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New collection" },
        { "type": "checkbox", "id": "shine", "label": "Shine effect", "default": false },
        { "type": "range", "id": "size", "label": "Size", "min": 80, "max": 200, "step": 10, "unit": "%", "default": 100 }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Campaign" },
        { "type": "text", "id": "heading_italic", "label": "Second line (italic)" },
        { "type": "range", "id": "size", "label": "Size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
        { "type": "range", "id": "size_mobile", "label": "Size on phones", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
        { "type": "select", "id": "italic_style", "label": "Italic line style", "options": [{ "value": "none", "label": "Plain" }, { "value": "gradient", "label": "Flowing gradient (Gradient Text)" }], "default": "none" },
        {
          "type": "select",
          "id": "entrance",
          "label": "Entrance",
          "options": [
        { "value": "none", "label": "None" },
        { "value": "cut", "label": "Editorial masked reveal" },
