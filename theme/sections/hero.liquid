{%- comment -%}
  Campaign hero (master-plan/10 CS-01, Riviera board 16). Styles: src/styles/components/hero.css.
  Media priority: Shopify video → video URL (+ poster) → image → collection image.
  Media drifts with GSAP parallax (<nk-parallax>). Headline: Split Text rise with hover lift and a
  Gradient Text italic tail (<nk-text>); eyebrow: Shiny Text; intro copy: Text Effect blur.
  Scroll cue fades out as the page moves.

  Layouts: overlay (full-bleed, copy over media), editorial (full-bleed, magazine-cover grid),
  split (media beside a solid text panel). Entrances: fade-up, text (masked line reveal), zoom
  (media settles from a zoom), curtain (media unveils, copy follows), none. Media entrances are CSS
  keyed off html.nk-anim, which is only set while decorative motion is allowed; copy entrances
  are <nk-reveal>, which checks the same policy.
  Overlay-eligible (a transparent header can sit on top when it is the first section) unless the
  layout is split, where the header would land on the text panel.
{%- endcomment -%}
{%- liquid
  assign desktop = section.settings.image | default: section.settings.collection.featured_image
  assign mobile = section.settings.image_mobile | default: desktop
  assign video = section.settings.video
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif

  assign layout = section.settings.layout | default: 'overlay'
  assign entrance = section.settings.entrance | default: 'fade-up'

  assign wrap = 'nk-reveal'
  assign copy_mode = 'fade'
  assign buttons_mode = 'fade'
  assign offset = 0
  case entrance
    when 'none'
      assign wrap = 'div'
    when 'text'
      assign copy_mode = 'split'
      assign buttons_mode = 'rise'
      assign offset = 0.08
    when 'zoom'
      assign offset = 0.3
    when 'curtain'
      assign copy_mode = 'cut'
      assign offset = 0.55
  endcase
  assign eyebrow_delay = 0.06 | plus: offset
  assign text_delay = 0.28 | plus: offset
  assign buttons_delay = 0.4 | plus: offset

  # Positions are "<vertical>-<horizontal>", or "center" for both.
  assign position_classes = ''
  assign positions = section.settings.position | default: 'bottom-left' | append: ',' | append: section.settings.position_mobile
  assign positions = positions | split: ','
  for pos in positions
    if pos == blank or pos == 'same'
      continue
    endif
    assign prefix = 'hero--'
    if forloop.index == 2
      assign prefix = 'hero--m'
    endif
    if pos == 'center'
      assign v = 'center'
      assign h = 'center'
    else
      assign parts = pos | split: '-'
      assign v = parts[0]
      assign h = parts[1]
    endif
    assign position_classes = position_classes | append: ' ' | append: prefix | append: 'v-' | append: v | append: ' ' | append: prefix | append: 'h-' | append: h
  endfor
  if section.settings.text_align != blank and section.settings.text_align != 'auto'
    assign position_classes = position_classes | append: ' hero--text-' | append: section.settings.text_align
  endif
-%}
<div
  class="hero full-width color-{{ section.settings.color_scheme }} hero--{{ layout }} hero--{{ section.settings.height }}{{ position_classes }} hero--media-{{ section.settings.media_position }} hero--enter-{{ entrance }}"
  {% unless layout == 'split' %}
    data-overlay-eligible
  {% endunless %}
  style="--nk-scrim: {{ section.settings.scrim | divided_by: 100.0 }}; --hero-width: {{ section.settings.content_width | default: 1100 }}px; --hero-gap: {{ section.settings.block_gap | default: 22 }}px;"
>
  <nk-parallax class="hero__media" strength="{{ section.settings.parallax }}">
    <div class="hero__media-inner" data-parallax-media>
      {%- if video -%}
        {{ video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'hero__video' }}
      {%- elsif section.settings.video_url != blank -%}
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" {% if section.settings.poster_url != blank %}poster="{{ section.settings.poster_url }}"{% endif %}>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif desktop -%}
        {%- liquid
          assign loading = 'lazy'
          assign priority = 'auto'
          if is_first
            assign loading = 'eager'
            assign priority = 'high'
          endif
          assign alt = desktop.alt | escape
          assign sizes = '100vw'
          if layout == 'split'
            assign sizes = '(min-width: 990px) 55vw, 100vw'
          endif
        -%}
        <picture>
          {%- if section.settings.image_mobile -%}
            <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w, {{ mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
          {%- endif -%}
          {{ desktop | image_url: width: 2880 | image_tag: loading: loading, fetchpriority: priority, widths: '750, 1100, 1500, 1920, 2400, 2880', sizes: sizes, alt: alt }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
      {%- endif -%}
    </div>
  </nk-parallax>
  {%- case section.settings.scrim_style -%}
    {%- when 'solid' -%}<span class="hero__scrim" aria-hidden="true"></span>
    {%- when 'blur' -%}<span class="nk-scrim-blur" aria-hidden="true"></span>
  {%- endcase -%}

  <div class="hero__content">
    <div class="hero__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <{{ wrap }}
              class="hero__block hero__block--eyebrow"
              style="--hero-eyebrow-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }};"
              {% if wrap == 'nk-reveal' %}
                mode="{{ copy_mode }}" delay="{{ eyebrow_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <p class="eyebrow hero__eyebrow">
                <span class="{% if block.settings.shine %}nk-text-shine{% endif %}">{{ block.settings.text | escape }}</span>
              </p>
            </{{ wrap }}>
          {%- when 'heading' -%}
            <div
              class="hero__block hero__block--heading"
              style="--hero-heading-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }}; --hero-heading-scale-mobile: {{ block.settings.size_mobile | default: 100 | divided_by: 100.0 }};"
              {{ block.shopify_attributes }}
            >
              {%- liquid
                assign heading_tag = 'h2'
                if is_first
                  assign heading_tag = 'h1'
                endif
                assign heading_html = block.settings.heading | escape
                assign italic = block.settings.heading_italic | escape
                assign heading_entrance = block.settings.entrance
                if entrance == 'none'
                  assign heading_entrance = 'none'
                endif
              -%}
              {% render 'reveal-heading',
                text: heading_html,
                italic: italic,
                italic_break: true,
                tag: heading_tag,
                entrance: heading_entrance,
                hover: block.settings.hover,
                italic_style: block.settings.italic_style,
                style: block.settings.text_style,
                class: 'hero__heading display',
                play_on_load: true
              %}
            </div>
          {%- when 'text' -%}
            <{{ wrap }}
              class="hero__block hero__block--text"
              style="--hero-text-scale: {{ block.settings.size | default: 100 | divided_by: 100.0 }}; --hero-text-width: {{ block.settings.width | default: 42 }}ch;"
              {% if wrap == 'nk-reveal' %}
                mode="{{ copy_mode }}" delay="{{ text_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="hero__text">{{ block.settings.text }}</div>
            </{{ wrap }}>
          {%- when 'buttons' -%}
            <{{ wrap }}
              class="hero__block hero__block--buttons"
              style="--hero-buttons-gap: {{ block.settings.gap | default: 14 }}px; --hero-buttons-offset: {{ block.settings.offset | default: 0 }}px;"
              {% if wrap == 'nk-reveal' %}
                mode="{{ buttons_mode }}" delay="{{ buttons_delay }}" play-on-load
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="hero__buttons hero__buttons--align-{{ block.settings.alignment | default: 'auto' }} hero__buttons--{{ block.settings.arrangement | default: 'row' }}{% if block.settings.full_width_mobile %} hero__buttons--fill-mobile{% endif %}">
                {% render 'hero-button',
                  label: block.settings.label_1,
                  link: block.settings.link_1,
                  style: block.settings.style_1,
                  size: block.settings.size,
                  arrow: block.settings.arrow,
                  magnetic: true
                %}
                {% render 'hero-button',
                  label: block.settings.label_2,
                  link: block.settings.link_2,
                  style: block.settings.style_2,
                  size: block.settings.size,
                  arrow: false
                %}
              </div>
            </{{ wrap }}>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_scroll_cue -%}
      <span class="hero__cue" aria-hidden="true">
        <span class="hero__cue-label">{{ 'general.scroll' | t }}</span>
        <span class="hero__cue-line"></span>
      </span>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Campaign hero",
  "class": "hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted video. Plays muted." },
    { "type": "url", "id": "video_url", "label": "Video file URL", "info": "Optional MP4 address from Content › Files, used when no video is picked above." },
    { "type": "url", "id": "poster_url", "label": "Video poster image URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image" },
    { "type": "collection", "id": "collection", "label": "Use collection image", "info": "Shown when no video or image is set." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "overlay", "label": "Full-bleed, text over media" },
        { "value": "editorial", "label": "Editorial cover" },
        { "value": "split", "label": "Split, media beside text" }
      ],
      "default": "overlay",
      "info": "Editorial puts the heading bottom left with the text and buttons in a ruled column on the right. Split shows the media next to a solid panel in the color scheme."
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media side (split layout)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "medium", "label": "Medium" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "options": [
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "top-right", "label": "Top right" },
        { "value": "center-left", "label": "Middle left" },
        { "value": "center", "label": "Center" },
        { "value": "center-right", "label": "Middle right" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "bottom-left",
      "info": "Used by the full-bleed and split layouts. Text aligns to the side you pick."
    },
    {
      "type": "select",
      "id": "position_mobile",
      "label": "Content position on phones",
      "options": [
        { "value": "same", "label": "Same as desktop" },
        { "value": "top-left", "label": "Top left" },
        { "value": "top-center", "label": "Top center" },
        { "value": "center-left", "label": "Middle left" },
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "same"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "auto", "label": "Follow the position" },
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "auto"
    },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 360, "max": 1400, "step": 20, "unit": "px", "default": 1100 },
    { "type": "range", "id": "block_gap", "label": "Space between blocks", "min": 8, "max": 56, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "parallax", "label": "Parallax depth", "min": 0, "max": 30, "step": 2, "unit": "%", "default": 14 },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true },
    {
      "type": "select",
      "id": "scrim_style",
      "label": "Text backdrop",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Tint" },
        { "value": "blur", "label": "Progressive blur" }
      ],
      "default": "solid"
    },
    { "type": "range", "id": "scrim", "label": "Tint strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "header", "content": "Animation" },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance",
      "options": [
        { "value": "fade-up", "label": "Fade up" },
        { "value": "text", "label": "Text reveal, line by line" },
        { "value": "zoom", "label": "Media zooms out" },
        { "value": "curtain", "label": "Media curtain, then text" },
        { "value": "none", "label": "None" }
      ],
      "default": "fade-up",
      "info": "Plays when the page loads. The heading keeps its own entrance unless this is None. Not shown to visitors who prefer reduced motion or when Motion is off."
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New collection" },
        { "type": "checkbox", "id": "shine", "label": "Shine effect", "default": false },
        { "type": "range", "id": "size", "label": "Size", "min": 80, "max": 200, "step": 10, "unit": "%", "default": 100 }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Campaign" },
        { "type": "text", "id": "heading_italic", "label": "Second line (italic)" },
        { "type": "range", "id": "size", "label": "Size", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
        { "type": "range", "id": "size_mobile", "label": "Size on phones", "min": 50, "max": 160, "step": 5, "unit": "%", "default": 100 },
        { "type": "select", "id": "italic_style", "label": "Italic line style", "options": [{ "value": "none", "label": "Plain" }, { "value": "gradient", "label": "Flowing gradient (Gradient Text)" }], "default": "none" },
        {
          "type": "select",
          "id": "entrance",
          "label": "Entrance",
          "options": [
        { "value": "none", "label": "None" },
        { "value": "cut", "label": "Editorial masked reveal" },
        { "value": "rise", "label": "Rise word by word (Split Text)" },
        { "value": "blur", "label": "Blur in word by word (Text Effect)" },
        { "value": "fold", "label": "Paper fold (Fold Text)" },
        { "value": "flip", "label": "Flip up" },
        { "value": "skew", "label": "Skew in" },
        { "value": "pop", "label": "Pop" },
        { "value": "fade", "label": "Fade" }
      ],
          "default": "cut",
          "info": "Not shown to visitors who prefer reduced motion."
        },
        {
          "type": "select",
          "id": "hover",
          "label": "Heading hover",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "lift", "label": "Letters lift near the pointer" },
            { "value": "refold", "label": "Letters fold near the pointer" }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text effect",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shine", "label": "Shine" },
            { "value": "gradient", "label": "Gradient" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "range", "id": "size", "label": "Size", "min": 80, "max": 160, "step": 5, "unit": "%", "default": 100 },
        { "type": "range", "id": "width", "label": "Line length", "min": 20, "max": 80, "step": 2, "unit": "ch", "default": 42 }
      ]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_1", "label": "First button label", "default": "Shop now" },
        { "type": "url", "id": "link_1", "label": "First button link" },
        {
          "type": "select",
          "id": "style_1",
          "label": "First button style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" },
            { "value": "glass", "label": "Frosted glass" },
            { "value": "link", "label": "Text link with arrow" }
          ],
          "default": "solid"
        },
        { "type": "checkbox", "id": "arrow", "label": "Show arrow on first button", "default": false, "info": "Text links always show an arrow." },
        { "type": "text", "id": "label_2", "label": "Second button label" },
        { "type": "url", "id": "link_2", "label": "Second button link" },
        {
          "type": "select",
          "id": "style_2",
          "label": "Second button style",
          "options": [
            { "value": "solid", "label": "Solid" },
            { "value": "outline", "label": "Outline" },
            { "value": "glass", "label": "Frosted glass" },
            { "value": "link", "label": "Text link with arrow" }
          ],
          "default": "outline"
        },
        { "type": "header", "content": "Size and position" },
        {
          "type": "select",
          "id": "size",
          "label": "Button size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Button alignment",
          "options": [
            { "value": "auto", "label": "Follow the text" },
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "auto"
        },
        {
          "type": "select",
          "id": "arrangement",
          "label": "Arrangement",
          "options": [
            { "value": "row", "label": "Side by side" },
            { "value": "stack", "label": "Stacked" }
          ],
          "default": "row"
        },
        { "type": "checkbox", "id": "full_width_mobile", "label": "Full width on phones", "default": false },
        { "type": "range", "id": "gap", "label": "Space between buttons", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 14 },
        { "type": "range", "id": "offset", "label": "Extra space above", "min": 0, "max": 64, "step": 4, "unit": "px", "default": 0 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign hero",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "buttons" }]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
