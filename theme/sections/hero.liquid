{%- comment -%}
  Campaign hero (master-plan/10 CS-01, Riviera board 16).
  Media priority: Shopify video → video URL (+ poster) → image → collection image.
  Media drifts with GSAP parallax (<nk-parallax>). Headline: Split Text rise with hover lift and a
  Gradient Text italic tail (<nk-text>); eyebrow: Shiny Text; intro copy: Text Effect blur; buttons:
  letter swap. Scroll cue fades out as the page moves.
  Marked overlay-eligible so a transparent header can sit on top when it is the first section.
{%- endcomment -%}
{%- liquid
  assign desktop = section.settings.image | default: section.settings.collection.featured_image
  assign mobile = section.settings.image_mobile | default: desktop
  assign video = section.settings.video
  assign is_first = false
  if section.index == 1
    assign is_first = true
  endif
-%}
<div
  class="hero full-width color-{{ section.settings.color_scheme }} hero--{{ section.settings.height }} hero--{{ section.settings.position }}"
  data-overlay-eligible
  style="--nk-scrim: {{ section.settings.scrim | divided_by: 100.0 }};"
>
  <nk-parallax class="hero__media" strength="{{ section.settings.parallax }}">
    <div class="hero__media-inner" data-parallax-media>
      {%- if video -%}
        {{ video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x', class: 'hero__video' }}
      {%- elsif section.settings.video_url != blank -%}
        <video class="hero__video" autoplay muted loop playsinline preload="metadata" {% if section.settings.poster_url != blank %}poster="{{ section.settings.poster_url }}"{% endif %}>
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {%- elsif desktop -%}
        {%- liquid
          assign loading = 'lazy'
          assign priority = 'auto'
          if is_first
            assign loading = 'eager'
            assign priority = 'high'
          endif
          assign alt = desktop.alt | escape
        -%}
        <picture>
          {%- if section.settings.image_mobile -%}
            <source media="(max-width: 749px)" srcset="{{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 1100 }} 1100w, {{ mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
          {%- endif -%}
          {{ desktop | image_url: width: 2880 | image_tag: loading: loading, fetchpriority: priority, widths: '750, 1100, 1500, 1920, 2400, 2880', sizes: '100vw', alt: alt }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hero__placeholder' }}
      {%- endif -%}
    </div>
  </nk-parallax>
  {%- case section.settings.scrim_style -%}
    {%- when 'solid' -%}<span class="hero__scrim" aria-hidden="true"></span>
    {%- when 'blur' -%}<span class="nk-scrim-blur" aria-hidden="true"></span>
  {%- endcase -%}

  <div class="hero__content">
    <div class="hero__copy">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            <p class="eyebrow hero__eyebrow" {{ block.shopify_attributes }}>
              <span class="{% if block.settings.shine %}nk-text-shine{% endif %}">{{ block.settings.text | escape }}</span>
            </p>
          {%- when 'heading' -%}
            <div {{ block.shopify_attributes }}>
              {%- liquid
                assign heading_tag = 'h2'
                if is_first
                  assign heading_tag = 'h1'
                endif
                assign heading_html = block.settings.heading | escape
                assign italic = block.settings.heading_italic | escape
              -%}
              {% render 'reveal-heading',
                text: heading_html,
                italic: italic,
                italic_break: true,
                tag: heading_tag,
                entrance: block.settings.entrance,
                hover: block.settings.hover,
                italic_style: block.settings.italic_style,
                style: block.settings.text_style,
                class: 'hero__heading display',
                play_on_load: true
              %}
            </div>
          {%- when 'text' -%}
            {%- if request.design_mode -%}
              <div class="hero__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- else -%}
              <nk-text class="hero__text" effect="blur" split="words" stagger="0.035" delay="0.55" play-on-load {{ block.shopify_attributes }}>
                <div data-text-target>{{ block.settings.text }}</div>
              </nk-text>
            {%- endif -%}
          {%- when 'buttons' -%}
            <div class="hero__buttons" {{ block.shopify_attributes }}>
              {%- if block.settings.label_1 != blank and block.settings.link_1 != blank -%}
                <a class="button hero__button" href="{{ block.settings.link_1 }}">{% render 'letter-swap', text: block.settings.label_1 %}</a>
              {%- endif -%}
              {%- if block.settings.label_2 != blank and block.settings.link_2 != blank -%}
                <a class="button button--secondary hero__button hero__button--ghost" href="{{ block.settings.link_2 }}">{% render 'letter-swap', text: block.settings.label_2 %}</a>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    {%- if section.settings.show_scroll_cue -%}
      <span class="hero__cue" aria-hidden="true">
        <span class="hero__cue-label">{{ 'general.scroll' | t }}</span>
        <span class="hero__cue-line"></span>
      </span>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .hero {
    position: relative;
    display: grid;
    min-height: 60svh;
    overflow: hidden;
    color: var(--nk-color-text);
    isolation: isolate;
  }
  .hero--medium { min-height: min(75svh, 760px); }
  .hero--full { min-height: 100svh; }
  .hero--adapt { min-height: 0; }
  .hero__media,
  .hero__content { grid-area: 1 / 1; }
  .hero__media { position: relative; display: block; overflow: hidden; z-index: -2; }
  .hero__media-inner { position: absolute; inset: 0; }
  .hero__media img,
  .hero__media video,
  .hero__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__scrim,
  .hero .nk-scrim-blur { z-index: -1; }
  .hero__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgb(0 0 0 / calc(var(--nk-scrim, 0.3) + 0.2)), rgb(0 0 0 / calc(var(--nk-scrim, 0.3) * 0.4)) 55%, rgb(0 0 0 / calc(var(--nk-scrim, 0.3) * 0.6))); }
  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: calc(var(--nk-header-h, 64px) + 24px) var(--nk-gutter) 44px;
  }
  .hero__copy { display: flex; flex-direction: column; gap: 22px; max-width: 1100px; }
  .hero--center .hero__content { justify-content: center; align-items: center; text-align: center; }
  .hero--center .hero__copy { align-items: center; }
  .hero__eyebrow { color: color-mix(in oklab, var(--nk-color-text) 80%, transparent); }
  .hero__heading { font-size: clamp(3.5rem, 13vw, 11.5rem); }
  .hero__heading em { font-weight: 400; }
  .hero__text { max-width: 42ch; font-family: var(--nk-font-heading); font-style: italic; font-size: clamp(1.0625rem, 1.6vw, 1.375rem); line-height: 1.45; }
  .hero__buttons { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero .button { background: var(--nk-color-text); color: var(--nk-color-bg); border-color: var(--nk-color-text); }
  .hero .hero__button--ghost { background: transparent; color: var(--nk-color-text); }
  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: 18px;
    translate: -50% 0;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-family: var(--nk-font-spec);
    font-size: 0.625rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    padding-inline-start: 0.32em;
    color: color-mix(in oklab, var(--nk-color-text) 75%, transparent);
    pointer-events: none;
  }
  .hero__cue-line {
    position: relative;
    width: 1px;
    height: 44px;
    overflow: hidden;
    background: color-mix(in oklab, var(--nk-color-text) 25%, transparent);
  }
  .hero__cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--nk-color-text);
    translate: 0 -100%;
    animation: hero-cue 2.2s cubic-bezier(0.76, 0, 0.24, 1) infinite;
  }
  @keyframes hero-cue {
    0% { translate: 0 -100%; }
    50% { translate: 0 0; }
    100% { translate: 0 100%; }
  }
  @supports (animation-timeline: scroll()) {
    .hero__cue { animation: hero-cue-out linear both; animation-timeline: scroll(root); animation-range: 0 30vh; }
    @keyframes hero-cue-out { to { opacity: 0; } }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__cue-line::after { animation: none; translate: 0 0; }
  }
  @media (min-width: 990px) {
    .hero__content { padding-bottom: 64px; }
    .hero__cue { display: flex; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Campaign hero",
  "class": "hero-section",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "video", "id": "video", "label": "Video", "info": "Shopify-hosted video. Plays muted." },
    { "type": "url", "id": "video_url", "label": "Video file URL", "info": "Optional MP4 address from Content › Files, used when no video is picked above." },
    { "type": "url", "id": "poster_url", "label": "Video poster image URL" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Phone image" },
    { "type": "collection", "id": "collection", "label": "Use collection image", "info": "Shown when no video or image is set." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "medium", "label": "Medium" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Content position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "bottom-left"
    },
    { "type": "range", "id": "parallax", "label": "Parallax depth", "min": 0, "max": 30, "step": 2, "unit": "%", "default": 14 },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true },
    {
      "type": "select",
      "id": "scrim_style",
      "label": "Text backdrop",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "solid", "label": "Tint" },
        { "value": "blur", "label": "Progressive blur" }
      ],
      "default": "solid"
    },
    { "type": "range", "id": "scrim", "label": "Tint strength", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 30 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "Eyebrow",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New collection" },
        { "type": "checkbox", "id": "shine", "label": "Shine effect", "default": true }
      ]
    },
    {
      "type": "heading",
      "name": "Heading",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Campaign" },
        { "type": "text", "id": "heading_italic", "label": "Second line (italic)" },
        { "type": "select", "id": "italic_style", "label": "Italic line style", "options": [{ "value": "none", "label": "Plain" }, { "value": "gradient", "label": "Flowing gradient (Gradient Text)" }], "default": "gradient" },
        {
          "type": "select",
          "id": "entrance",
          "label": "Entrance",
          "options": [
        { "value": "none", "label": "None" },
        { "value": "rise", "label": "Rise letter by letter (Split Text)" },
        { "value": "blur", "label": "Blur in word by word (Text Effect)" },
        { "value": "fold", "label": "Paper fold (Fold Text)" },
        { "value": "flip", "label": "Flip up" },
        { "value": "skew", "label": "Skew in" },
        { "value": "pop", "label": "Pop" },
        { "value": "fade", "label": "Fade" }
      ],
          "default": "rise",
          "info": "Not shown to visitors who prefer reduced motion."
        },
        {
          "type": "select",
          "id": "hover",
          "label": "Heading hover",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "lift", "label": "Letters lift near the pointer" },
            { "value": "refold", "label": "Letters fold near the pointer" }
          ],
          "default": "lift"
        },
        {
          "type": "select",
          "id": "text_style",
          "label": "Text effect",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "shine", "label": "Shine" },
            { "value": "gradient", "label": "Gradient" }
          ],
          "default": "none"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 1,
      "settings": [{ "type": "richtext", "id": "text", "label": "Text" }]
    },
    {
      "type": "buttons",
      "name": "Buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_1", "label": "First button label", "default": "Shop now" },
        { "type": "url", "id": "link_1", "label": "First button link" },
        { "type": "text", "id": "label_2", "label": "Second button label" },
        { "type": "url", "id": "link_2", "label": "Second button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign hero",
      "blocks": [{ "type": "eyebrow" }, { "type": "heading" }, { "type": "buttons" }]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
