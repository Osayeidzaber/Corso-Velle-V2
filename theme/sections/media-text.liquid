{%- comment -%}
  Media with text (master-plan/10 CS-04): split or overlay. Heading uses the shared reveal
  snippet; the whole text column can fade/cut in (<nk-reveal>, from Animated Content).
  DOM order is always media → text; "media first on phones" only changes visual order.
{%- endcomment -%}
<div class="media-text full-width section-spacing color-{{ section.settings.color_scheme }} media-text--{{ section.settings.layout }}{% if section.settings.media_right %} media-text--media-right{% endif %}{% if section.settings.text_first_mobile %} media-text--text-first{% endif %}">
  <div class="media-text__inner">
    <div class="media-text__media">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'media-text__placeholder' }}
      {%- endif -%}
      {%- if section.settings.layout == 'overlay' and section.settings.blur_scrim -%}
        <span class="nk-scrim-blur" aria-hidden="true"></span>
      {%- endif -%}
    </div>

    {%- capture column -%}
      <div class="media-text__content">
        {%- if section.settings.index != blank -%}<p class="spec text-muted">{{ section.settings.index | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          {% render 'reveal-heading', text: section.settings.heading, entrance: section.settings.heading_entrance, style: section.settings.text_style, class: 'media-text__heading' %}
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="button button--secondary" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- if section.settings.entrance != 'none' and request.design_mode == false -%}
      <nk-reveal mode="{{ section.settings.entrance }}" class="media-text__reveal">{{ column }}</nk-reveal>
    {%- else -%}
      {{ column }}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .media-text__inner {
    display: grid;
    gap: 24px;
    width: var(--content-width);
    margin-inline: auto;
  }
  .media-text__media { position: relative; overflow: hidden; background: var(--nk-color-surface); }
  .media-text__media img, .media-text__placeholder { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 4 / 5; }
  .media-text__content { display: grid; gap: 16px; align-content: center; justify-items: start; }
  .media-text__heading { font-size: clamp(1.75rem, 5vw, 3.25rem); }
  .media-text--text-first .media-text__media { order: 2; }
  @media (min-width: 990px) {
    .media-text__inner { grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
    .media-text--text-first .media-text__media { order: 0; }
    .media-text--media-right .media-text__media { order: 2; }
  }
  .media-text--overlay .media-text__inner { grid-template-columns: 1fr; }
  .media-text--overlay .media-text__media,
  .media-text--overlay .media-text__reveal,
  .media-text--overlay .media-text__inner > .media-text__content { grid-area: 1 / 1; }
  .media-text--overlay .media-text__media img { aspect-ratio: 16 / 9; }
  .media-text--overlay .media-text__content { position: relative; z-index: 1; align-self: end; padding: 32px; color: #fff; max-width: 640px; }
  @media (max-width: 749px) {
    .media-text--overlay .media-text__media img { aspect-ratio: 4 / 5; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media with text",
  "class": "media-text-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "split", "label": "Side by side" },
        { "value": "overlay", "label": "Text over image" }
      ],
      "default": "split"
    },
    { "type": "checkbox", "id": "media_right", "label": "Image on the right (desktop)", "default": false },
    { "type": "checkbox", "id": "text_first_mobile", "label": "Text first on phones", "default": false },
    { "type": "checkbox", "id": "blur_scrim", "label": "Progressive blur behind text (overlay layout)", "default": true },
    { "type": "text", "id": "index", "label": "Index label", "info": "Optional, e.g. 01 / Fit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell the story" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "heading_entrance",
      "label": "Heading entrance",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "cut", "label": "Cut" },
        { "value": "split-lines", "label": "Split lines" },
        { "value": "fold", "label": "Fold" }
      ],
      "default": "split-lines"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Text column entrance",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "fade", "label": "Fade up" },
        { "value": "wipe", "label": "Wipe" }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Heading effect",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "shine", "label": "Shine" },
        { "value": "gradient", "label": "Gradient" }
      ],
      "default": "none"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Media with text" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
