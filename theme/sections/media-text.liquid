{%- comment -%}
  Media with text (master-plan/10 CS-04): split or overlay. Heading uses the shared reveal
  snippet; the whole text column can fade/cut in (<nk-reveal>, from Animated Content).
  DOM order is always media → text; "media first on phones" only changes visual order.
{%- endcomment -%}
<nk-scene {% render 'scene-attributes', section: section %} class="media-text full-width section-spacing section-presentation color-{{ section.settings.color_scheme }} media-text--{{ section.settings.layout }}{% if section.settings.media_right %} media-text--media-right{% endif %}{% if section.settings.text_first_mobile %} media-text--text-first{% endif %}" data-align="{{ section.settings.text_align }}" data-ratio="{{ section.settings.media_ratio }}" data-fit="{{ section.settings.media_fit }}" data-overlay-colors="{{ section.settings.overlay_colors }}" style="{% render 'section-presentation', presentation: section.settings %}--media-copy-width:{{ section.settings.copy_width | default: 46 }}ch;">
  <span data-scene-wash aria-hidden="true"></span>
  <div class="media-text__inner">
    <div class="media-text__media" data-scene-media>
      {%- assign still = section.settings.image | default: section.settings.collection.featured_image -%}
      {% if section.settings.video %}
        {% render 'background-video', video: section.settings.video, autoplay: section.settings.video_autoplay %}
      {%- elsif still -%}
        <div data-parallax-media style="position: absolute; inset: 0;">
          <picture>
            {% if section.settings.image_mobile %}<source media="(max-width: 749px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">{% endif %}
            {{ still | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 990px) 60vw, 100vw' }}
          </picture>
        </div>
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'media-text__placeholder' }}
      {%- endif -%}
      {%- if section.settings.layout == 'overlay' and section.settings.blur_scrim -%}
        <span class="nk-scrim-blur" aria-hidden="true"></span>
      {%- endif -%}
    </div>

    {%- capture column -%}
      <div class="media-text__content" data-scene-copy>
        {%- if section.settings.index != blank -%}<p class="spec text-muted">{{ section.settings.index | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}
          {%- liquid
            assign heading_html = section.settings.heading | escape
            assign italic = section.settings.heading_italic | escape
          -%}
          {%- assign heading_entrance = 'none' -%}
          {%- if section.settings.scene_preset == 'none' -%}{%- assign heading_entrance = section.settings.heading_entrance -%}{%- endif -%}
          {% render 'reveal-heading', text: heading_html, italic: italic, entrance: heading_entrance, style: section.settings.text_style, class: 'media-text__heading display' %}
        {%- endif -%}
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          {% if section.settings.link_style == 'solid' or section.settings.link_style == 'outline' %}
            {% render 'hero-button', label: section.settings.link_label, link: section.settings.link, style: section.settings.link_style %}
          {% else %}<a class="spec link-underline" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>{% endif %}
        {%- endif -%}
      </div>
    {%- endcapture -%}
    {%- if section.settings.scene_preset == 'none' and section.settings.entrance != 'none' and request.design_mode == false -%}
      <nk-reveal mode="{{ section.settings.entrance }}" class="media-text__reveal">{{ column }}</nk-reveal>
    {%- else -%}
      {{ column }}
    {%- endif -%}
  </div>
</nk-scene>

{% stylesheet %}
  .media-text__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    width: var(--content-width);
    margin-inline: auto;
  }
  .media-text__inner > * { min-width: 0; }
  .media-text__media { position: relative; display: block; overflow: hidden; background: var(--nk-color-surface); aspect-ratio: 4 / 5; }
  /* The responsive picture must have a definite height. An inline picture otherwise leaves
     percentage image height unresolved, painting the intrinsic image instead of filling the frame. */
  .media-text__media [data-parallax-media],
  .media-text__media picture { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }
  .media-text__media picture > img { position: absolute; inset: 0; display: block; }
  .media-text__media img, .media-text__placeholder { width: 100%; height: 100%; object-fit: cover; }
  .media-text__content { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-content: center; justify-items: start; }
  .media-text__content > * { min-width: 0; max-width: 100%; }
  .media-text__heading { font-size: clamp(2.5rem, 5.5vw, 4.5rem); overflow-wrap: anywhere; }
  .media-text__content .rte { max-width: 46ch; line-height: 1.75; color: var(--nk-color-text-muted); }
  .media-text--text-first .media-text__media { order: 2; }
  @media (min-width: 990px) {
    .media-text__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: center; }
    .media-text--text-first .media-text__media { order: 0; }
    .media-text--media-right .media-text__media { order: 2; }
  }
  .media-text--overlay .media-text__inner { grid-template-columns: minmax(0, 1fr); }
  .media-text--overlay .media-text__media,
  .media-text--overlay .media-text__reveal,
  .media-text--overlay .media-text__inner > .media-text__content { grid-area: 1 / 1; }
  .media-text--overlay .media-text__media { aspect-ratio: 16 / 9; }
  .media-text--overlay .media-text__content { position: relative; z-index: 1; align-self: end; padding: 32px; color: #fff; max-width: 640px; }
  @media (max-width: 749px) {
    .media-text--overlay .media-text__media { aspect-ratio: 4 / 5; }
  }
  .media-text .media-text__content .rte { max-width: var(--media-copy-width, 46ch); }
  .media-text[data-align='center'] .media-text__content { justify-items: center; text-align: center; }
  .media-text[data-fit='contain'] .media-text__media :is(img, video) { object-fit: contain; }
  .media-text[data-ratio='portrait'] .media-text__media { aspect-ratio: 4/5; }
  .media-text[data-ratio='square'] .media-text__media { aspect-ratio: 1; }
  .media-text[data-ratio='wide'] .media-text__media { aspect-ratio: 16/9; }
  .media-text--stacked .media-text__inner { grid-template-columns: minmax(0, 1fr); }
  .media-text--stacked.media-text--media-right .media-text__media { order: 0; }
  .media-text--overlay .media-text__content .rte { color: inherit; }
  .media-text--overlay[data-overlay-colors='scheme'] .media-text__content { color: var(--nk-color-text); }
  .media-text__media:has(nk-background-video) { z-index: 1; }
  .media-text__media nk-background-video { position: absolute; inset: 0; }
  .media-text__media video { width: 100%; height: 100%; object-fit: cover; }
  .media-text--overlay .media-text__inner > :not(.media-text__media) { z-index: 2; pointer-events: none; }
  .media-text--overlay .media-text__content > * { pointer-events: auto; }
  @media (min-width: 990px) {
    .media-text--asymmetric .media-text__inner { grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); }
    .media-text--asymmetric.media-text--media-right .media-text__inner { grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Media with text",
  "class": "media-text-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Use collection image",
      "info": "Shown when no image is set."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Side by side"
        },
        {
          "value": "overlay",
          "label": "Text over image"
        },
        {
          "value": "stacked",
          "label": "Stacked story"
        },
        {
          "value": "asymmetric",
          "label": "Wide image split"
        }
      ],
      "default": "split"
    },
    {
      "type": "checkbox",
      "id": "media_right",
      "label": "Image on the right (desktop)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "text_first_mobile",
      "label": "Text first on phones",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "blur_scrim",
      "label": "Progressive blur behind text (overlay layout)",
      "default": true
    },
    {
      "type": "text",
      "id": "index",
      "label": "Index label",
      "info": "Optional, e.g. 01 / Fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell the"
    },
    {
      "type": "text",
      "id": "heading_italic",
      "label": "Heading (italic part)",
      "default": "story"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "heading_entrance",
      "label": "Heading entrance",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "rise",
          "label": "Rise letter by letter (Split Text)"
        },
        {
          "value": "blur",
          "label": "Blur in word by word (Text Effect)"
        },
        {
          "value": "fold",
          "label": "Paper fold (Fold Text)"
        },
        {
          "value": "flip",
          "label": "Flip up"
        },
        {
          "value": "skew",
          "label": "Skew in"
        },
        {
          "value": "pop",
          "label": "Pop"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "flip"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Text column entrance",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade up"
        },
        {
          "value": "wipe",
          "label": "Wipe"
        }
      ],
      "default": "none"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Heading effect",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "shine",
          "label": "Shine"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "none"
    },
    {
      "type": "header",
      "content": "Section motion"
    },
    {
      "type": "select",
      "id": "scene_preset",
      "label": "Section animation",
      "options": [
        {
          "value": "off",
          "label": "Off"
        },
        {
          "value": "none",
          "label": "Use heading and column settings"
        },
        {
          "value": "subtle",
          "label": "Subtle entrance"
        },
        {
          "value": "cinematic",
          "label": "Cinematic scroll reveal"
        }
      ],
      "default": "cinematic",
      "info": "A section animation replaces separate heading and column entrances to keep movement coordinated."
    },
    {
      "type": "select",
      "id": "scene_direction",
      "label": "Reveal direction",
      "options": [
        {
          "value": "up",
          "label": "Up"
        },
        {
          "value": "left",
          "label": "From right"
        },
        {
          "value": "none",
          "label": "Fade only"
        }
      ],
      "default": "up"
    },
    {
      "type": "select",
      "id": "scene_intensity",
      "label": "Motion intensity",
      "options": [
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "full",
          "label": "Expressive"
        }
      ],
      "default": "soft"
    },
    {
      "type": "checkbox",
      "id": "scene_parallax",
      "label": "Gentle image drift",
      "default": true,
      "info": "Cinematic preset only. Simplified phones use a quick entrance."
    },
    {
      "type": "checkbox",
      "id": "scene_pin",
      "label": "Brief desktop hold",
      "default": false,
      "info": "Cinematic only, on wide screens when the entire section fits below the header. Adds at most 240px of scrolling."
    },
    {
      "type": "checkbox",
      "id": "scene_background",
      "label": "Fade subtle accent wash",
      "default": true,
      "info": "Cinematic only. Uses this section's color scheme."
    },
    {
      "type": "header",
      "content": "Section appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit",
      "info": "Sets the width of the image and text together. Background stays full width. All options keep the theme's responsive page gutters."
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px. Custom values are exact and are not multiplied by the global smaller-screen spacing setting."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Replaces images; muted background video with playback controls."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Phone image"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "copy_width",
      "label": "Body text width",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 46,
      "unit": "ch"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "inherit",
          "label": "Use layout default"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "wide",
          "label": "Landscape"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Media fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill and crop"
        },
        {
          "value": "contain",
          "label": "Entire media"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "link_style",
      "label": "Call to action",
      "options": [
        {
          "value": "text",
          "label": "Text link"
        },
        {
          "value": "solid",
          "label": "Filled button"
        },
        {
          "value": "outline",
          "label": "Outline button"
        }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "overlay_colors",
      "label": "Overlay text colors",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "scheme",
          "label": "Section scheme"
        }
      ],
      "default": "light"
    }
  ],
  "presets": [
    {
      "name": "Media with text"
    },
    {
      "name": "Stacked story",
      "settings": {
        "layout": "stacked",
        "text_align": "center",
        "scene_preset": "subtle",
        "media_ratio": "wide"
      }
    },
    {
      "name": "Asymmetric story",
      "settings": {
        "layout": "asymmetric",
        "scene_preset": "subtle"
      }
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
