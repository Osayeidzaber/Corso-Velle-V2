{%- comment -%}
  Slim promotion bar with optional dismiss. Adapted from HyperUI marketing/announcements and banners; script in src/components/dismissible.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
{%- capture banner_key -%}{%- for block in section.blocks -%}{{ block.settings.text }}{%- endfor -%}{%- endcapture -%}
<div class="promo-banner kit-section full-width section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-size="{{ section.settings.size }}" data-align="{{ section.settings.alignment }}" data-separator="{{ section.settings.separator }}" data-case="{{ section.settings.text_case }}" data-link="{{ section.settings.link_style }}" data-border="{{ section.settings.border }}" style="{% render 'section-presentation', presentation: section.settings %}--banner-text:{{ section.settings.text_size }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  {%- assign wrapper = 'div' -%}{%- if section.settings.dismissible -%}{%- assign wrapper = 'nk-dismissible' -%}{%- endif -%}
  <{{ wrapper }} class="promo-banner__inner" {% if section.settings.dismissible %}key="{{ section.id }}-{{ banner_key | md5 }}"{% endif %}>
    <ul class="promo-banner__messages" role="list">
      {%- for block in section.blocks -%}
        <li class="promo-banner__message" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}<span class="promo-banner__icon">{% render 'section-icon', name: block.settings.icon %}</span>{%- endif -%}
          <span>{{ block.settings.text }}</span>
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}<a href="{{ block.settings.link }}" class="promo-banner__link">{{ block.settings.link_label | escape }}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.dismissible -%}
      <button type="button" class="promo-banner__close icon-button" data-ref="dismiss" aria-label="{{ 'sections.banner.dismiss' | t }}" hidden>{% render 'icon', name: 'close', size: 16 %}</button>
    {%- endif -%}
  </{{ wrapper }}>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</div>

{% stylesheet %}
.promo-banner[data-border='bottom'] { border-bottom: 1px solid var(--nk-color-line); }
.promo-banner__inner { position: relative; display: flex; align-items: center; justify-content: center; width: var(--content-width); margin-inline: auto; min-height: 44px; padding-block: 8px; }
.promo-banner[data-size='large'] .promo-banner__inner { min-height: 64px; padding-block: 14px; }
.promo-banner[data-align='left'] .promo-banner__inner { justify-content: flex-start; }
.promo-banner__messages { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 28px; list-style: none; margin: 0; padding: 0 40px; text-align: center; font-size: var(--banner-text, 14px); }
.promo-banner[data-align='left'] .promo-banner__messages { justify-content: flex-start; padding-inline-start: 0; text-align: start; }
.promo-banner[data-case='upper'] .promo-banner__messages { text-transform: uppercase; letter-spacing: 0.08em; font-size: calc(var(--banner-text, 14px) * 0.9); }
.promo-banner__message { position: relative; display: inline-flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6px 10px; }
.promo-banner[data-separator='dot'] .promo-banner__message + .promo-banner__message::before { content: '•'; position: absolute; inset-inline-start: -17px; opacity: 0.5; }
.promo-banner[data-separator='line'] .promo-banner__message + .promo-banner__message::before { content: ''; position: absolute; inset-inline-start: -14px; height: 1em; border-inline-start: 1px solid currentColor; opacity: 0.4; }
.promo-banner__message p { margin: 0; }
.promo-banner__icon svg { width: 18px; height: 18px; }
.promo-banner__link { font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; }
.promo-banner[data-link='pill'] .promo-banner__link { padding: 3px 12px; border: 1px solid currentColor; border-radius: 999px; text-decoration: none; font-size: 0.9em; }
.promo-banner__close { position: absolute; inset-inline-end: 0; top: 50%; translate: 0 -50%; }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    {
      "type": "checkbox",
