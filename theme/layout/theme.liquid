<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    {%- # Flag JS support before first paint; motion/reveal styles key off these classes. -%}
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      {%- if settings.motion_level == 'off' %}
        document.documentElement.classList.add('nk-motion-off');
      {%- endif %}
    </script>

    {% render 'meta-tags' %}
    {% render 'css-variables' %}

    {%- unless settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {% render 'nk-config' %}
    {% render 'nk-assets', entry: 'global' %}
    {%- if template.name == 'product' -%}
      {% render 'nk-assets', entry: 'product' %}
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1" data-focus-fallback>
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}

    <div id="nk-live-polite" class="visually-hidden" aria-live="polite" aria-atomic="true"></div>
    <div id="nk-live-assertive" class="visually-hidden" aria-live="assertive" aria-atomic="true"></div>
  </body>
</html>
