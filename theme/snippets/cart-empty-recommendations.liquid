{%- doc -%}
  Optional links-only collection suggestions inside an empty cart form. No nested forms/actions.
  @param {object} collection - Merchant-selected collection
  @param {string} [heading] - Heading
{%- enddoc -%}
{% if collection.products.size > 0 %}
  <div class="cart-empty-suggestions">
    {% if heading != blank %}<h2>{{ heading | escape }}</h2>{% endif %}
    <ul class="product-grid" role="list" style="--nk-cols-mobile:2;--nk-cols-desktop:2;">
      {% for product in collection.products limit: 4 %}<li>{% render 'product-card', product: product, actions: false, sizes: '(min-width: 990px) 240px, 50vw' %}</li>{% endfor %}
    </ul>
  </div>
{% endif %}
