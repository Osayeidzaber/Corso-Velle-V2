{%- doc -%}
  Product gallery (master-plan/08 PR-01): native scroll-snap single-photo slider, optional editorial layouts on
  desktop, interactive thumbnail navigation, and high-resolution lightbox zoom dialog.
  The initial photo has high fetch priority (including variant deep links). The first frame stays
  eager for no-JS visitors; other offscreen media is lazy.
  Video plays only on request (controls, muted, playsinline) and pauses when its slide stops being current.

  @param {object} product - The product
  @param {object} [selected_variant] - Currently selected variant (optional)
  @param {object} [options] - Section gallery layout, ratio, fit, controls and zoom choices

  @example
  {% render 'product-media', product: product, selected_variant: variant %}
{%- enddoc -%}
{%- liquid
  assign media_count = product.media.size
  assign initial_media_id = selected_variant.featured_media.id
  assign layout = options.gallery_layout | default: 'slider'
  assign priority_media_id = product.media.first.id
  if layout == 'slider' and selected_variant.featured_media.media_type == 'image'
    assign priority_media_id = initial_media_id
  endif
  assign image_sizes = '(min-width: 990px) 58vw, 100vw'
  if layout == 'collage'
    assign image_sizes = '(min-width: 990px) 58vw, 88vw'
  endif
-%}
<nk-gallery
  class="product__media{% if media_count <= 1 %} product__media--single{% endif %}"
  aria-label="{{ 'product.gallery' | t }}"
  role="region"
  data-media-count="{{ media_count }}"
  data-layout="{{ layout }}"
  data-ratio="{{ options.gallery_ratio | default: 'square' }}"
  data-fit="{{ options.gallery_fit | default: 'contain' }}"
  data-backdrop="{{ options.gallery_background | default: 'white' }}"
  {% if initial_media_id %}data-initial-media-id="{{ initial_media_id }}"{% endif %}
>
  <div class="gallery__stage">
    {%- if media_count > 1 and options.show_thumbnails != false -%}
      <div class="gallery__thumbs" data-ref="thumbs" role="group" aria-label="{{ 'product.gallery' | t }}">
        {%- for media in product.media -%}
          {%- assign thumb_alt = media.alt | default: product.title -%}
          <button
            type="button"
            class="gallery__thumb{% if forloop.first %} is-active{% endif %}"
            data-gallery-thumb="{{ forloop.index0 }}"
            data-media-id="{{ media.id }}"
            aria-label="{{ 'product.media_position' | t: index: forloop.index, count: media_count }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            {{
              media.preview_image
              | image_url: width: 180
              | image_tag:
                loading: 'lazy',
                alt: thumb_alt,
                widths: '90, 140, 180',
                sizes: '72px'
            }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="gallery__main">
      <ul class="gallery__track" data-ref="track" role="list" tabindex="0" aria-label="{{ 'product.gallery' | t }}">
        {%- for media in product.media -%}
          {%- assign alt = media.alt | default: product.title -%}
          <li
            class="gallery__slide"
            data-ref="slide"
            data-media-id="{{ media.id }}"
            data-media-type="{{ media.media_type }}"
            data-slide-index="{{ forloop.index0 }}"
            {% if media.media_type == 'image' and options.enable_zoom != false %}
              data-zoom-src="{{ media | image_url: width: 2200 }}"
              data-zoom-alt="{{ alt | escape }}"
            {% endif %}
          >
            {%- if layout == 'collage' and media_count > 1 -%}
              <span class="gallery__index spec" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- endif -%}
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- liquid
                  assign image_loading = 'lazy'
                  assign image_priority = 'auto'
                  if forloop.first or media.id == priority_media_id
                    assign image_loading = 'eager'
                  endif
                  if media.id == priority_media_id
                    assign image_priority = 'high'
                  endif
                -%}
                {{
                  media
                  | image_url: width: 1800
                  | image_tag:
                    loading: image_loading,
                    fetchpriority: image_priority,
                    alt: alt,
                    widths: '360, 540, 720, 900, 1080, 1440, 1800',
                    sizes: image_sizes
                }}
                {% if options.enable_zoom != false %}<button
                  type="button"
                  class="gallery__zoom-trigger icon-button"
                  data-gallery-zoom="{{ forloop.index0 }}"
                  aria-label="{{ 'product.zoom' | t }} ({{ forloop.index }} / {{ media_count }})"
                >
                  {% render 'icon', name: 'plus', size: 16 %}
                </button>{% endif %}
              {%- when 'video' -%}
                {{ media | video_tag: controls: true, muted: true, playsinline: true, preload: 'none', image_size: '1200x' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: loading: 'lazy' }}
              {%- when 'model' -%}
                {{ media | model_viewer_tag }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: alt }}
            {%- endcase -%}
          </li>
        {%- else -%}
          <li class="gallery__slide gallery__slide--placeholder" data-ref="slide">
            {{ 'product-1' | placeholder_svg_tag }}
          </li>
        {%- endfor -%}
      </ul>

      {%- if media_count > 1 and options.show_media_progress != false -%}
        <div class="gallery__progress" data-ref="progress" aria-hidden="true">
          <div class="gallery__progress-rail">
            <span class="gallery__progress-fill"></span>
            <span class="gallery__progress-count spec"><span data-ref="progress-index">01</span> / {{ media_count | prepend: '0' | slice: -2, 2 }}</span>
          </div>
        </div>
      {%- endif -%}

      {%- if media_count > 1 and options.show_gallery_controls != false -%}
        <div class="gallery__controls">
          <button type="button" class="icon-button" data-gallery-step="-1" aria-label="{{ 'product.previous_media' | t }}">
            {% render 'icon', name: 'arrow-left' %}
          </button>
          <span class="spec" data-ref="counter">1 / {{ media_count }}</span>
          <button type="button" class="icon-button" data-gallery-step="1" aria-label="{{ 'product.next_media' | t }}">
            {% render 'icon', name: 'arrow-right' %}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if media_count > 0 and options.enable_zoom != false -%}
    <dialog class="gallery-lightbox" data-ref="lightbox" closedby="any" aria-label="{{ 'product.gallery' | t }}">
      <div class="gallery-lightbox__bar">
        <span class="spec" data-ref="lightbox-counter">1 / {{ media_count }}</span>
        <div class="gallery-lightbox__actions">
          {%- if media_count > 1 -%}
            <button type="button" class="icon-button" data-lightbox-step="-1" aria-label="{{ 'product.previous_media' | t }}">
              {% render 'icon', name: 'arrow-left' %}
            </button>
            <button type="button" class="icon-button" data-lightbox-step="1" aria-label="{{ 'product.next_media' | t }}">
              {% render 'icon', name: 'arrow-right' %}
            </button>
          {%- endif -%}
          <button type="button" class="icon-button" data-lightbox-close aria-label="{{ 'general.close' | t }}">
            {% render 'icon', name: 'close' %}
          </button>
        </div>
      </div>
      <div class="gallery-lightbox__stage" data-ref="lightbox-stage"></div>
    </dialog>
  {%- endif -%}
</nk-gallery>
