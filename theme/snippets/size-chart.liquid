{%- doc -%}
  Size guide content (master-plan/08 PR-04).

  Preferred source: product metafield custom.size_chart → metaobject "size_chart" with fields
  title, measurement_basis, unit, table (JSON), notes (rich text), fallback (rich text).
  table JSON: {"columns":[{"key":"chest","label":"Chest"}],"rows":[{"size":"S","values":{"chest":52}}]}
  Fallback: a page chosen in the block settings. Renders nothing when neither exists.

  Second fallback: an inline table typed into the block (first line = headings, one size per
  line, comma separated). Numbers switch between inches and centimetres in <nk-size-guide>.

  @param {object} product - The product
  @param {object} [page] - Fallback page
  @param {string} [table_csv] - Inline table, e.g. "Size,Chest\nS,40"
  @param {string} [unit] - Unit the inline table is written in: in or cm
  @param {string} [note] - Line shown under the inline table
  @param {string} [option] - Option name to highlight, e.g. Size

  @example
  {% render 'size-chart', product: product, page: block.settings.size_guide_page %}
{%- enddoc -%}
{%- liquid
  assign chart = product.metafields.custom.size_chart.value
  assign custom_json = product.metafields.custom.measurements.value
-%}
{%- if chart -%}
  {%- assign table = chart.table.value -%}
  {%- assign meta_unit = chart.unit | default: unit | default: 'in' | downcase -%}
  <nk-size-guide class="size-chart" unit="{{ meta_unit }}" option="{{ option | default: 'Size' | escape }}">
    <div class="size-chart__top">
      {%- if chart.measurement_basis != blank -%}
        <p class="spec text-muted">
          {{ chart.measurement_basis }}{% if chart.unit != blank %} · {{ chart.unit }}{% endif %}
        </p>
      {%- endif -%}
      <div class="size-guide__units" role="group" aria-label="{{ 'product.units' | t }}">
        <button type="button" class="size-guide__unit" data-ref="unit" value="in" aria-pressed="{% if meta_unit == 'in' %}true{% else %}false{% endif %}" hidden>{{ 'product.inches' | t }}</button>
        <button type="button" class="size-guide__unit" data-ref="unit" value="cm" aria-pressed="{% if meta_unit == 'cm' %}true{% else %}false{% endif %}" hidden>{{ 'product.centimetres' | t }}</button>
      </div>
    </div>
    {%- if table.rows.size > 0 and table.columns.size > 0 -%}
      <div class="size-table-wrap" tabindex="0" role="region" aria-label="{{ 'product.size_table' | t }}">
        <table class="size-table">
          <caption class="visually-hidden">{{ chart.title | default: product.title | escape }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ 'product.size' | t }}</th>
              {%- for column in table.columns -%}
                <th scope="col">{{ column.label | escape }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for row in table.rows -%}
              <tr data-size-row="{{ row.size | escape }}">
                <th scope="row">{{ row.size | escape }}</th>
                {%- for column in table.columns -%}
                  <td data-value="{{ row.values[column.key] | escape }}">{{ row.values[column.key] | escape }}</td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- elsif chart.fallback != blank -%}
      {{ chart.fallback | metafield_tag }}
    {%- endif -%}
    {%- if chart.notes != blank -%}
      <div class="size-chart__notes">{{ chart.notes | metafield_tag }}</div>
    {%- endif -%}
  </nk-size-guide>
{%- elsif custom_json and custom_json.rows.size > 0 and custom_json.columns.size > 0 -%}
  {%- assign meta_unit = custom_json.unit | default: unit | default: 'in' | downcase -%}
  <nk-size-guide class="size-chart" unit="{{ meta_unit }}" option="{{ option | default: 'Size' | escape }}">
    <div class="size-guide__units" role="group" aria-label="{{ 'product.units' | t }}">
      <button type="button" class="size-guide__unit" data-ref="unit" value="in" aria-pressed="{% if meta_unit == 'in' %}true{% else %}false{% endif %}" hidden>{{ 'product.inches' | t }}</button>
      <button type="button" class="size-guide__unit" data-ref="unit" value="cm" aria-pressed="{% if meta_unit == 'cm' %}true{% else %}false{% endif %}" hidden>{{ 'product.centimetres' | t }}</button>
    </div>
    <div class="size-table-wrap" tabindex="0" role="region" aria-label="{{ 'product.size_table' | t }}">
      <table class="size-table">
        <caption class="visually-hidden">{{ product.title | escape }}</caption>
        <thead>
          <tr>
            <th scope="col">{{ 'product.size' | t }}</th>
            {%- for column in custom_json.columns -%}
              <th scope="col">{{ column.label | escape }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in custom_json.rows -%}
            <tr data-size-row="{{ row.size | escape }}">
              <th scope="row">{{ row.size | escape }}</th>
              {%- for column in custom_json.columns -%}
                <td data-value="{{ row.values[column.key] | escape }}">{{ row.values[column.key] | escape }}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </nk-size-guide>
{%- elsif table_csv != blank -%}
  {%- liquid
    assign title_down = product.title | downcase
    assign type_down = product.type | downcase
    assign collections_str = product.collections | map: 'handle' | join: ' ' | downcase
    assign context_str = title_down | append: ' ' | append: type_down | append: ' ' | append: collections_str

    assign is_footwear = false
    if context_str contains 'shoe' or context_str contains 'loafer' or context_str contains 'boot' or context_str contains 'mule' or context_str contains 'footwear' or context_str contains 'sneaker' or context_str contains 'sandal'
      assign is_footwear = true
    endif

    assign is_bottom = false
    if context_str contains 'trouser' or context_str contains 'pant' or context_str contains 'jean' or context_str contains 'bottom' or context_str contains 'chino' or context_str contains 'short' or context_str contains 'gurkha'
      assign is_bottom = true
    endif

    assign active_csv = table_csv
    if is_footwear
      assign active_csv = blank
    elsif is_bottom and active_csv contains 'Chest'
      assign active_csv = blank
    endif

    assign has_matching_sizes = false
    if active_csv != blank
      assign base_unit = unit | default: 'in'
      assign lines = active_csv | strip | newline_to_br | split: '<br />'
      assign head = lines | first | strip | split: ','
      assign target_opt_name = option | default: 'Size' | downcase
      assign product_size_opt = nil
      for opt in product.options_with_values
        assign opt_down = opt.name | downcase
        if opt_down == target_opt_name or opt_down contains 'size'
          assign product_size_opt = opt
          break
        endif
      endfor
      for line in lines offset: 1
        assign cells = line | strip | split: ','
        assign row_size = cells.first | strip | downcase
        if product_size_opt
          for opt_val in product_size_opt.values
            assign opt_clean = opt_val | strip | downcase
            if opt_clean == row_size
              assign has_matching_sizes = true
              break
            endif
          endfor
        else
          assign has_matching_sizes = true
        endif
      endfor
    endif
  -%}
  {%- if has_matching_sizes -%}
    <nk-size-guide class="size-chart" unit="{{ base_unit }}" option="{{ option | default: 'Size' | escape }}">
      <div class="size-guide__units" role="group" aria-label="{{ 'product.units' | t }}">
        <button type="button" class="size-guide__unit" data-ref="unit" value="in" aria-pressed="{% if base_unit == 'in' %}true{% else %}false{% endif %}" hidden>{{ 'product.inches' | t }}</button>
        <button type="button" class="size-guide__unit" data-ref="unit" value="cm" aria-pressed="{% if base_unit == 'cm' %}true{% else %}false{% endif %}" hidden>{{ 'product.centimetres' | t }}</button>
      </div>
      <div class="size-table-wrap" tabindex="0" role="region" aria-label="{{ 'product.size_table' | t }}">
        <table class="size-table">
          <caption class="visually-hidden">{{ product.title | escape }}</caption>
          <thead>
            <tr>
              {%- for cell in head -%}
                <th scope="col">{{ cell | strip | escape }}</th>
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for line in lines offset: 1 -%}
              {%- assign cells = line | strip | split: ',' -%}
              {%- if cells.size > 0 -%}
                <tr data-size-row="{{ cells.first | strip | escape }}">
                  {%- for cell in cells -%}
                    {%- assign value = cell | strip -%}
                    {%- if forloop.first -%}
                      <th scope="row">{{ value | escape }}</th>
                    {%- else -%}
                      <td data-value="{{ value | escape }}">{{ value | escape }}</td>
                    {%- endif -%}
                  {%- endfor -%}
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      {%- if note != blank -%}<p class="size-guide__note text-muted">{{ note | escape }}</p>{%- endif -%}
    </nk-size-guide>
  {%- elsif page != blank -%}
    <div class="size-chart">{{ page.content }}</div>
  {%- endif -%}
{%- elsif page != blank -%}
  <div class="size-chart">{{ page.content }}</div>
{%- endif -%}
