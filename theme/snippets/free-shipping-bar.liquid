{%- doc -%}
  Free shipping progress for the cart drawer and cart page (Theme settings > Cart). Rendered inside
  the cart's re-rendered region, so it updates with every cart change. Liquid has no exchange
  rates, so the bar is only shown when the shopper uses the store's default currency, and only
  when the cart needs shipping.

  @example
  {% render 'free-shipping-bar' %}
{%- enddoc -%}
{%- liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign show_bar = false
  if settings.cart_free_shipping and threshold > 0 and cart.requires_shipping and cart.currency.iso_code == shop.currency
    assign show_bar = true
  endif
-%}
{%- if show_bar -%}
  {%- liquid
    assign total = cart.total_price
    assign remaining = threshold | minus: total
    assign progress = total | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
    assign progress_ratio = progress | divided_by: 100.0
    assign remaining_money = remaining | money
  -%}
  <div class="shipping-bar{% if remaining <= 0 %} shipping-bar--done{% endif %}" style="--shipping-progress: {{ progress_ratio }};">
    <p class="shipping-bar__text spec">
      {%- if remaining > 0 -%}
        {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
      {%- else -%}
        {{ 'cart.free_shipping_unlocked' | t }}
      {%- endif -%}
    </p>
    <span class="shipping-bar__track" aria-hidden="true"><span class="shipping-bar__fill"></span></span>
  </div>
{%- endif -%}
