{%- doc -%}
  One cart line, shared by the cart drawer and the cart page.
  Works without JS as part of a cart form (updates[] input + remove link); <nk-cart-items>
  enhances the steppers and remove control to use the cart queue.

  @param {object} item - The line item
  @param {string} context - 'drawer' or 'page' (used for unique ids)
  @param {boolean} [show_image] - Render line photography (default true)

  @example
  {% render 'line-item', item: item, context: 'drawer' %}
{%- enddoc -%}
{%- liquid
  assign rule = item.variant.quantity_rule
  assign line_id = item.key | replace: ':', '-'
  assign id_prefix = context | append: '-' | append: line_id
-%}
<li class="cart-line" data-line-key="{{ item.key }}" {% if show_image == false %}data-no-image{% endif %}>
  {% unless show_image == false %}
  <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', sizes: '84px', alt: '' }}
    {%- endif -%}
  </a>
  {% endunless %}

  <div class="cart-line__info">
    <div class="cart-line__top">
      <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
      <span class="price">
        {{- item.final_line_price | money -}}
        {%- if item.original_line_price != item.final_line_price -%}
          <s class="price__compare">{{ item.original_line_price | money }}</s>
        {%- endif -%}
      </span>
    </div>

    {%- unless item.product.has_only_default_variant -%}
      <p class="spec">
        {%- for option in item.options_with_values -%}
          <span>{{ option.name | escape }}: {{ option.value | escape }}</span>{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="spec text-muted">{{ property.first | escape }}: {{ property.last | escape }}</p>
      {%- endif -%}
    {%- endfor -%}

    {%- if item.selling_plan_allocation -%}
      <p class="spec text-muted">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}

    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-line__discount spec">
        {% render 'icon', name: 'tag', size: 12 %}
        <span>{{ discount.discount_application.title | escape }}</span>
        <span>−{{ discount.amount | money }}</span>
      </p>
    {%- endfor -%}

    <div class="cart-line__controls">
      <div class="quantity">
        <button type="button" class="icon-button" data-qty-step="-1" data-focus-key="minus-{{ item.key }}" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">
          {% render 'icon', name: 'minus', size: 16 %}
        </button>
        <label class="visually-hidden" for="Qty-{{ id_prefix }}">{{ 'cart.quantity_for' | t: title: item.product.title }}</label>
        <input
          id="Qty-{{ id_prefix }}"
          type="number"
          inputmode="numeric"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          data-quantity-min="{{ rule.min | default: 1 }}"
          {% if rule.max %}max="{{ rule.max }}"{% endif %}
          step="{{ rule.increment | default: 1 }}"
          data-qty-input
          data-focus-key="qty-{{ item.key }}"
        >
        <button type="button" class="icon-button" data-qty-step="1" data-focus-key="plus-{{ item.key }}" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">
          {% render 'icon', name: 'plus', size: 16 %}
        </button>
      </div>
      <a class="cart-line__remove" href="{{ item.url_to_remove }}" data-line-remove data-focus-key="remove-{{ item.key }}">
        {{- 'cart.remove' | t -}}
        <span class="visually-hidden">{{ item.product.title | escape }}</span>
      </a>
    </div>

    <p class="cart-line__error" data-line-error role="alert" hidden></p>
  </div>
</li>
