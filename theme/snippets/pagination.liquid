{%- doc -%}
  Accessible numbered pagination with real links (master-plan D-16).

  @param {object} paginate - The paginate object

  @example
  {% render 'pagination', paginate: paginate %}
{%- enddoc -%}
<nav aria-label="{{ 'general.pagination' | t }}">
  <ul class="pagination" role="list">
    {%- if paginate.previous -%}
      <li>
        <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous_page' | t }}">
          {%- render 'icon', name: 'arrow-left', size: 18 -%}
        </a>
      </li>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      <li>
        {%- if part.is_link -%}
          <a href="{{ part.url }}" aria-label="{{ 'general.page_n' | t: number: part.title }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span>{{ part.title }}</span>
        {%- endif -%}
      </li>
    {%- endfor -%}
    {%- if paginate.next -%}
      <li>
        <a href="{{ paginate.next.url }}" aria-label="{{ 'general.next_page' | t }}">
          {%- render 'icon', name: 'arrow-right', size: 18 -%}
        </a>
      </li>
    {%- endif -%}
  </ul>
</nav>
