{%- doc -%}
  Native customer newsletter form, shared by footer and standalone signup sections.
  @param {string} id - Unique form ID supplied by the section
  @param {string} [class] - Additional form classes
{%- enddoc -%}
{%- assign email_id = id | append: '-email' -%}
{%- assign error_id = id | append: '-error' -%}
{%- form 'customer', id: id, class: class -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  <label class="visually-hidden" for="{{ email_id }}">{{ 'footer.email' | t }}</label>
  <div class="footer__email-row newsletter-form__row">
    <input id="{{ email_id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'footer.email' | t }}" required {% if form.errors %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}>
    <button type="submit" aria-label="{{ 'footer.subscribe' | t }}">{{ 'footer.subscribe' | t }} <span aria-hidden="true">↗</span></button>
  </div>
  {%- if form.posted_successfully? -%}
    <p class="footer__form-message" role="status">{{ 'footer.subscribed' | t }}</p>
  {%- elsif form.errors -%}
    <div id="{{ error_id }}" class="footer__form-message" role="alert">{{ form.errors | default_errors }}</div>
  {%- endif -%}
{%- endform -%}
{%- if shop.privacy_policy != blank -%}
  <p class="footer__privacy"><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></p>
{%- endif -%}
