{%- doc -%}
  Purchase data for one product in the featured carousel (src/components/carousel/product-data.ts).
  The size option is the first option recognised by snippets/size-option.liquid (the same rule as
  product cards and the product page), otherwise the product's first option. Shopify re-checks
  availability when the variant is added.

  @param {object} product - The product

  @example
  {% render 'carousel-product-data', product: product %}
{%- enddoc -%}
{%- liquid
  assign choice = nil
  for option in product.options_with_values
    capture is_size
      render 'size-option', name: option.name
    endcapture
    if is_size == 'true'
      assign choice = option
      break
    endif
  endfor
  if choice == nil and product.has_only_default_variant == false
    assign choice = product.options_with_values | first
  endif
  assign preferred = product.selected_or_first_available_variant
-%}
<script type="application/json" data-carousel-product>
  {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "available": {{ product.available | json }},
    "sellingPlan": {{ product.requires_selling_plan | json }},
    "option": {% if choice %}{{ choice.position | minus: 1 }}{% else %}-1{% endif %},
    "optionName": {% if choice %}{{ choice.name | json }}{% else %}""{% endif %},
    "values": [
      {%- if choice -%}
        {%- for value in choice.values -%}
          {{ value.name | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {%- endif -%}
    ],
    "options": {{ product.options | json }},
    "preferred": {{ preferred.id | json }},
    "variants": [
      {%- for variant in product.variants -%}
        {"id": {{ variant.id | json }}, "available": {{ variant.available | json }}, "options": {{ variant.options | json }}, "min": {{ variant.quantity_rule.min | default: 1 | json }}}
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  }
</script>
{%- if choice -%}
  {% render 'carousel-measurements', product: product, size_option: choice %}
{%- endif -%}
