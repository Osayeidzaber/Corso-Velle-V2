{%- doc -%}
  A heading with an optional text animation (<nk-text>, rebuilt from the supplied Split Text,
  Fold Text and Text Effect examples) and text style. The text is always real HTML; the
  animation is an enhancement (see src/components/text).

  Entrances: none, rise, blur, flip, pop, skew, fold, fade. Older values still work:
  cut → blur, split-lines → rise by line, split-chars → rise by letter, wipe → skew.

  @param {string} text - Heading text (escaped)
  @param {string} [tag] - h1, h2 or h3 (default h2)
  @param {string} [entrance] - Entrance effect (see above)
  @param {string} [split] - chars, words or lines (default depends on the effect)
  @param {string} [hover] - none, lift (letters spring up near the pointer) or refold
  @param {string} [style] - none, shine, gradient (whole heading)
  @param {string} [italic] - Italic tail, rendered as <em> after the text
  @param {boolean} [italic_break] - Put the italic tail on its own line
  @param {string} [italic_style] - none or gradient (flowing gradient on the italic tail only)
  @param {string} [class] - Extra classes for the heading
  @param {boolean} [play_on_load] - Play immediately (hero headings)

  @example
  {% render 'reveal-heading', text: heading, entrance: 'fold', hover: 'refold' %}
{%- enddoc -%}
{%- liquid
  assign tag = tag | default: 'h2'
  assign effect = entrance | default: 'none'
  assign by = split
  case effect
    when 'cut'
      assign effect = 'blur'
    when 'split-lines'
      assign effect = 'rise'
      if by == blank
        assign by = 'lines'
      endif
    when 'split-chars'
      assign effect = 'rise'
      if by == blank
        assign by = 'chars'
      endif
    when 'wipe'
      assign effect = 'skew'
  endcase
  if by == blank
    case effect
      when 'blur', 'fade', 'skew'
        assign by = 'words'
      else
        assign by = 'chars'
    endcase
  endif
  assign text_class = ''
  case style
    when 'shine'
      assign text_class = 'nk-text-shine'
    when 'gradient'
      assign text_class = 'nk-text-gradient'
  endcase
-%}
{%- capture heading -%}
  <{{ tag }} class="{{ class }}" data-text-target>
    {%- capture body -%}
      {{- text -}}
      {%- if italic != blank -%}
        {%- if italic_break %}<br>{% else %} {% endif -%}
        <em>{%- if italic_style == 'gradient' -%}<span class="nk-text-gradient nk-text-gradient--glow">{{ italic }}</span>{%- else -%}{{ italic }}{%- endif -%}</em>
      {%- endif -%}
    {%- endcapture -%}
    {%- if text_class != blank -%}<span class="{{ text_class }}">{{ body }}</span>{%- else -%}{{ body }}{%- endif -%}
  </{{ tag }}>
{%- endcapture -%}
{%- if effect == 'none' or request.design_mode -%}
  {{ heading }}
{%- else -%}
  <nk-text effect="{{ effect }}" split="{{ by }}"{% if hover != blank and hover != 'none' %} hover="{{ hover }}"{% endif %}{% if play_on_load %} play-on-load{% endif %}>{{ heading }}</nk-text>
{%- endif -%}
