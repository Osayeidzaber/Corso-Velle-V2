<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width,initial-scale=1">

{%- liquid
  # Native SEO fields always win. Fallbacks use the actual resource, never invented product facts.
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  capture description
    render 'seo-text', text: page_description
  endcapture
  if description == blank
    assign fallback_description = blank
    case request.page_type
      when 'product'
        assign fallback_description = product.description
      when 'collection'
        assign fallback_description = collection.description
        if fallback_description == blank and collection.all_products_count > 0
          capture fallback_description
            echo collection.title
            echo ' — '
            echo shop.name
            echo '. '
            echo 'collection.product_count' | t: count: collection.all_products_count
            echo '.'
          endcapture
        endif
      when 'page'
        assign fallback_description = page.content
      when 'article'
        assign fallback_description = article.excerpt_or_content
      when 'index'
        assign fallback_description = shop.description
    endcase
    if fallback_description == blank and request.path contains '/policies/'
      for policy in shop.policies
        if request.path == policy.url
          assign fallback_description = policy.body
          break
        endif
      endfor
      # This policy's visible body is supplied by the theme's native support snippet.
      if request.path contains '/policies/contact-information' and settings.support_replace_policy
        if settings.support_email != blank or settings.support_phone != blank or settings.support_instagram != blank
          assign fallback_description = settings.support_intro
        endif
      endif
    endif
    capture description
      render 'seo-text', text: fallback_description
    endcapture
    assign description = description | truncate: 180
  endif
  assign og_description = description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # Internal search results, cart, gift cards and account pages are not useful search landing
  # pages (Shopify's robots.txt no longer blocks /search or /cart). Links on them are still followed.
  assign robots = 'max-image-preview:large'
  if request.page_type == 'search' or request.page_type == 'cart' or template.name == 'gift_card' or template.directory == 'customers'
    assign robots = 'noindex, follow'
  endif
-%}

{%- if robots != blank %}
  <meta name="robots" content="{{ robots }}">
{%- endif %}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ og_url | escape }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- comment -%}
  page_image is the product, collection or article image, else the social sharing image set in
  Online Store > Preferences.
{%- endcomment -%}
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url: width: 1200 }}">
  {%- if page_image.width < 1200 %}
    <meta property="og:image:width" content="{{ page_image.width }}">
    <meta property="og:image:height" content="{{ page_image.height }}">
  {%- else %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="{{ page_image.height | times: 1200 | divided_by: page_image.width }}">
  {%- endif %}
  {%- if page_image.alt != blank %}
    <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif %}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign og_variant = product.selected_or_first_available_variant %}
  <meta property="og:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif %}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

<title>
  {{ og_title | escape }}
  {%- if current_tags %}{% assign tag_list = current_tags | join: ', ' %} &ndash; {{ 'general.tagged' | t: tags: tag_list }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page_n' | t: number: current_page }}{% endif -%}
  {%- assign title_lower = og_title | downcase -%}
  {%- assign shop_lower = shop.name | downcase -%}
  {%- unless title_lower contains shop_lower %} &ndash; {{ shop.name | escape }}{% endunless -%}
</title>

<link rel="canonical" href="{{ canonical_url | escape }}">

{%- if description != blank %}
  <meta name="description" content="{{ description | escape }}">
{%- endif %}

{% render 'structured-data' %}
