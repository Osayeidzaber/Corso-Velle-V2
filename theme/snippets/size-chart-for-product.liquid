{%- doc -%}
  A product's size guide from its own data or the theme's size chart rules (Theme settings), for
  places with no product page block settings. Prints nothing when the product has no real chart.

  @param {object} product - The product
{%- enddoc -%}
{%- liquid
  capture chart_assignment
    render 'size-chart-assignment', product: product
  endcapture
  assign assignment_parts = chart_assignment | strip | split: ':'
  assign chart_rule = ''
  assign assigned_chart = product.metafields.custom.size_chart.value
  assign size_table = ''
  assign size_image = nil
  assign size_unit = 'in'
  assign size_heading = ''
  assign size_note = ''
  case assignment_parts.first
    when 'collection'
      assign chart_collection = collections[assignment_parts.last]
      assign assigned_chart = chart_collection.metafields.custom.size_chart.value
    when 'default'
      assign default_chart_handle = settings.size_chart_default_handle | strip
      assign assigned_chart = metaobjects.size_chart[default_chart_handle]
    when 'rule'
      assign chart_rule = assignment_parts.last
  endcase
  if chart_rule != blank
    assign chart_prefix = 'size_chart_' | append: chart_rule
    assign handle_key = chart_prefix | append: '_handle'
    assign rule_handle = settings[handle_key] | strip
    assign rule_chart = metaobjects.size_chart[rule_handle]
    capture rule_chart_usable
      render 'size-chart-usable', chart: rule_chart
    endcapture
    if rule_chart_usable == 'true'
      assign assigned_chart = rule_chart
    endif
    assign table_key = chart_prefix | append: '_table'
    assign image_key = chart_prefix | append: '_image'
    assign unit_key = chart_prefix | append: '_unit'
    assign basis_key = chart_prefix | append: '_basis'
    assign note_key = chart_prefix | append: '_note'
    assign size_table = settings[table_key]
    assign size_image = settings[image_key]
    assign size_unit = settings[unit_key]
    assign size_heading = settings[basis_key]
    assign size_note = settings[note_key]
  endif
  render 'size-chart', product: product, chart: assigned_chart, image: size_image, table_csv: size_table, unit: size_unit, note: size_note, heading: size_heading, verified_chart: chart_rule, highlight: false
-%}
