{%- doc -%}
  Optional heading and intro text at the top of a section-kit section (docs/SECTION-SOURCES.md).
  Renders nothing when both are blank. Styles: src/styles/components/section-kit.css (.kit-intro),
  scaled by the section's Design → Heading size setting.

  @param {string} [heading] - Section heading
  @param {string} [text] - Rich text below the heading
  @param {string} [align] - left, center or right (default left)

  @example
  {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: 'center' %}
{%- enddoc -%}
{%- if heading != blank or text != blank -%}
  <div class="kit-intro" data-align="{{ align | default: 'left' }}">
    {%- if heading != blank -%}<h2 class="kit-intro__heading">{{ heading | escape }}</h2>{%- endif -%}
    {%- if text != blank -%}<div class="rte text-muted kit-intro__text">{{ text }}</div>{%- endif -%}
  </div>
{%- endif -%}
