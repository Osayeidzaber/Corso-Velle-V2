{%- doc -%}
  Filter drawer, sort and active filter chips for a collection or search grid (master-plan/07
  DC-02). It is one plain GET form: without JS the drawer content renders inline and Apply / the
  sort button submit it. <nk-facets> intercepts submit, sort changes and chip links, re-renders
  the section through Section Rendering and keeps the URL (filter.*, sort_by) in history.

  The drawer edits a draft: closing it without applying restores the applied state.

  @param {object} results - The collection or search object
  @param {string} section_id - The owning section id (unique form and drawer ids)
  @param {string} results_url - URL of the unfiltered results (collection.url or the search URL)
  @param {number} count - Number of results for the current filters
  @param {boolean} [show_filters] - Show the Filter button and drawer (default true)
  @param {boolean} [show_sort] - Show the sort select (default true)
  @param {string} [terms] - Search terms (search page only; kept as hidden fields)

  @example
  {% render 'facets', results: collection, section_id: section.id, results_url: collection.url, count: collection.products_count %}
{%- enddoc -%}
{%- liquid
  if show_filters == nil
    assign show_filters = true
  endif
  if show_sort == nil
    assign show_sort = true
  endif
  if results.filters.size == 0
    assign show_filters = false
  endif

  assign sort_by = results.sort_by | default: results.default_sort_by
  assign active_count = 0
  for filter in results.filters
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign active_count = active_count | plus: 1
      endif
    else
      assign active_count = active_count | plus: filter.active_values.size
    endif
  endfor

  assign form_id = 'FacetsForm-' | append: section_id
  assign drawer_id = 'FacetsDrawer-' | append: section_id
  if terms != blank
    assign clear_url = results_url | append: '&sort_by=' | append: sort_by
  else
    assign clear_url = results_url | append: '?sort_by=' | append: sort_by
  endif
-%}
<form id="{{ form_id }}" class="facets" action="{{ results_url | split: '?' | first }}" method="get" data-facets-form>
  {%- if terms != blank -%}
    <input type="hidden" name="q" value="{{ terms | escape }}">
    <input type="hidden" name="options[prefix]" value="last">
  {%- endif -%}

  <div class="facets__toolbar">
    {%- if show_filters -%}
      <button
        type="button"
        class="button button--secondary facets__open"
        data-nk-open="{{ drawer_id }}"
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="{{ drawer_id }}"
        data-focus-key="facets-open"
      >
        {{- 'facets.filter' | t -}}
        {%- if active_count > 0 %} <span class="facets__count">({{ active_count }})</span>{% endif -%}
      </button>
    {%- endif -%}

    <p class="facets__results spec text-muted" data-results-label>{{ 'collection.product_count' | t: count: count }}</p>

    {%- if show_sort and results.sort_options.size > 0 -%}
      <div class="facets__sort">
        <label class="spec" for="Sort-{{ section_id }}">{{ 'facets.sort_by' | t }}</label>
        <select id="Sort-{{ section_id }}" name="sort_by" data-facets-sort data-focus-key="facets-sort">
          {%- for option in results.sort_options -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
              {{- option.name | escape -}}
            </option>
          {%- endfor -%}
        </select>
        <button type="submit" class="button button--secondary no-js-only">{{ 'facets.apply' | t }}</button>
      </div>
    {%- elsif results.sort_by != blank -%}
      <input type="hidden" name="sort_by" value="{{ results.sort_by | escape }}">
    {%- endif -%}
  </div>

  {%- if show_filters -%}
    <nk-modal id="{{ drawer_id }}">
      <dialog class="drawer drawer--right facets__drawer" aria-labelledby="FacetsTitle-{{ section_id }}">
        <div class="drawer__header">
          <h2 class="drawer__title spec" id="FacetsTitle-{{ section_id }}" tabindex="-1" data-autofocus>{{ 'facets.filter' | t }}</h2>
          <button type="button" class="icon-button" data-nk-close aria-label="{{ 'general.close' | t }}">
            {% render 'icon', name: 'close' %}
          </button>
        </div>

        <div class="drawer__body facets__body">
          {%- for filter in results.filters -%}
            {%- liquid
              assign group_active = filter.active_values.size
              if filter.type == 'price_range'
                assign group_active = 0
                if filter.min_value.value != nil or filter.max_value.value != nil
                  assign group_active = 1
                endif
              endif
            -%}
            <nk-disclosure>
              <details class="disclosure facets__group" {% if forloop.index <= 2 or group_active > 0 %}open{% endif %}>
                <summary>
                  {{- filter.label | escape -}}
                  {%- if group_active > 0 %} <span class="facets__count">({{ group_active }})</span>{% endif -%}
                </summary>
                <div class="disclosure__content">
                  {%- case filter.type -%}
                    {%- when 'price_range' -%}
                      {%- liquid
                        assign max_price = filter.range_max | divided_by: 100.0 | ceil
                        assign min_value = ''
                        assign max_value = ''
                        if filter.min_value.value != nil
                          assign min_value = filter.min_value.value | divided_by: 100.0
                        endif
                        if filter.max_value.value != nil
                          assign max_value = filter.max_value.value | divided_by: 100.0
                        endif
                      -%}
                      <fieldset class="facets__price">
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        <label class="facets__price-field">
                          <span class="spec text-muted">{{ 'facets.from' | t }} ({{ cart.currency.symbol }})</span>
                          <input
                            type="number"
                            inputmode="decimal"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ min_value }}"
                            min="0"
                            max="{{ max_price }}"
                            step="any"
                            placeholder="0"
                          >
                        </label>
                        <label class="facets__price-field">
                          <span class="spec text-muted">{{ 'facets.to' | t }} ({{ cart.currency.symbol }})</span>
                          <input
                            type="number"
                            inputmode="decimal"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ max_value }}"
                            min="0"
                            max="{{ max_price }}"
                            step="any"
                            placeholder="{{ max_price }}"
                          >
                        </label>
                      </fieldset>

                    {%- else -%}
                      <fieldset>
                        <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                        <ul class="facets__values{% if filter.presentation == 'swatch' %} facets__values--swatch{% endif %}" role="list">
                          {%- for value in filter.values -%}
                            {%- liquid
                              assign value_id = 'Facet-' | append: section_id | append: '-' | append: filter.param_name | append: '-' | append: forloop.index | handleize
                              assign disabled = false
                              if value.count == 0 and value.active == false
                                assign disabled = true
                              endif
                            -%}
                            <li class="facets__value{% if disabled %} facets__value--disabled{% endif %}">
                              <input
                                type="checkbox"
                                id="{{ value_id }}"
                                name="{{ value.param_name }}"
                                value="{{ value.value | escape }}"
                                {% if value.active %}checked{% endif %}
                                {% if disabled %}disabled{% endif %}
                              >
                              <label for="{{ value_id }}">
                                {%- if filter.presentation == 'swatch' and value.swatch -%}
                                  {%- if value.swatch.image -%}
                                    {%- assign swatch_bg = value.swatch.image | image_url: width: 48 | prepend: 'url(' | append: ')' -%}
                                  {%- else -%}
                                    {%- assign swatch_bg = value.swatch.color -%}
                                  {%- endif -%}
                                  <span class="option__swatch" style="--swatch: {{ swatch_bg }}" aria-hidden="true"></span>
                                {%- endif -%}
                                <span>{{ value.label | escape }}</span>
                                <span class="text-muted">({{ value.count }})</span>
                              </label>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </fieldset>
                  {%- endcase -%}
                </div>
              </details>
            </nk-disclosure>
          {%- endfor -%}
        </div>

        <div class="drawer__footer facets__footer">
          <a class="button button--secondary" href="{{ clear_url }}" data-facets-reset>{{ 'facets.clear_all' | t }}</a>
          <button type="submit" class="button">{{ 'facets.show_results' | t }}</button>
        </div>
      </dialog>
    </nk-modal>
  {%- endif -%}
</form>

{%- if active_count > 0 -%}
  <ul class="facets__active" role="list" aria-label="{{ 'facets.active' | t }}">
    {%- for filter in results.filters -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
          {%- liquid
            assign from = filter.min_value.value | default: 0 | money
            assign to = filter.max_value.value | default: filter.range_max | money
          -%}
          <li>
            <a class="facets__chip" href="{{ filter.url_to_remove }}" data-facets-link>
              <span>{{ from }}–{{ to }}</span>
              <span class="visually-hidden">{{ 'facets.remove' | t }}</span>
              {% render 'icon', name: 'close', size: 14 %}
            </a>
          </li>
        {%- endif -%}
      {%- else -%}
        {%- for value in filter.active_values -%}
          <li>
            <a class="facets__chip" href="{{ value.url_to_remove }}" data-facets-link>
              <span>{{ filter.label | escape }}: {{ value.label | escape }}</span>
              <span class="visually-hidden">{{ 'facets.remove' | t }}</span>
              {% render 'icon', name: 'close', size: 14 %}
            </a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    {%- endfor -%}
    <li><a class="facets__clear" href="{{ clear_url }}" data-facets-link>{{ 'facets.clear_all' | t }}</a></li>
  </ul>
{%- endif -%}

<p class="message message--error facets__error" data-facets-error role="alert" hidden>
  {{ 'facets.update_failed' | t }}
  <a href="{{ request.path }}">{{ 'facets.reload' | t }}</a>
</p>
