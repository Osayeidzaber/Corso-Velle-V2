{%- assign source = section.settings.collection -%}
{%- assign light_panels = section.settings.light_text_panels | remove: ' ' | split: ',' -%}
{%- liquid
  assign ss = section.settings
  capture gallery_vars
    echo '--gallery-text: ' | append: ss.text_color | append: ';'
    echo '--gallery-panel-bg: ' | append: ss.panel_color | append: ';'
    echo '--gallery-details-bg: ' | append: ss.details_color | append: ';'
    echo '--gallery-details-text: ' | append: ss.details_text_color | append: ';'
    echo '--gallery-label: ' | append: ss.label_color | append: ';'
    echo '--gallery-label-light: ' | append: ss.label_light_color | append: ';'
    echo '--gallery-heading-size: ' | append: ss.heading_size | append: 'px;'
    echo '--gallery-title-size: ' | append: ss.title_size | append: 'px;'
    echo '--gallery-label-size: ' | append: ss.label_size | append: 'px;'
    echo '--gallery-grow: ' | append: ss.expand_ratio | append: ';'
    echo '--gallery-gap: ' | append: ss.gap | append: 'px;'
    echo '--gallery-radius: ' | append: ss.radius | append: 'px;'
    echo '--gallery-details-height: ' | append: ss.details_height | append: 'px;'
    echo '--gallery-fit: ' | append: ss.image_fit | append: ';'
    echo '--gallery-speed: ' | append: ss.speed | append: 'ms;'
    echo '--gallery-mobile-height: ' | append: ss.mobile_height | append: 'px;'
    echo '--gallery-mobile-collapsed: ' | append: ss.mobile_collapsed | append: 'px;'
  endcapture
-%}
<section class="accordion-gallery full-width section-spacing color-{{ section.settings.color_scheme }}" style="{{ gallery_vars | strip_newlines }}"{% if ss.heading != blank %} aria-labelledby="GalleryHeading-{{ section.id }}"{% endif %}>
  <div class="accordion-gallery__inner">
    {%- if ss.eyebrow != blank or ss.heading != blank or ss.description != blank -%}
    <div class="accordion-gallery__header">
      <div>
        {% if section.settings.eyebrow != blank %}<p class="accordion-gallery__eyebrow spec">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="accordion-gallery__heading" id="GalleryHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>{% endif %}
      </div>
      {% if section.settings.description != blank %}<p class="accordion-gallery__intro">{{ section.settings.description | escape }}</p>{% endif %}
    </div>
    {%- endif -%}
    <nk-accordion-gallery
      style="--gallery-height: {{ ss.height }}px;"
      data-start-panel="{{ ss.start_panel }}"
      data-hover="{{ ss.open_on_hover }}"
      data-hover-delay="{{ ss.hover_delay }}"
      {% if ss.click_through %}data-click-through{% endif %}
      {% unless ss.show_numbers %}data-hide-numbers{% endunless %}
      {% unless ss.show_price %}data-hide-price{% endunless %}
      {% unless ss.show_link %}data-hide-link{% endunless %}
    >
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          {% assign panel_id = 'GalleryPanel-' | append: section.id | append: '-' | append: block.id %}
          {% if block.type == 'product' %}
            {%- assign panel_product = block.settings.product -%}
            {%- assign panel_image = block.settings.image | default: panel_product.featured_image -%}
            {%- assign panel_title = block.settings.title | default: panel_product.title -%}
            {% render 'accordion-gallery-panel', image: panel_image, title: panel_title, link: panel_product.url, product: panel_product, id: panel_id, index: forloop.index, link_label: section.settings.link_label, light_text: block.settings.light_text, block: block %}
          {% else %}
            {% render 'accordion-gallery-panel', image: block.settings.image, title: block.settings.title, link: block.settings.link, id: panel_id, index: forloop.index, link_label: section.settings.link_label, light_text: block.settings.light_text, block: block %}
          {% endif %}
        {% endfor %}
      {% elsif source.products.size > 0 %}
        {% for product in source.products limit: section.settings.limit %}
          {% assign panel_id = 'GalleryPanel-' | append: section.id | append: '-' | append: product.id %}
          {%- assign panel_number = forloop.index | append: '' -%}
          {%- if light_panels contains panel_number -%}{%- assign panel_light = true -%}{%- else -%}{%- assign panel_light = false -%}{%- endif -%}
          {% render 'accordion-gallery-panel', image: product.featured_image, title: product.title, link: product.url, product: product, id: panel_id, index: forloop.index, link_label: section.settings.link_label, light_text: panel_light %}
        {% endfor %}
      {% else %}
        {% for index in (1..4) %}
          {% assign panel_id = 'GalleryPanel-' | append: section.id | append: '-' | append: index %}
          {% render 'accordion-gallery-panel', title: section.settings.heading, id: panel_id, index: index, link_label: section.settings.link_label %}
        {% endfor %}
      {% endif %}
    </nk-accordion-gallery>
  </div>
</section>
{% schema %}
{
  "name": "Accordion gallery",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection, in focus" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore the collection" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 36, "max": 110, "step": 2, "unit": "px", "default": 76 },
    { "type": "text", "id": "description", "label": "Description", "default": "Everyday pieces. A closer look at the details." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Product collection", "info": "Product and image panels take priority when added." },
    { "type": "range", "id": "limit", "label": "Product panels", "min": 2, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "light_text_panels", "label": "Light text on panels", "info": "For dark product photos. Panel numbers separated by commas, e.g. 2, 4. Applies to collection panels; added panels have their own setting." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "height", "label": "Desktop height", "min": 420, "max": 760, "step": 20, "unit": "px", "default": 580 },
    { "type": "range", "id": "expand_ratio", "label": "Open panel width", "info": "How many times wider the open panel is than a closed one.", "min": 2, "max": 7, "step": 1, "default": 4 },
    { "type": "range", "id": "gap", "label": "Space between panels", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "radius", "label": "Corner radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "details_height", "label": "Info box height", "min": 120, "max": 260, "step": 4, "unit": "px", "default": 168 },
    { "type": "select", "id": "image_fit", "label": "Image fit", "options": [{ "value": "cover", "label": "Fill panel" }, { "value": "contain", "label": "Show whole image" }], "default": "cover" },
    { "type": "range", "id": "mobile_height", "label": "Mobile open panel height", "min": 360, "max": 680, "step": 10, "unit": "px", "default": 510 },
    { "type": "range", "id": "mobile_collapsed", "label": "Mobile closed panel height", "min": 56, "max": 120, "step": 2, "unit": "px", "default": 76 },
    { "type": "header", "content": "Panel text" },
    { "type": "range", "id": "label_size", "label": "Closed panel title size", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 30 },
    { "type": "range", "id": "title_size", "label": "Open panel title size", "min": 18, "max": 48, "step": 1, "unit": "px", "default": 34 },
    { "type": "checkbox", "id": "show_numbers", "label": "Show panel numbers", "default": true },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "checkbox", "id": "show_link", "label": "Show shop link", "default": true },
    { "type": "text", "id": "link_label", "label": "Panel link text", "default": "Shop the piece" },
    { "type": "header", "content": "Colors" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "color", "id": "text_color", "label": "Heading text", "default": "#432d23" },
    { "type": "color", "id": "panel_color", "label": "Panel background", "default": "#eee9e1" },
    { "type": "color", "id": "label_color", "label": "Panel titles", "default": "#432d23" },
    { "type": "color", "id": "label_light_color", "label": "Panel titles (light text)", "default": "#fff9f0" },
    { "type": "color", "id": "details_color", "label": "Info box background", "default": "#432d23" },
    { "type": "color", "id": "details_text_color", "label": "Info box text", "default": "#fff9f0" },
    { "type": "header", "content": "Behavior" },
    { "type": "range", "id": "start_panel", "label": "Panel open on load", "min": 1, "max": 6, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "open_on_hover", "label": "Open panels on hover", "default": true },
    { "type": "range", "id": "hover_delay", "label": "Hover delay", "min": 0, "max": 600, "step": 20, "unit": "ms", "default": 160 },
    { "type": "checkbox", "id": "click_through", "label": "Click open picture to go to product", "default": true },
    { "type": "range", "id": "speed", "label": "Animation speed", "info": "Lower is faster.", "min": 400, "max": 2000, "step": 100, "unit": "ms", "default": 1200 }
  ],
  "max_blocks": 6,
  "blocks": [
    { "type": "product", "name": "Product panel", "settings": [
      { "type": "product", "id": "product", "label": "Product" },
      { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Uses the product's main image when empty." },
      { "type": "text", "id": "title", "label": "Title", "info": "Optional. Uses the product title when empty." },
      { "type": "checkbox", "id": "light_text", "label": "Light text", "info": "Use for dark product photos.", "default": false }
    ] },
    { "type": "panel", "name": "Image panel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Everyday essentials" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "checkbox", "id": "light_text", "label": "Light text", "info": "Use for dark photos.", "default": false }
    ] }
  ],
  "presets": [{ "name": "Accordion gallery" }],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
