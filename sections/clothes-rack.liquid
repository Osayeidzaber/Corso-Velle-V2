{%- comment -%}
  Clothes rack — products hang edge-on from a rail and move on springs: hovering one turns it to
  face the visitor, hangers can be dragged along the rail and shove each other aside, and a click
  lifts one into a focused view with a draggable Front/Back spin, prev/next and colourway tags
  (custom.color_siblings). See src/components/clothes-rack.
  Pieces come from "Hang" blocks first, otherwise from the collection. Each piece uses its
  first photo as the front and, by default, its second as the back; blocks can override both.
  Without JS the rail is a plain row of product links.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rack_products = s.collection.products
  assign picked = section.blocks | where: 'type', 'piece'
  assign limit = s.limit
  if picked.size > 0
    assign limit = picked.size
  elsif s.collection != blank and rack_products.size < limit
    assign limit = rack_products.size
  endif
  assign cta_label = s.cta_label | default: 'See availability'
-%}
<nk-clothes-rack
  class="clothes-rack section-spacing section-presentation color-{{ s.color_scheme }} full-width"
  style="{% render 'section-presentation', presentation: s %}--rack-count: {{ limit }}; --rack-garment: {{ s.garment_size }}rem; --rack-garment-phone: {{ s.garment_size_mobile }}vw; --rack-slot: {{ s.spacing }}; --rack-collar: {{ s.collar_overlap }}%; --rack-collar-n: {{ s.collar_overlap }}; --rack-hanger-n: {% if s.hanger_style == 'none' %}0{% else %}{{ s.hanger_width }}{% endif %}; --rack-side: {{ s.side_angle }}deg; --rack-vary: {{ s.angle_vary }}deg; --rack-room: {{ s.face_room | divided_by: 100.0 }}; --rack-depth: {{ s.depth }}px; --rack-hero-scale: {{ s.focus_size | divided_by: 100.0 }}; --rack-rail-h: {{ s.rail_thickness }}px; --rack-hanger-w: {{ s.hanger_width }}%; --rack-shadow: {{ s.wall_shadow | divided_by: 100.0 }}; --rack-glow: {{ s.backdrop_glow }}%; --rack-heading-gap: {{ s.heading_gap }}px; --rack-heading-scale: {{ s.heading_scale | divided_by: 100.0 }}; --rack-rail-top: {{ s.rail_top }}px; --rack-rail-shadow: {{ s.rail_shadow | divided_by: 100.0 }}; --rack-end-scale: {{ s.rail_end_size | divided_by: 100.0 }}; --rack-frame-w: {{ s.frame_thickness }}px; --rack-floor-gap: {{ s.floor_gap }}px; --rack-floor-shadow: {{ s.floor_shadow | divided_by: 100.0 }}; --rack-inner-dark: {{ s.far_side_brightness | divided_by: 100.0 }}; --rack-hanger-line: {{ s.hanger_line | divided_by: 100.0 }}; --rack-tag-scale: {{ s.tag_size | divided_by: 100.0 }}; --rack-label-scale: {{ s.label_size | divided_by: 100.0 }}; --rack-meta-w: {{ s.details_width }}rem; --rack-name-scale: {{ s.name_size | divided_by: 100.0 }}; --rack-cta-gap: {{ s.cta_gap }}px; --rack-cta-radius: {{ s.cta_radius }}px; --rack-cta-scale: {{ s.cta_size | divided_by: 100.0 }}; --rack-arrow-size: {{ s.arrow_size }}rem; --rack-slot-phone: {{ s.spacing_mobile }}; --rack-hero-scale-phone: {{ s.focus_size_mobile | divided_by: 100.0 }}; --rack-phone-lines: {{ s.description_lines_mobile }};{% if s.wall_color != blank %} --rack-wall-color: {{ s.wall_color }};{% endif %}{% if s.floor_color != blank %} --rack-floor-color: {{ s.floor_color }};{% endif %}{% if s.hook_color != blank %} --rack-hook-color: {{ s.hook_color }};{% endif %}{% if s.tag_color != blank %} --rack-tag-bg: {{ s.tag_color }};{% endif %}{% if s.tag_text_color != blank %} --rack-tag-fg: {{ s.tag_text_color }};{% endif %}{% if s.cta_color != blank %} --rack-cta-fg: {{ s.cta_color }};{% endif %}{% if s.cta_text_color != blank %} --rack-cta-bg: {{ s.cta_text_color }};{% endif %}{% if s.label_color != blank %} --rack-label-color: {{ s.label_color }};{% endif %}{% if s.rail_finish == 'custom' %} --rack-rail: {{ s.rail_color }};{% endif %}{% if s.hanger_color != blank %} --rack-hanger-color: {{ s.hanger_color }};{% endif %}"
  {% if s.knock_out_white %}data-knockout{% endif %}
  data-front-scale="{{ s.front_scale }}"
  data-thickness="{{ s.far_side }}"
  data-brush="{{ s.brush }}"
  data-leave-ms="{{ s.leave_delay }}"
  data-coast-ms="{{ s.coast_ms }}"
  data-arc="{{ s.lift_arc }}"
  data-lean="{{ s.lift_lean }}"
  data-phone-swing="{{ s.swing_mobile }}"
  data-cut-tolerance="{{ s.cut_tolerance }}"
  data-shadow-blur="{{ s.shadow_blur }}"
  data-shadow-distance="{{ s.shadow_distance }}"
  data-editor-motion="{{ s.editor_motion }}"
  data-cta-style="{{ s.cta_style }}"
  data-cta-align="{{ s.cta_align }}"
  data-arrow-style="{{ s.arrow_style }}"
  data-meta-side="{{ s.details_side }}"
  data-label-case="{{ s.label_case }}"
  data-floor-line="{{ s.floor_line }}"
  data-casters="{{ s.show_casters }}"
  data-phone-snap="{{ s.snap_mobile }}"
  data-phone-rail="{{ s.rail_mobile }}"
  data-phone-arrows="{{ s.arrows_mobile }}"
  data-rack-style="{{ s.rack_style }}"
  data-room-style="{{ s.room_style }}"
  data-cut-out="{% if s.knock_out_white and s.cut_out %}true{% else %}false{% endif %}"
  data-shading="{{ s.cloth_shading }}"
  data-shadow="{{ s.wall_shadow }}"
  data-rail="{% if s.show_rail %}{{ s.rail_finish }}{% else %}none{% endif %}"
  data-rail-ends="{{ s.rail_ends }}"
  data-rail-span="{{ s.rail_span }}"
  data-hanger="{{ s.hanger_style }}"
  data-layout="{{ s.focus_layout }}"
  data-side-angle="{{ s.side_angle }}"
  data-angle-vary="{{ s.angle_vary }}"
  data-room="{{ s.face_room }}"
  data-depth="{{ s.depth }}"
  data-depth-fade="{{ s.depth_fade }}"
  data-rail-fade="{{ s.rail_fade }}"
  data-feel="{{ s.feel }}"
  data-turn-speed="{{ s.turn_speed }}"
  data-turn-bounce="{{ s.turn_bounce }}"
  data-slide-speed="{{ s.slide_speed }}"
  data-slide-bounce="{{ s.slide_bounce }}"
  data-swing="{{ s.swing }}"
  data-swing-seconds="{{ s.swing_seconds }}"
  data-drape="{{ s.drape }}"
  data-entrance="{{ s.entrance }}"
  data-stagger="{{ s.entrance_stagger }}"
  data-autoplay="{{ s.autoplay }}"
  data-autoplay-seconds="{{ s.autoplay_seconds }}"
  data-turn-on="{{ s.turn_on }}"
  data-click-action="{{ s.click_action }}"
  data-drag="{{ s.allow_drag }}"
  data-spin-drag="{{ s.spin_drag }}"
  data-lift-ms="{{ s.lift_ms }}"
>
  {%- if s.heading != blank -%}
    {%- if s.heading_size == 'large' -%}
      <h2 class="clothes-rack__heading clothes-rack__heading--large" style="text-align: {{ s.heading_align }};">{{ s.heading | escape }}</h2>
    {%- else -%}
      <h2 class="clothes-rack__heading spec" style="text-align: {{ s.heading_align }};">{{ s.heading | escape }}</h2>
    {%- endif -%}
  {%- endif -%}

  <div class="clothes-rack__stage" data-ref="stage">
    {%- if s.room_style == 'room' -%}<div class="clothes-rack__floor" aria-hidden="true"></div>{%- endif -%}
    <div class="clothes-rack__rail" aria-hidden="true" data-ref="rail"></div>
    {%- if s.show_rail and s.rack_style == 'freestanding' -%}
      <div class="clothes-rack__frame" aria-hidden="true">
        <span class="clothes-rack__upright"></span>
        <span class="clothes-rack__upright"></span>
        {%- if s.show_base -%}<span class="clothes-rack__base"></span>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="clothes-rack__items" data-ref="list" role="list">
      {%- for i in (1..limit) -%}
        {%- liquid
          assign index0 = forloop.index0
          assign block = blank
          if picked.size > 0
            assign block = picked[index0]
            assign piece = block.settings.product
          else
            assign piece = rack_products[index0]
          endif
          assign front_asset = block.settings.front_asset | strip
          if piece == blank and front_asset == blank and request.design_mode == false
            continue
          endif

          assign front = block.settings.front_image | default: piece.featured_media.preview_image
          comment
            A photo file in the theme stands in until a photo is picked: the rail can hang before products exist.
          endcomment
          assign front_src = blank
          if block.settings.front_image == blank and front_asset != blank
            assign front = blank
            assign front_src = front_asset | asset_url
          endif
          assign back = block.settings.back_image
          assign side_photo = block.settings.side_image
          if back == blank and s.back_from_second
            for media in piece.media offset: 1 limit: 1
              assign back = media.preview_image
            endfor
          endif
          assign title = block.settings.name | default: piece.title | default: 'Product title'
          assign color_name = piece.metafields.custom.color_name.value
          assign siblings = piece.metafields.custom.color_siblings.value
          assign price = piece.price | money | strip_html

          assign description = ''
          if s.show_description
            assign description = block.settings.description
            if description == blank
              assign description = piece.description | strip_html | truncatewords: s.description_words
            endif
          endif

          assign hang_tag = ''
          case s.hang_tag
            when 'price'
              assign hang_tag = price
            when 'custom'
              assign hang_tag = block.settings.tag_text | default: price
          endcase

          comment
            Size stock for the availability button: "S~1|M~0|L~1" (1 = some variant in that size can be bought).
          endcomment
          assign sizes = ''
          if s.cta_sizes
            for option in piece.options_with_values
              assign option_name = option.name | downcase
              unless option_name contains 'size'
                continue
              endunless
              assign position = option.position | minus: 1
              for value in option.values
                assign in_stock = '0'
                for variant in piece.variants
                  if variant.options[position] == value and variant.available
                    assign in_stock = '1'
                    break
                  endif
                endfor
                assign entry = value | replace: '~', '-' | replace: '|', '/' | append: '~' | append: in_stock
                if sizes == blank
                  assign sizes = entry
                else
                  assign sizes = sizes | append: '|' | append: entry
                endif
              endfor
              break
            endfor
          endif
        -%}
        <li class="clothes-rack__item" data-ref="item" style="--i: {{ index0 }};{% if block.settings.piece_scale %} --rack-piece-scale: {{ block.settings.piece_scale | divided_by: 100.0 }}; --rack-collar-adjust: {{ block.settings.collar_adjust }}%;{% endif %}" {{ block.shopify_attributes }}>
          <a
            class="clothes-rack__garment"
            href="{{ piece.url | default: '#' }}"
            draggable="false"
            data-ref="garment"
            data-title="{{ title | escape }}"
            data-color="{{ color_name | escape }}"
            data-price="{% if s.show_price %}{{ price | escape }}{% endif %}"
            data-available="{% if piece.available or piece == blank %}1{% else %}0{% endif %}"
            data-sizes="{{ sizes | escape }}"
            data-description="{{ description | escape }}"
            data-details="{{ block.settings.details | escape }}"
            {% if back %}data-back="{{ back | image_url: width: 1100 }}"{% endif %}
            data-front="{% if front_src != blank %}{{ front_src }}{% else %}{{ front | image_url: width: 1100 }}{% endif %}"
          >
            <span class="clothes-rack__turn">
              {%- render 'clothes-rack-hanger', style: s.hanger_style -%}
              <span class="clothes-rack__photos">
                {%- if front_src != blank -%}
                  <img class="clothes-rack__img" src="{{ front_src }}" alt="" width="1100" height="1100" loading="lazy" draggable="false">
                {%- elsif front -%}
                  {{ front | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 750px) 30rem, 70vw', alt: '', draggable: 'false', class: 'clothes-rack__img' }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'clothes-rack__img clothes-rack__img--placeholder' }}
                {%- endif -%}
                {%- if side_photo -%}
                  {{ side_photo | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 750px) 30rem, 70vw', alt: '', draggable: 'false', class: 'clothes-rack__img clothes-rack__img--side' }}
                {%- endif -%}
              </span>
            </span>
            {%- if hang_tag != blank -%}
              <span class="clothes-rack__hangtag" aria-hidden="true"><span>{{ hang_tag | escape }}</span></span>
            {%- endif -%}
            {%- comment -%} Always rendered: it is the link's accessible name, shown or not. {%- endcomment -%}
            <span class="clothes-rack__label{% unless s.show_label %} visually-hidden{% endunless %}">
              <span class="clothes-rack__title">{{ title | escape }}</span>
              {%- if color_name != blank %} <span class="clothes-rack__color">— {{ color_name | escape }}</span>{% endif -%}
              {%- if s.label_price %} <span class="clothes-rack__label-price">· {{ price | escape }}</span>{% endif -%}
            </span>
          </a>
          {%- if siblings != blank and s.show_tags -%}
            <template data-ref="siblings">
              {%- for sibling in siblings -%}
                <a class="clothes-rack__tag{% if sibling.id == piece.id %} is-active{% endif %}" href="{{ sibling.url }}" aria-label="{{ sibling.title | escape }}"{% if sibling.id == piece.id %} aria-current="true"{% endif %}>
                  <span class="clothes-rack__tag-string" aria-hidden="true"></span>
                  {%- if sibling.featured_media -%}
                    {{ sibling.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 48, height: 60, alt: '' }}
                  {%- endif -%}
                </a>
              {%- endfor -%}
            </template>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.caption != blank -%}
      <p class="clothes-rack__caption">{{ s.caption | escape }}</p>
    {%- endif -%}

    {%- if s.click_action == 'focus' -%}
      <div class="clothes-rack__focus" data-ref="focus" role="dialog" aria-modal="false" aria-label="{{ s.heading | default: 'Clothes rack' | escape }}" hidden>
        {%- if s.show_arrows -%}
          <button type="button" class="clothes-rack__arrow clothes-rack__arrow--prev" data-ref="prev" aria-label="{{ 'carousel.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</button>
        {%- endif -%}
        <div class="clothes-rack__hero{% if s.spin_drag %} is-spinnable{% endif %}" data-ref="hero">
          <div class="clothes-rack__spin" data-ref="spin">
            {%- render 'clothes-rack-hanger', style: s.hanger_style -%}
            <div class="clothes-rack__faces">
              <img class="clothes-rack__face" data-ref="face" alt="" width="1100" height="1100" decoding="async" draggable="false">
              <img class="clothes-rack__face" data-ref="face-back" alt="" width="1100" height="1100" decoding="async" draggable="false" style="visibility: hidden;">
            </div>
          </div>
        </div>
        {%- if s.show_arrows -%}
          <button type="button" class="clothes-rack__arrow clothes-rack__arrow--next" data-ref="next" aria-label="{{ 'carousel.next' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
        {%- endif -%}
        <div class="clothes-rack__meta">
          <button type="button" class="clothes-rack__close spec" data-ref="close">{{ s.close_label | default: 'Back to rack' | escape }}</button>
          <h3 class="clothes-rack__name" data-ref="name" aria-live="polite"></h3>
          {%- if s.show_price -%}<p class="clothes-rack__price" data-ref="price"></p>{%- endif -%}
          {%- if s.show_description -%}<p class="clothes-rack__description" data-ref="description"></p>{%- endif -%}
          <ul class="clothes-rack__details" data-ref="details" role="list"></ul>
          {%- if s.show_sides -%}
            <div class="clothes-rack__sides" role="group" data-ref="sides">
              <button type="button" data-side="front" aria-pressed="true">{{ s.front_label | default: 'Front' | escape }}</button>
              <button type="button" data-side="back" aria-pressed="false">{{ s.back_label | default: 'Back' | escape }}</button>
            </div>
          {%- endif -%}
          {%- if s.show_tags -%}<div class="clothes-rack__tags" data-ref="tags"></div>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if s.show_cta -%}
      <div class="clothes-rack__cta">
        <a class="clothes-rack__availability" data-ref="cta" data-state="idle" data-soldout="{{ s.soldout_label | default: 'Sold out' | escape }}" href="{{ s.collection.url | default: routes.all_products_collection_url }}">
          <span class="clothes-rack__cta-text">
            <span class="clothes-rack__cta-label" data-text="{{ cta_label | escape }}"><span>{{ cta_label | escape }}</span></span>
            {%- if s.cta_name -%}<span class="clothes-rack__cta-for" data-ref="cta-for" aria-hidden="true"></span>{%- endif -%}
          </span>
          {%- if s.cta_sizes -%}<span class="clothes-rack__cta-sizes" aria-hidden="true"><span data-ref="sizes"></span></span>{%- endif -%}
          <span class="clothes-rack__cta-arrow" aria-hidden="true">{% render 'icon', name: 'arrow-right' %}</span>
          <span class="visually-hidden" data-ref="cta-context"></span>
        </a>
      </div>
    {%- endif -%}
  </div>
</nk-clothes-rack>

{% schema %}
{
  "name": "Clothes rack",
  "class": "clothes-rack-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Small label above the rail. Leave empty for none."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading style",
      "options": [
        {
          "value": "small",
          "label": "Small label"
        },
        {
          "value": "large",
          "label": "Large heading"
        }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_scale",
      "label": "Heading size",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Space under heading",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption",
      "info": "Shown under the rail until a piece is chosen. Leave empty for none."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when no \"Hang a product\" blocks are added. Works best with clean flat-lay photos on white."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Pieces on the rail",
      "min": 3,
      "max": 16,
      "step": 1,
      "default": 8,
      "info": "Used with a collection. With blocks, every block hangs."
    },
    {
      "type": "checkbox",
      "id": "back_from_second",
      "label": "Use the second photo as the back view",
      "default": true,
      "info": "Turn off if your second photo is a lifestyle shot. Blocks can set a back photo per piece."
    },
    {
      "type": "checkbox",
      "id": "knock_out_white",
      "label": "Blend white photo backgrounds into the section",
      "default": true,
      "info": "Makes white studio backgrounds disappear on light color schemes."
    },
    {
      "type": "checkbox",
      "id": "cut_out",
      "label": "Cut garments out of their white backgrounds",
      "default": false,
      "info": "Lets garments overlap each other and cast real shadows. Falls back to the blend if a photo cannot be cut out.",
      "visible_if": "{{ section.settings.knock_out_white }}"
    },
    {
      "type": "range",
      "id": "cloth_shading",
      "label": "Cloth shading",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 60,
      "info": "Adds light, folds and volume to flat photos. Needs cut-outs."
    },
    {
      "type": "select",
      "id": "room_style",
      "label": "Setting",
      "options": [
        {
          "value": "room",
          "label": "Wall and floor"
        },
        {
          "value": "plain",
          "label": "Plain background"
        }
      ],
      "default": "plain"
    },
    {
      "type": "color",
      "id": "wall_color",
      "label": "Wall color",
      "info": "Leave empty to follow the color scheme.",
      "visible_if": "{{ section.settings.room_style == 'room' }}"
    },
    {
      "type": "color",
      "id": "floor_color",
      "label": "Floor color",
      "info": "Leave empty to follow the color scheme.",
      "visible_if": "{{ section.settings.room_style == 'room' }}"
    },
    {
      "type": "checkbox",
      "id": "floor_line",
      "label": "Show the line where wall meets floor",
      "default": true,
      "visible_if": "{{ section.settings.room_style == 'room' }}"
    },
    {
      "type": "range",
      "id": "floor_shadow",
      "label": "Shadow on the floor",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 50,
      "visible_if": "{{ section.settings.room_style == 'room' }}"
    },
    {
      "type": "range",
      "id": "backdrop_glow",
      "label": "Backdrop glow",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 0,
      "info": "A soft pool of light behind the rail."
    },
    {
      "type": "header",
      "content": "Rail"
    },
    {
      "type": "checkbox",
      "id": "show_rail",
      "label": "Show the rail",
      "default": true
    },
    {
      "type": "select",
      "id": "rack_style",
      "label": "Rack",
      "options": [
        {
          "value": "freestanding",
          "label": "Freestanding rack"
        },
        {
          "value": "wall",
          "label": "Wall-mounted rail"
        }
      ],
      "default": "wall",
      "info": "Phones show just the rail, because it scrolls.",
      "visible_if": "{{ section.settings.show_rail }}"
    },
    {
      "type": "select",
      "id": "rail_finish",
      "label": "Finish",
      "options": [
        {
          "value": "steel",
          "label": "Brushed steel"
        },
        {
          "value": "brass",
          "label": "Brass"
        },
        {
          "value": "black",
          "label": "Matte black"
        },
        {
          "value": "custom",
          "label": "Custom color"
        }
      ],
      "default": "steel",
      "visible_if": "{{ section.settings.show_rail }}"
    },
    {
      "type": "color",
      "id": "rail_color",
      "label": "Rail color",
      "default": "#8a8a8a",
      "visible_if": "{{ section.settings.show_rail and section.settings.rail_finish == 'custom' }}"
    },
    {
      "type": "range",
      "id": "rail_thickness",
      "label": "Thickness",
      "min": 2,
      "max": 14,
      "step": 1,
      "unit": "px",
      "default": 6,
      "visible_if": "{{ section.settings.show_rail }}"
    },
    {
      "type": "range",
      "id": "rail_top",
