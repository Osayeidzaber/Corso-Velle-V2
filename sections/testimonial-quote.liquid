{%- comment -%}
  One large quote with attribution. Adapted from HyperUI marketing/testimonials #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="testimonial-quote kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-size="{{ section.settings.size }}" data-align="{{ section.settings.alignment }}" data-font="{{ section.settings.quote_font }}" data-card="{{ section.settings.card_style }}" data-mark="{{ section.settings.mark }}" style="{% render 'section-presentation', presentation: section.settings %}--quote-width:{{ section.settings.max_width }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <figure class="testimonial-quote__inner kit-card">
    {%- if section.settings.mark != 'none' -%}<svg class="testimonial-quote__mark" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="currentColor"><path d="M7.17 6.17A5.5 5.5 0 0 0 3 11.5V18a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H6.06a3.5 3.5 0 0 1 2.35-2.79 1 1 0 1 0-.62-1.9Zm10 0A5.5 5.5 0 0 0 13 11.5V18a1 1 0 0 0 1 1h6.5a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1h-4.44a3.5 3.5 0 0 1 2.35-2.79 1 1 0 1 0-.62-1.9Z"/></svg>{%- endif -%}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'rating' -%}
          {%- assign rating_label = 'sections.testimonials.rating' | t: rating: block.settings.rating -%}
          <p class="testimonial-quote__stars" role="img" aria-label="{{ rating_label | escape }}" {{ block.shopify_attributes }}>{%- for i in (1..5) -%}<span aria-hidden="true"{% if i > block.settings.rating %} class="is-empty"{% endif %}>★</span>{%- endfor -%}</p>
        {%- when 'quote' -%}<blockquote class="testimonial-quote__text" {{ block.shopify_attributes }}>{{ block.settings.quote }}</blockquote>
        {%- when 'author' -%}
          <figcaption class="testimonial-quote__author" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', class: 'testimonial-quote__avatar', alt: '' }}{%- endif -%}
            <span><strong>{{ block.settings.name | escape }}</strong>{%- if block.settings.role != blank -%}<span class="text-muted">{{ block.settings.role | escape }}</span>{%- endif -%}</span>
          </figcaption>
        {%- when 'logo' -%}
          {%- if block.settings.image != blank -%}<div class="testimonial-quote__logo" style="--logo-height:{{ block.settings.height }}px;" {{ block.shopify_attributes }}>{{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy' }}</div>{%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </figure>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.testimonial-quote__inner { width: min(var(--content-width), var(--quote-width, 860px)); margin: 0 auto; display: grid; gap: 24px; justify-items: start; }
.testimonial-quote[data-align='center'] .testimonial-quote__inner { justify-items: center; text-align: center; }
.testimonial-quote__mark { width: 36px; height: 36px; color: var(--nk-color-accent); }
.testimonial-quote[data-mark='large'] .testimonial-quote__mark { width: 72px; height: 72px; opacity: 0.35; }
.testimonial-quote__stars { margin: 0; letter-spacing: 0.15em; color: var(--nk-color-accent); }
.testimonial-quote__stars .is-empty { opacity: 0.25; }
.testimonial-quote__text { margin: 0; font-family: var(--nk-font-heading); font-size: clamp(1.4rem, 3vw, 2.25rem); line-height: 1.3; text-wrap: pretty; overflow-wrap: anywhere; }
.testimonial-quote[data-font='body'] .testimonial-quote__text { font-family: var(--nk-font-body); font-size: clamp(1.15rem, 2vw, 1.5rem); line-height: 1.5; }
.testimonial-quote[data-size='small'] .testimonial-quote__text { font-size: clamp(1.15rem, 2vw, 1.5rem); }
.testimonial-quote[data-size='large'] .testimonial-quote__text { font-size: clamp(1.75rem, 4.5vw, 3.25rem); }
.testimonial-quote__text p { margin: 0; }
.testimonial-quote__author { display: flex; align-items: center; gap: 12px; text-align: start; }
.testimonial-quote__author > span { display: grid; gap: 2px; font-size: 0.875rem; }
.testimonial-quote__avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
.testimonial-quote__logo img { height: var(--logo-height, 32px); width: auto; opacity: 0.8; }
{% endstylesheet %}

{% schema %}
{
