{%- comment -%}
  Announcement bar. Static by default; "Scrolling ticker" uses
  <nk-marquee>. Moving content has an explicit pause control and stops while focused.
{%- endcomment -%}
{%- liquid
  assign live = 0
  for block in section.blocks
    if block.settings.text != blank
      assign live = live | plus: 1
    endif
  endfor
-%}
{%- if live > 0 -%}
  <div class="announcement full-width color-{{ section.settings.color_scheme }}" data-display="{{ section.settings.mode }}" role="region" aria-label="{{ 'accessibility.announcements' | t }}">
    {%- if section.settings.mode == 'ticker' -%}
      <nk-marquee class="announcement__ticker" direction="{{ section.settings.direction }}" speed="{{ section.settings.speed }}" hover-speed="0" style="--nk-marquee-gap: 28px;">
        <div class="marquee__track" data-ref="track">
          <ul class="marquee__list" data-ref="list" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li class="marquee__item" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                  {%- else -%}
                    {{ block.settings.text | escape }}
                  {%- endif -%}
                  {%- comment -%} ✳ and * draw as an icon: phones render the ✳ character as a colour emoji. Other text gets the text-style selector. {%- endcomment -%}
                  {%- assign separator = section.settings.separator | strip | remove: '️' | remove: '︎' -%}
                  {%- if separator == '✳' or separator == '*' -%}
                    <span aria-hidden="true" style="margin-inline-start: 28px;">{% render 'icon', name: 'asterisk', size: 12, class: 'icon--inline' %}</span>
                  {%- elsif separator != blank -%}
                    <span aria-hidden="true" style="margin-inline-start: 28px;">{{ separator | escape }}&#xFE0E;</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
        <button type="button" class="marquee__pause media-toggle" data-ref="pause" aria-pressed="false" aria-label="{{ 'marquee.pause' | t }}" hidden>{% render 'icon', name: 'pause', size: 12 %}{% render 'icon', name: 'play', size: 12 %}</button>
      </nk-marquee>
    {%- else -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.text != blank -%}
          <p {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
            {%- else -%}
              {{ block.settings.text | escape }}
            {%- endif -%}
          </p>
          {%- if section.settings.mode == 'static' and request.design_mode == false -%}{%- break -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement[data-display='stacked'] { flex-direction: column; gap: 8px; padding-block: 12px; }
  .announcement .announcement__ticker { min-height: 44px; width: 100%; }
  .announcement .announcement__ticker .marquee__pause { width: 44px; height: 44px; opacity: 1; }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "class": "announcement-section",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Display",
      "options": [
        {
          "value": "static",
          "label": "Static (first message)"
        },
        {
          "value": "ticker",
          "label": "Scrolling ticker"
        },
        {
          "value": "stacked",
          "label": "All messages (stacked)"
        }
      ],
      "default": "static"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Ticker speed",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 40,
      "info": "Pixels per second."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Ticker direction",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Ticker separator",
      "default": "✳"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message"
        }
      ]
    },
    {
      "name": "Stacked announcements",
      "settings": {
        "mode": "stacked"
      },
      "blocks": [
        {
          "type": "message"
        },
        {
          "type": "message"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
