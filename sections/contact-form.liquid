{%- comment -%}
  Native Shopify contact form with optional extra fields. Adapted from Shopify Dawn sections/contact-form.liquid.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="contact-form kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-layout="{{ section.settings.layout }}" data-field="{{ section.settings.field_style }}" data-card="{{ section.settings.card_style }}" data-submit-width="{{ section.settings.button_width }}" style="{% render 'section-presentation', presentation: section.settings %}">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="contact-form__inner">
    <div class="contact-form__intro">
      {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: 'left' %}
      {%- if section.settings.details != blank -%}<div class="rte contact-form__details">{{ section.settings.details }}</div>{%- endif -%}
    </div>
    {%- assign form_id = 'ContactForm-' | append: section.id -%}
    {%- form 'contact', id: form_id, class: 'contact-form__form kit-card' -%}
      {%- if form.posted_successfully? -%}
        <p class="contact-form__status" role="status" tabindex="-1">{{ 'sections.contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="contact-form__status" role="alert" tabindex="-1">{{ 'sections.contact.error' | t }} {{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="contact-form__fields">
        <label class="contact-form__field"><span>{{ 'sections.contact.name' | t }}</span><input type="text" name="contact[{{ 'sections.contact.name' | t | escape }}]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"></label>
        <label class="contact-form__field"><span>{{ 'sections.contact.email' | t }} <span aria-hidden="true">*</span></span><input type="email" name="contact[email]" autocomplete="email" spellcheck="false" autocapitalize="off" required value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}></label>
        {%- if section.settings.show_phone -%}
          <label class="contact-form__field contact-form__field--full"><span>{{ 'sections.contact.phone' | t }}</span><input type="tel" name="contact[{{ 'sections.contact.phone' | t | escape }}]" autocomplete="tel" pattern="[0-9\-\+\s\(\)]*" value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"></label>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- assign field_name = block.settings.label | escape -%}
          <label class="contact-form__field{% if block.settings.width == 'full' %} contact-form__field--full{% endif %}" {{ block.shopify_attributes }}>
            <span>{{ block.settings.label | escape }}{% if block.settings.required %} <span aria-hidden="true">*</span>{% endif %}</span>
            {%- case block.settings.type -%}
              {%- when 'textarea' -%}
                <textarea name="contact[{{ field_name }}]" rows="3" placeholder="{{ block.settings.placeholder | escape }}" {% if block.settings.required %}required{% endif %}></textarea>
              {%- when 'select' -%}
                {%- assign choices = block.settings.choices | split: ',' -%}
                <select name="contact[{{ field_name }}]" {% if block.settings.required %}required{% endif %}>
                  <option value="">{{ block.settings.placeholder | default: '—' | escape }}</option>
                  {%- for choice in choices -%}{%- assign option = choice | strip -%}{%- if option != blank -%}<option value="{{ option | escape }}">{{ option | escape }}</option>{%- endif -%}{%- endfor -%}
                </select>
              {%- else -%}
                <input type="{{ block.settings.type }}" name="contact[{{ field_name }}]" placeholder="{{ block.settings.placeholder | escape }}" {% if block.settings.required %}required{% endif %}>
            {%- endcase -%}
          </label>
        {%- endfor -%}
        <label class="contact-form__field contact-form__field--full"><span>{{ 'sections.contact.message' | t }}</span><textarea rows="{{ section.settings.message_rows }}" name="contact[body]">{{ form.body | escape }}</textarea></label>
      </div>
      {%- if section.settings.consent != blank -%}<div class="rte text-muted contact-form__consent">{{ section.settings.consent }}</div>{%- endif -%}
      <div class="contact-form__submit"><button type="submit" class="nk-btn nk-btn--{{ section.settings.button_style }}"><span class="nk-btn__label">{%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'sections.contact.send' | t }}{%- endif -%}</span></button></div>
    {%- endform -%}
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.contact-form__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
.contact-form__intro { display: grid; gap: 20px; align-content: start; }
.contact-form__details { font-size: 0.9375rem; }
.contact-form__form { display: grid; gap: 20px; width: min(100%, 44rem); }
.contact-form[data-layout='split'] .contact-form__form { width: 100%; }
.contact-form__fields { display: grid; gap: 16px; }
.contact-form__field { display: grid; gap: 6px; font-size: 0.875rem; font-weight: 500; min-width: 0; }
.contact-form__field input, .contact-form__field textarea, .contact-form__field select { width: 100%; min-height: 48px; padding: 12px 14px; border: 1px solid var(--nk-color-line); border-radius: var(--kit-radius); background: var(--nk-color-bg); color: var(--nk-color-text); font-weight: 400; }
.contact-form[data-field='filled'] .contact-form__field :is(input, textarea, select) { background: var(--nk-color-surface); border-color: transparent; }
.contact-form[data-card='surface'][data-field='filled'] .contact-form__field :is(input, textarea, select) { background: var(--nk-color-bg); }
.contact-form[data-field='underline'] .contact-form__field :is(input, textarea, select) { padding-inline: 0; border-width: 0 0 1px; border-radius: 0; background: transparent; }
.contact-form__field textarea { resize: vertical; }
.contact-form__field :is(input, textarea, select):focus-visible { outline: 2px solid var(--nk-focus); outline-offset: 1px; }
.contact-form__status { margin: 0; padding: 12px 14px; background: var(--nk-color-surface); border-radius: var(--kit-radius); }
.contact-form__consent { font-size: 0.8125rem; }
.contact-form[data-submit-width='full'] .contact-form__submit .nk-btn { width: 100%; }
@media (min-width: 750px) { .contact-form__fields { grid-template-columns: repeat(2, minmax(0, 1fr)); } .contact-form__field--full { grid-column: 1 / -1; } }
@media (min-width: 990px) { .contact-form[data-layout='split'] .contact-form__inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 64px; align-items: start; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Questions about sizing, an order or alterations? We reply within one business day.</p>"
    },
    {
      "type": "richtext",
      "id": "details",
      "label": "Contact details",
      "info": "For example opening hours, email address or studio address."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "split",
          "label": "Intro beside form"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Form panel",
      "options": [
        {
          "value": "plain",
          "label": "Plain"
        },
        {
          "value": "surface",
          "label": "Surface fill"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "shadow",
          "label": "Soft shadow"
        }
      ],
      "default": "plain"
    },
    {
      "type": "header",
      "content": "Fields"
    },
    {
      "type": "select",
      "id": "field_style",
      "label": "Field style",
      "options": [
        {
          "value": "outline",
          "label": "Outlined"
        },
        {
          "value": "filled",
          "label": "Filled"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "outline"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone field",
      "default": true
    },
    {
      "type": "range",
      "id": "message_rows",
      "label": "Message box height (rows)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "richtext",
      "id": "consent",
      "label": "Text above the button",
      "info": "For example a note about how you use the information."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "info": "Defaults to \"Send\"."
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "pill",
          "label": "Pill"
        },
        {
          "value": "sweep",
          "label": "Center sweep"
        },
        {
          "value": "offset",
          "label": "Offset shadow"
        },
        {
          "value": "press",
          "label": "3D press"
        }
      ],
      "default": "solid"
    },
    {
      "type": "select",
      "id": "button_width",
      "label": "Button width",
      "options": [
        {
          "value": "auto",
          "label": "Fit label"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "theme",
      "info": "Applies to images, cards and buttons in this section."
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Theme default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in section"
