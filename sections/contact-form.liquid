      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "field",
      "name": "Extra field",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Order number"
        },
        {
          "type": "select",
          "id": "type",
          "label": "Field type",
          "options": [
            {
              "value": "text",
              "label": "Short text"
            },
            {
              "value": "textarea",
              "label": "Long text"
            },
            {
              "value": "select",
              "label": "Dropdown"
            },
            {
              "value": "date",
              "label": "Date"
            },
            {
              "value": "number",
              "label": "Number"
            },
            {
              "value": "tel",
              "label": "Phone"
            },
            {
              "value": "url",
              "label": "Website"
            }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "choices",
          "label": "Dropdown choices",
          "default": "Order, Returns, Sizing",
          "info": "Comma-separated. Used for Dropdown."
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder"
        },
        {
          "type": "select",
          "id": "width",
          "label": "Width",
          "options": [
            {
              "value": "half",
              "label": "Half"
            },
            {
              "value": "full",
              "label": "Full"
            }
          ],
          "default": "full"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Contact form"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
