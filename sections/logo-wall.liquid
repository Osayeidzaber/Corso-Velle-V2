{%- comment -%}
  Press / partner logos as a ruled grid or a single row, optionally grayscale until hover. Adapted from HyperUI marketing/logo-clouds #1.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="logo-wall kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-style="{{ section.settings.appearance }}" data-gray="{{ section.settings.grayscale }}" data-layout="{{ section.settings.layout }}" data-align="{{ section.settings.alignment }}" style="{% render 'section-presentation', presentation: section.settings %}--logo-cols:{{ section.settings.columns }};--logo-cols-mobile:{{ section.settings.columns_mobile }};--logo-height:{{ section.settings.logo_height }}px;--logo-opacity:{{ section.settings.opacity | divided_by: 100.0 }};--logo-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="logo-wall__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="logo-wall__list" role="list">
      {%- for block in section.blocks -%}
        <li class="logo-wall__item"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="logo-wall__link"{% if block.settings.new_tab %} target="_blank" rel="noopener"{% endif %}>{%- endif -%}
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 480 | image_tag: loading: 'lazy', class: 'logo-wall__logo', alt: block.settings.name }}
          {%- else -%}
            <span class="logo-wall__name">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.logo-wall__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 28px; }
.logo-wall__list { display: grid; grid-template-columns: repeat(var(--logo-cols-mobile, 2), minmax(0, 1fr)); gap: var(--logo-gap, 1px); list-style: none; margin: 0; padding: 0; }
.logo-wall[data-style='ruled'] .logo-wall__list { gap: 1px; background: var(--nk-color-line); border: 1px solid var(--nk-color-line); border-radius: var(--kit-radius); overflow: hidden; }
.logo-wall__item { display: grid; place-items: center; min-height: calc(var(--logo-height, 40px) + 48px); padding: 16px; background: var(--nk-color-bg); min-width: 0; }
.logo-wall[data-style='cards'] .logo-wall__item { background: var(--nk-color-surface); border-radius: var(--kit-radius); }
.logo-wall[data-style='plain'] .logo-wall__item { background: transparent; }
.logo-wall__link { display: grid; place-items: center; width: 100%; height: 100%; }
.logo-wall__logo { max-height: var(--logo-height, 40px); width: auto; max-width: 100%; object-fit: contain; }
.logo-wall__name { font-family: var(--nk-font-heading); font-size: calc(var(--logo-height, 40px) * 0.5); text-align: center; overflow-wrap: anywhere; }
.logo-wall__item { opacity: var(--logo-opacity, 1); }
.logo-wall[data-gray='true'] .logo-wall__item { filter: grayscale(1); }
.logo-wall__item:hover, .logo-wall__item:focus-within { filter: none; opacity: 1; }
.nk-anim .logo-wall__item { transition: filter 0.3s var(--nk-ease-out), opacity 0.3s var(--nk-ease-out); }
.logo-wall[data-layout='row'] .logo-wall__list { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px var(--logo-gap, 40px); background: none; border: 0; }
.logo-wall[data-layout='row'] .logo-wall__item { padding: 8px; min-height: 0; background: transparent; }
.logo-wall[data-align='center'] .kit-intro { justify-self: center; text-align: center; }
@media (min-width: 750px) { .logo-wall__list { grid-template-columns: repeat(var(--logo-cols, 4), minmax(0, 1fr)); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo wall",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As featured in"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "row",
          "label": "Centered row"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "appearance",
      "label": "Grid style",
      "options": [
        {
          "value": "ruled",
          "label": "Ruled lines"
        },
        {
          "value": "cards",
          "label": "Cards"
        },
        {
          "value": "plain",
          "label": "Plain"
        }
      ],
      "default": "ruled"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (phones)",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap (cards, plain and row)",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Logo opacity",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 80,
      "info": "Logos return to full opacity on hover."
    },
    {
      "type": "checkbox",
      "id": "grayscale",
      "label": "Grayscale until hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "xlarge",
          "label": "Extra large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "corner_style",
      "label": "Corners",
      "options": [
        {
          "value": "theme",
          "label": "Theme default"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "theme",
      "info": "Applies to images, cards and buttons in this section."
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size",
      "options": [
        {
          "value": "compact",
          "label": "Compact"
        },
        {
          "value": "regular",
          "label": "Theme default"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "regular"
    },
    {
      "type": "select",
      "id": "entrance",
      "label": "Entrance animation",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "fade",
          "label": "Fade in section"
        },
        {
          "value": "stagger",
          "label": "Items rise one by one"
        }
      ],
      "default": "none",
      "info": "Skipped when visitors prefer reduced motion or motion is off in Theme settings."
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme page width"
        },
        {
          "value": "narrow",
          "label": "Narrow (1200px)"
        },
        {
          "value": "wide",
          "label": "Wide (1440px)"
        },
        {
          "value": "full",
          "label": "Full width with page gutters"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "spacing_mode",
      "label": "Padding",
      "options": [
        {
          "value": "inherit",
          "label": "Use theme section spacing"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "inherit"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens from 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 72,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "padding_top_small",
      "label": "Padding top (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}",
      "info": "Screens below 990px."
    },
    {
      "type": "range",
      "id": "padding_bottom_small",
      "label": "Padding bottom (smaller screens)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.spacing_mode == 'custom' }}"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Partner",
          "info": "Used as alt text, or shown when no logo is uploaded."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "new_tab",
          "label": "Open link in a new tab",
          "default": true
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Logo wall",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "name": "Vogue"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Kinfolk"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Monocle"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Cereal"
          }
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
