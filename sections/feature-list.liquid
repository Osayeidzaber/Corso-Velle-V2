{%- comment -%}
  Icon + title + text features (shipping, returns, fit). Adapted from HyperUI marketing/feature-grids #1 with Heroicons.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="feature-list kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-layout="{{ section.settings.layout }}" data-icon="{{ section.settings.icon_style }}" data-icon-color="{{ section.settings.icon_color }}" data-align="{{ section.settings.alignment }}" data-card="{{ section.settings.card_style }}" data-divider="{{ section.settings.dividers }}" data-title="{{ section.settings.title_size }}" style="{% render 'section-presentation', presentation: section.settings %}--feature-cols:{{ section.settings.columns }};--feature-cols-mobile:{{ section.settings.columns_mobile }};--feature-icon:{{ section.settings.icon_size }}px;--feature-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="feature-list__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ul class="feature-list__items" role="list">
      {%- for block in section.blocks -%}
        <li class="feature-list__item kit-card"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <span class="feature-list__icon">{{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="feature-list__icon">{% render 'section-icon', name: block.settings.icon %}</span>
          {%- endif -%}
          <div class="feature-list__copy">
            <h3 class="feature-list__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link != blank and block.settings.link_label != blank -%}<a class="kit-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.feature-list__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 32px; }
.feature-list__items { display: grid; grid-template-columns: repeat(var(--feature-cols-mobile, 1), minmax(0, 1fr)); gap: var(--feature-gap, 28px); list-style: none; margin: 0; padding: 0; }
.feature-list__item { display: grid; gap: 14px; align-content: start; min-width: 0; overflow-wrap: anywhere; }
.feature-list[data-layout='inline'] .feature-list__item { grid-template-columns: auto minmax(0, 1fr); align-items: start; }
.feature-list__icon { display: inline-grid; place-items: center; width: calc(var(--feature-icon, 28px) + 20px); height: calc(var(--feature-icon, 28px) + 20px); color: var(--nk-color-accent); }
.feature-list[data-icon-color='text'] .feature-list__icon { color: var(--nk-color-text); }
.feature-list[data-icon='plain'] .feature-list__icon { width: auto; height: auto; justify-self: start; }
.feature-list[data-align='center'][data-icon='plain'] .feature-list__icon { justify-self: center; }
.feature-list__icon svg, .feature-list__icon img { width: var(--feature-icon, 28px); height: var(--feature-icon, 28px); object-fit: contain; }
.feature-list[data-icon='circle'] .feature-list__icon { border-radius: 50%; background: var(--nk-color-surface); }
.feature-list[data-icon='square'] .feature-list__icon { border-radius: var(--kit-radius); background: var(--nk-color-surface); }
.feature-list[data-icon='outline'] .feature-list__icon { border-radius: 50%; border: 1px solid currentColor; }
.feature-list[data-card='surface'] .feature-list__icon { background: var(--nk-color-bg); }
.feature-list__copy { display: grid; gap: 6px; }
.feature-list__title { font-size: 1.0625rem; }
.feature-list[data-title='large'] .feature-list__title { font-size: 1.375rem; }
.feature-list[data-divider='true'] .feature-list__item { border-top: 1px solid var(--nk-color-line); padding-top: 20px; }
.feature-list[data-align='center'] .feature-list__item { justify-items: center; text-align: center; }
@media (min-width: 750px) { .feature-list__items { grid-template-columns: repeat(min(2, var(--feature-cols, 3)), minmax(0, 1fr)); } }
@media (min-width: 990px) { .feature-list__items { grid-template-columns: repeat(var(--feature-cols, 3), minmax(0, 1fr)); } }
{% endstylesheet %}

