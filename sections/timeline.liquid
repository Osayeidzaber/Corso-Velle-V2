{%- comment -%}
  Brand story / milestones as a vertical or alternating timeline. Adapted from HyperUI application/timelines #1 and daisyUI timeline.
  Source and license: docs/SECTION-SOURCES.md.
{%- endcomment -%}
<section class="timeline-section kit-section full-width section-spacing section-presentation color-{{ section.settings.color_scheme }}" data-heading="{{ section.settings.heading_size }}" data-corners="{{ section.settings.corner_style }}" data-buttons="{{ section.settings.button_size }}" data-layout="{{ section.settings.layout }}" data-marker="{{ section.settings.marker }}" data-line="{{ section.settings.line_style }}" data-date="{{ section.settings.date_style }}" data-card="{{ section.settings.card_style }}" style="{% render 'section-presentation', presentation: section.settings %}--timeline-gap:{{ section.settings.gap }}px;">
  {%- case section.settings.entrance -%}{%- when 'fade' -%}<nk-reveal class="kit-entrance" mode="fade">{%- when 'stagger' -%}<nk-stagger class="kit-entrance">{%- endcase -%}
  <div class="timeline-section__inner">
    {% render 'section-heading', heading: section.settings.heading, text: section.settings.text, align: section.settings.alignment %}
    <ol class="timeline-section__list">
      {%- for block in section.blocks -%}
        <li class="timeline-section__event"{% if section.settings.entrance == 'stagger' %} data-stagger-item{% endif %} {{ block.shopify_attributes }}>
          <span class="timeline-section__marker" aria-hidden="true">{%- if section.settings.marker == 'number' -%}{{ forloop.index }}{%- endif -%}</span>
          <div class="timeline-section__card kit-card">
            {%- if block.settings.date != blank -%}<p class="timeline-section__date">{{ block.settings.date | escape }}</p>{%- endif -%}
            <h3 class="timeline-section__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="rte text-muted">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.image != blank -%}<div class="kit-media timeline-section__media" data-ratio="{{ section.settings.image_ratio }}">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 40vw, 90vw' }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
  {%- case section.settings.entrance -%}{%- when 'fade' -%}</nk-reveal>{%- when 'stagger' -%}</nk-stagger>{%- endcase -%}
</section>

{% stylesheet %}
.timeline-section__inner { width: var(--content-width); margin-inline: auto; display: grid; gap: 36px; }
.timeline-section__list { position: relative; display: grid; gap: var(--timeline-gap, 40px); list-style: none; margin: 0; padding: 0 0 0 36px; }
.timeline-section__list::before { content: ''; position: absolute; inset-block: 6px; inset-inline-start: 11px; border-inline-start: 2px solid var(--nk-color-line); }
.timeline-section[data-line='dashed'] .timeline-section__list::before { border-inline-start-style: dashed; }
.timeline-section[data-line='none'] .timeline-section__list::before { content: none; }
.timeline-section__event { position: relative; min-width: 0; overflow-wrap: anywhere; }
.timeline-section__marker { position: absolute; inset-inline-start: -32px; top: 4px; display: grid; place-items: center; width: 16px; height: 16px; border-radius: 50%; background: var(--nk-color-accent); box-shadow: 0 0 0 4px var(--nk-color-bg); font-family: var(--nk-font-spec); font-size: 0.6875rem; font-weight: 700; color: var(--nk-color-bg); }
.timeline-section[data-marker='ring'] .timeline-section__marker { background: var(--nk-color-bg); border: 2px solid var(--nk-color-accent); }
.timeline-section[data-marker='number'] .timeline-section__marker { inset-inline-start: -38px; top: 0; width: 28px; height: 28px; background: var(--nk-color-text); }
.timeline-section__card { display: grid; gap: 8px; max-width: 40rem; }
.timeline-section__date { margin: 0; font-family: var(--nk-font-spec); font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--nk-color-text-muted); }
.timeline-section[data-date='large'] .timeline-section__date { font-family: var(--nk-font-heading); font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: 0; text-transform: none; color: var(--nk-color-accent); }
.timeline-section[data-date='badge'] .timeline-section__date { justify-self: start; padding: 3px 10px; background: var(--nk-color-text); color: var(--nk-color-bg); border-radius: var(--nk-button-radius, 0); }
.timeline-section__title { font-size: 1.25rem; }
.timeline-section__media { margin-top: 8px; }
@media (min-width: 990px) {
  .timeline-section[data-layout='alternate'] .timeline-section__list { padding: 0; }
  .timeline-section[data-layout='alternate'] .timeline-section__list::before { inset-inline-start: calc(50% - 1px); }
  .timeline-section[data-layout='alternate'] .timeline-section__event { width: calc(50% - 40px); }
  .timeline-section[data-layout='alternate'] .timeline-section__event:nth-child(even) { margin-inline-start: auto; }
  .timeline-section[data-layout='alternate'] .timeline-section__event:nth-child(odd) { text-align: end; }
  .timeline-section[data-layout='alternate'] .timeline-section__event:nth-child(odd) .timeline-section__card { margin-inline-start: auto; justify-items: end; }
  .timeline-section[data-layout='alternate'] .timeline-section__event:nth-child(odd) .timeline-section__marker { inset-inline-start: auto; inset-inline-end: -48px; }
  .timeline-section[data-layout='alternate'] .timeline-section__event:nth-child(even) .timeline-section__marker { inset-inline-start: -48px; }
  .timeline-section[data-layout='alternate'][data-marker='number'] .timeline-section__event:nth-child(odd) .timeline-section__marker { inset-inline-end: -54px; }
  .timeline-section[data-layout='alternate'][data-marker='number'] .timeline-section__event:nth-child(even) .timeline-section__marker { inset-inline-start: -54px; }
  .timeline-section[data-layout='horizontal'] .timeline-section__list { grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); padding: 36px 0 0; }
  .timeline-section[data-layout='horizontal'] .timeline-section__list::before { inset-block: 11px auto; inset-inline: 0; border-inline-start: 0; border-top: 2px solid var(--nk-color-line); }
  .timeline-section[data-layout='horizontal'][data-line='dashed'] .timeline-section__list::before { border-top-style: dashed; }
  .timeline-section[data-layout='horizontal'] .timeline-section__marker { inset-inline-start: 0; top: -32px; }
  .timeline-section[data-layout='horizontal'][data-marker='number'] .timeline-section__marker { top: -38px; }
}
{% endstylesheet %}

